<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    
    <ui:Style src="styles.uss" />

    <ui:VisualElement class="screen-container" style="justify-content: flex-start; align-items: center; padding: 24px; padding-top: 16px; padding-bottom: 40px; background-color: #07090E;">
        
        <!-- Official Game Brand Logo -->
        <ui:VisualElement name="GameLogoContainer" style="align-items: center; justify-content: center; margin-top: 8px; margin-bottom: 4px;">
            <ui:VisualElement name="GameLogoImage" style="width: 104px; height: 104px; border-radius: 24px; background-image: url('project://database/Assets/Art/Icons/AppIcon_512x512.png'); -unity-background-scale-mode: scale-to-fit; border-width: 1.5px; border-color: rgba(56, 189, 248, 0.35);" />
        </ui:VisualElement>

        <!-- Header Section -->
        <ui:Label text="CITIZEN REGISTRY OFFICE" class="header-text" style="color: #F1C40F; font-size: 42px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 2px; -unity-text-align: middle-center;" />
        <ui:Label text="Official Citizen Database Integration v2.84" class="sub-text" style="color: #94A3B8; font-size: 22px; margin-bottom: 20px; -unity-text-align: middle-center;" />
        
        <!-- Step 1: Name Input -->
        <ui:VisualElement name="Step1Container" style="width: 100%; align-items: center; flex-grow: 1; justify-content: space-between; transition-property: opacity, scale; transition-duration: 0.22s;">
            <ui:VisualElement style="width: 100%; align-items: center;">
                <ui:Label text="CITIZEN INITIALIZATION" style="color: #38BDF8; font-size: 26px; -unity-font-style: bold; margin-bottom: 12px; -unity-text-align: middle-center;" />
                
                <ui:VisualElement class="card" style="border-color: #242E46; border-width: 2px; border-radius: 24px; padding: 28px 22px; background-color: #0E121B; width: 100%;">
                    <ui:Label text="REGISTER CITIZEN LEGAL NAME:" style="color: #FFFFFF; font-size: 24px; -unity-font-style: bold; margin-bottom: 12px;" />
                    <ui:TextField name="NameInput" text="" style="height: 64px; font-size: 28px; border-radius: 14px; margin-bottom: 6px; color: #000000;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:Button name="BtnRandomizeBackstory" text="CALIBRATE CITIZEN" class="action-button" style="background-color: #F1C40F; color: #0A1128; font-size: 32px; -unity-font-style: bold; height: 64px; border-radius: 18px; width: 100%; margin-top: 16px;" />
        </ui:VisualElement>

        <!-- Step 2: Backstory Reveal (Hidden by default) -->
        <ui:VisualElement name="Step2Container" style="width: 100%; display: none; align-items: center; flex-grow: 1; opacity: 0; scale: 0.88 0.88; justify-content: space-between; transition-property: opacity, scale; transition-duration: 0.28s; transition-timing-function: ease-out-back;">
            
            <ui:VisualElement style="width: 100%; align-items: center; flex-grow: 1; justify-content: flex-start;">
                <ui:Label text="YOUR ASSIGNED BIOGRAPHY" style="color: #38BDF8; font-size: 26px; -unity-font-style: bold; margin-bottom: 10px; -unity-text-align: middle-center;" />
                
                <!-- Main Content Card -->
                <ui:VisualElement name="DossierCard" class="card" style="border-color: #242E46; border-width: 2px; border-radius: 24px; padding: 22px 20px; background-color: #0E121B; width: 100%; transition-property: scale; transition-duration: 0.22s;">
                    
                    <ui:Label text="Greeting, citizen!" name="GreetingText" style="color: #FFFFFF; font-size: 34px; -unity-font-style: bold; margin-bottom: 6px;" />
                    <ui:Label name="BackstoryTitleText" text="Assigned Biography: [Title]" style="color: #F1C40F; font-size: 28px; -unity-font-style: bold; margin-bottom: 6px; white-space: normal;" />
                    <ui:Label name="BackstoryDescText" text="[Description]" style="color: #CBD5E1; font-size: 22px; white-space: normal; line-height: 28px; margin-bottom: 10px;" />
                    
                    <!-- Separator -->
                    <ui:VisualElement style="height: 1.5px; background-color: #242E46; margin-top: 6px; margin-bottom: 10px; width: 100%;" />
                    
                    <ui:Label text="INITIAL REGISTRATION ASSETS:" style="color: #38BDF8; font-size: 22px; -unity-font-style: bold; margin-bottom: 10px;" />
                    
                    <!-- Compact 2-column stats layout -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 6px;">
                        <ui:VisualElement style="width: 48%; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Starting Cash:" style="color: #94A3B8; font-size: 21px;" />
                            <ui:Label name="StartCashText" text="$0" style="color: #2ECC71; font-size: 21px; -unity-font-style: bold;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 48%; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Start Stress:" style="color: #94A3B8; font-size: 21px;" />
                            <ui:Label name="StartStressText" text="0%" style="color: #E74C3C; font-size: 21px; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 6px;">
                        <ui:VisualElement style="width: 48%; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Service Luck:" style="color: #94A3B8; font-size: 21px;" />
                            <ui:Label name="LuckServiceText" text="30%" style="color: #FFFFFF; font-size: 21px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 48%; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Hospitality:" style="color: #94A3B8; font-size: 21px;" />
                            <ui:Label name="LuckHospitalityText" text="95%" style="color: #FFFFFF; font-size: 21px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%;">
                        <ui:VisualElement style="width: 48%; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Tech Luck:" style="color: #94A3B8; font-size: 21px;" />
                            <ui:Label name="LuckTechText" text="10%" style="color: #FFFFFF; font-size: 21px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 48%; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Corp Luck:" style="color: #94A3B8; font-size: 21px;" />
                            <ui:Label name="LuckCorpText" text="30%" style="color: #FFFFFF; font-size: 21px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:Button name="BeginButton" text="BEGIN LIFE" class="action-button" style="background-color: #2ECC71; color: #052E16; font-size: 32px; -unity-font-style: bold; height: 64px; border-radius: 18px; width: 100%; margin-top: 16px;" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
