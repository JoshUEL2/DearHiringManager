<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    
    <ui:Style src="styles.uss" />

    <ui:VisualElement class="screen-container" style="padding-bottom: 360px;">
        
        <!-- TOP CARD ROOT -->
        <ui:VisualElement name="TopCardRoot" class="card top-card-root" style="margin-bottom: 20px; border-radius: 0 0 24px 24px; border-width: 0 0 3px 0; border-color: rgba(56, 189, 248, 0.4); padding: 0; flex-direction: column; background-color: rgba(10, 17, 40, 0.95); overflow: hidden;">
            
            <!-- Animated watermark layer -->
            <ui:VisualElement name="WatermarkContainer" style="position: absolute; left: -200px; top: -200px; right: -200px; bottom: -200px; overflow: hidden;" />

            <!-- ROW 1: Notch-safe icons -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding: 18px 30px 0 30px;">
                <ui:Button name="BtnOpenSettings" text="≡" style="font-size: 52px; color: #CBD5E1; background-color: rgba(255,255,255,0.08); border-width: 1px; border-color: rgba(255,255,255,0.15); border-radius: 14px; padding: 4px 16px; margin: 0; -unity-font-style: bold;" />
                <ui:VisualElement style="width: 120px;" />
                <ui:Button name="BtnOpenMigration" text="⌂" style="font-size: 48px; color: #CBD5E1; background-color: rgba(255,255,255,0.08); border-width: 1px; border-color: rgba(255,255,255,0.15); border-radius: 14px; padding: 4px 16px; margin: 0;" />
            </ui:VisualElement>

            <!-- ROW 2: Name (left) + Job (right), full width -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: flex-end; padding: 14px 30px 0 30px;">
                <ui:Button name="BtnViewCV" class="id-card-name-btn" text="PlayerName" style="font-size: 52px; color: #F8FAFC; -unity-font-style: bold; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-color: rgba(56, 189, 248, 0.4); padding: 0 0 4px 0; margin: 0; -unity-text-align: middle-left;" />
                <ui:Label name="JobText" text="Unemployed" style="font-size: 32px; color: #38BDF8; -unity-font-style: bold; margin: 0; padding: 0 0 6px 0;" />
            </ui:VisualElement>

            <!-- ROW 3: Finances spread full width -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding: 12px 30px 20px 30px;">
                <ui:Label name="IncomeText" text="+$0.00" style="font-size: 28px; color: #4ADE80; -unity-font-style: bold; margin: 0; padding: 0;" />
                <ui:Label name="CashText" text="$0.00" style="font-size: 56px; color: #F8FAFC; -unity-font-style: bold; margin: 0; padding: 0;" />
                <ui:Label name="ExpenseText" text="-$0.00" style="font-size: 28px; color: #F87171; -unity-font-style: bold; margin: 0; padding: 0;" />
            </ui:VisualElement>

            <!-- District accent bar -->
            <ui:VisualElement name="DistrictAccentBar" style="height: 4px; background-color: #38BDF8; border-radius: 0 0 24px 24px;" />
        </ui:VisualElement>

        <ui:Label name="DashboardTitle" text="DASHBOARD" class="header-text" style="color: #38BDF8; margin: 0; margin-bottom: 20px;" />

        <!-- TERMINAL LOG -->
        <ui:VisualElement name="TerminalCard" class="card terminal-card" style="flex-grow: 1; margin-bottom: 0; background-color: #0A1128; border-color: #475569; border-width: 2px; border-radius: 20px; padding: 30px;">
            <ui:ScrollView name="TerminalScrollView" style="flex-grow: 1;">
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Label name="LogText" text="" enable-rich-text="true" style="color: #FFFFFF; font-size: 24px; white-space: normal;" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- NEW BOTTOM NAV & FOOTER -->
    <ui:VisualElement class="bottom-nav-container">
        <!-- Nav Buttons -->
        <ui:VisualElement class="nav-bar-row">
            <ui:Button name="BtnCareers" text="Careers" class="nav-button" />
            <ui:Button name="BtnHustles" text="Hustles" class="nav-button" />
            <ui:Button name="BtnAdvanceWeek" text="+ Week" class="advance-week-btn" />
            <ui:Button name="BtnEducation" text="Education" class="nav-button" />
            <ui:Button name="BtnActivities" text="Activities" class="nav-button" />
        </ui:VisualElement>

        <!-- Progress Bars -->
        <ui:VisualElement class="footer-stats-row">
            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Performance" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="PerfVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="PerfFill" class="progress-fill" style="width: 0%; background-color: #F1C40F;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Job Luck" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="LuckVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="LuckFill" class="progress-fill" style="width: 0%; background-color: #2ECC71;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Stress" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="StressVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="StressFill" class="progress-fill" style="width: 0%; background-color: #E74C3C;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- SETTINGS OVERLAY -->
    <ui:VisualElement name="SettingsOverlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(15, 23, 42, 0.98); justify-content: center; align-items: center; display: none; opacity: 0; transition-property: opacity; transition-duration: 0.3s;">
        <ui:VisualElement class="card" style="width: 90%; background-color: #0F172A; border-color: #38BDF8; border-width: 2px; border-radius: 20px; padding: 25px;">
            
            <ui:Label text="Simulation Settings" style="color: #38BDF8; font-size: 24px; -unity-font-style: bold; margin-bottom: 10px;" />
            <ui:Label text="Review past timelines, manage current state, or reset your simulation memory." style="color: #94A3B8; font-size: 24px; white-space: normal; margin-bottom: 20px;" />
            
            <ui:Label text="Past Survived Timelines:" style="color: #FFFFFF; font-size: 32px; -unity-font-style: bold; margin-bottom: 10px;" />
            
            <!-- History Cards Container -->
            <ui:ScrollView name="HistoryContainer" vertical-scroller-visibility="AlwaysVisible" style="height: 420px; margin-bottom: 20px; background-color: #1E293B; border-color: #475569; border-width: 2px; border-radius: 20px; padding: 20px;" />

            <ui:Button name="BtnExpandHistory" text="EXPAND PAST TIMELINES" class="action-button" style="margin-bottom: 15px; padding: 15px; font-size: 24px; border-radius: 12px; background-color: #38BDF8; color: #FFFFFF; -unity-font-style: bold;" />

            <ui:Button name="BtnToggleTheme" text="Toggle Dark Mode" class="action-button" style="margin-bottom: 15px; padding: 15px; font-size: 24px; border-radius: 12px; background-color: #FFFFFF; color: #000000; -unity-font-style: bold;" />
            <ui:Button name="BtnToggleDevConsole" text="Dev Tools: OFF" class="action-button" style="margin-bottom: 25px; padding: 15px; font-size: 24px; border-radius: 12px; background-color: #E74C3C; color: #FFFFFF; -unity-font-style: bold;" />

            <ui:Button name="BtnWipeHistory" text="MAKE NEW LIFE" class="danger-button" style="background-color: #E74C3C; width: 100%; padding: 15px; font-size: 24px; border-radius: 12px; margin-bottom: 20px;" />
            
            <ui:Button name="BtnCloseSettings" text="Back to Life" style="background-color: transparent; border-color: #38BDF8; border-width: 2px; color: #38BDF8; -unity-font-style: bold; font-size: 32px; border-radius: 25px; padding: 12px; width: 70%; align-self: center;" />
            
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="ExpandedHistoryOverlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(15, 23, 42, 0.98); justify-content: center; align-items: center; display: none; opacity: 1; padding: 40px;">
        <ui:VisualElement class="card" style="width: 100%; height: 95%; background-color: #0F172A; border-color: #38BDF8; border-width: 2px; border-radius: 20px; padding: 25px;">
            <ui:Label text="ALL PAST TIMELINES" style="color: #38BDF8; font-size: 32px; -unity-font-style: bold; margin-bottom: 20px;" />
            <ui:ScrollView name="ExpandedHistoryContainer" vertical-scroller-visibility="AlwaysVisible" style="flex-grow: 1; margin-bottom: 20px; background-color: #1E293B; border-color: #475569; border-width: 2px; border-radius: 20px; padding: 20px;" />
            <ui:Button name="BtnCloseExpandedHistory" text="CLOSE" class="danger-button" style="background-color: #E74C3C; width: 100%; padding: 15px; font-size: 32px; border-radius: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- DEBUG MINIGAMES MENU -->
    <ui:Button name="BtnDebugGames" text="🎮" style="position: absolute; bottom: 180px; right: 20px; width: 100px; height: 100px; border-radius: 50px; font-size: 50px; background-color: #E74C3C; color: white; -unity-font-style: bold; border-width: 0;" />
    <ui:VisualElement name="DebugGamesOverlay" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(15,23,42,0.95); padding: 40px; justify-content: center; align-items: center;">
        <ui:VisualElement class="card" style="width: 100%; height: 90%; background-color: #1E293B; border-color: #E74C3C; border-width: 2px; border-radius: 20px; padding: 25px;">
            <ui:Label text="DEBUG TEST MENU &amp; CONSOLE" style="color: #E74C3C; font-size: 32px; -unity-font-style: bold; margin-bottom: 20px;" />
            <ui:ScrollView vertical-scroller-visibility="AlwaysVisible" style="flex-grow: 1; margin-bottom: 20px;">
                <ui:Label text="--- MINI GAMES ---" style="color: white; font-size: 24px; -unity-font-style: bold; margin-bottom: 10px;" />
                <ui:VisualElement name="DebugGamesList" />
                <ui:Label text="--- CONSOLE ERRORS ---" style="color: white; font-size: 24px; -unity-font-style: bold; margin-top: 20px; margin-bottom: 10px;" />
                <ui:Label name="DebugConsoleLog" text="" style="color: #E74C3C; font-size: 18px; white-space: normal;" />
            </ui:ScrollView>
            <ui:Button name="BtnCloseDebugGames" text="CLOSE MENU" class="action-button" style="background-color: #E74C3C; width: 100%; padding: 15px; font-size: 24px; border-radius: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
