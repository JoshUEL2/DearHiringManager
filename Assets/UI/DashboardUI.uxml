<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    
    <ui:Style src="styles.uss" />

    <ui:VisualElement class="screen-container" style="padding-bottom: 320px;">
        
        <!-- TOP CARD ROOT -->
        <ui:VisualElement name="TopCardRoot" class="card top-card-root" style="margin-bottom: 20px; border-radius: 0 0 24px 24px; border-width: 0 0 3px 0; padding: 0; flex-direction: column; overflow: hidden;">
            
            <!-- Animated watermark layer -->
            <ui:VisualElement name="WatermarkContainer" style="position: absolute; left: -200px; top: -200px; right: -200px; bottom: -200px; overflow: hidden;" />

            <!-- ROW 1: Notch-safe icons -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding: 18px 30px 0 30px;">
                <ui:Button name="BtnOpenSettings" class="top-icon-btn" style="background-color: rgba(255,255,255,0.08); border-width: 1px; border-color: rgba(255,255,255,0.15); border-radius: 14px; padding: 10px 18px; margin: 0;">
                    <ui:VisualElement class="top-bar-icon-img top-icon-settings" />
                </ui:Button>
                <ui:VisualElement style="width: 120px;" />
                <ui:Button name="BtnOpenMigration" class="top-icon-btn" style="background-color: rgba(255,255,255,0.08); border-width: 1px; border-color: rgba(255,255,255,0.15); border-radius: 14px; padding: 10px 18px; margin: 0;">
                    <ui:VisualElement class="top-bar-icon-img top-icon-migration" />
                </ui:Button>
            </ui:VisualElement>

            <!-- ROW 2: Name (left) + Job (right), full width -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: flex-end; padding: 14px 30px 0 30px;">
                <ui:Button name="BtnViewCV" class="id-card-name-btn" text="PlayerName" style="font-size: 52px; color: #F8FAFC; -unity-font-style: bold; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-color: rgba(56, 189, 248, 0.4); padding: 0 0 4px 0; margin: 0; -unity-text-align: middle-left;" />
                <ui:Label name="JobText" text="Unemployed" style="font-size: 32px; color: #38BDF8; -unity-font-style: bold; margin: 0; padding: 0 0 6px 0;" />
            </ui:VisualElement>

            <!-- ROW 3: Finances spread full width -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding: 12px 30px 20px 30px;">
                <ui:Label name="IncomeText" text="+$0.00" style="font-size: 28px; color: #4ADE80; -unity-font-style: bold; margin: 0; padding: 0;" />
                <ui:Label name="CashText" text="$0.00" style="font-size: 56px; color: #F8FAFC; -unity-font-style: bold; margin: 0; padding: 0;" />
                <ui:Label name="ExpenseText" text="-$0.00" style="font-size: 28px; color: #F87171; -unity-font-style: bold; margin: 0; padding: 0;" />
            </ui:VisualElement>

            <!-- District accent bar -->
            <ui:VisualElement name="DistrictAccentBar" style="height: 4px; background-color: #38BDF8; border-radius: 0 0 24px 24px;" />
        </ui:VisualElement>

        <ui:Label name="DashboardTitle" text="DASHBOARD" class="header-text" style="margin: 0; margin-bottom: 20px;" />

        <!-- TERMINAL LOG -->
        <ui:VisualElement name="TerminalCard" class="card terminal-card" style="flex-grow: 1; margin-bottom: 0; overflow: hidden; border-width: 2px 2px 0 2px; border-radius: 20px 20px 0 0; padding: 30px 30px 0 30px;">
            <ui:ScrollView name="TerminalScrollView" style="flex-grow: 1;">
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Label name="LogText" text="" enable-rich-text="true" style="font-size: 24px; white-space: normal; padding-bottom: 70px;" />
            </ui:ScrollView>
            <ui:VisualElement name="TerminalBottomFade" class="terminal-bottom-fade" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- FROSTED BLUR SHIELD BEHIND BOTTOM NAV -->
    <ui:VisualElement name="BottomNavBlurShield" class="bottom-nav-blur-shield" />

    <!-- NEW BOTTOM NAV & FOOTER -->
    <ui:VisualElement class="bottom-nav-container">
        <!-- Nav Buttons -->
        <ui:VisualElement class="nav-bar-row">
            <ui:Button name="BtnCareers" class="nav-button">
                <ui:VisualElement class="nav-button-icon-img nav-icon-careers" />
                <ui:Label text="Careers" class="nav-button-label" />
            </ui:Button>
            <ui:Button name="BtnHustles" class="nav-button">
                <ui:VisualElement class="nav-button-icon-img nav-icon-hustles" />
                <ui:Label text="Hustles" class="nav-button-label" />
            </ui:Button>
            <ui:Button name="BtnAdvanceWeek" class="advance-week-btn">
                <ui:Label text="+ Week" class="advance-week-label" />
            </ui:Button>
            <ui:Button name="BtnEducation" class="nav-button">
                <ui:VisualElement class="nav-button-icon-img nav-icon-education" />
                <ui:Label text="Education" class="nav-button-label" />
            </ui:Button>
            <ui:Button name="BtnActivities" class="nav-button">
                <ui:VisualElement class="nav-button-icon-img nav-icon-activities" />
                <ui:Label text="Activities" class="nav-button-label" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Progress Bars -->
        <ui:VisualElement class="footer-stats-row">
            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Performance" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="PerfVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="PerfFill" class="progress-fill" style="width: 0%; background-color: #F1C40F;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Job Luck" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="LuckVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="LuckFill" class="progress-fill" style="width: 0%; background-color: #2ECC71;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Stress" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="StressVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="StressFill" class="progress-fill" style="width: 0%; background-color: #E74C3C;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- SETTINGS OVERLAY -->
    <ui:VisualElement name="SettingsOverlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(5, 8, 14, 0.92); justify-content: center; align-items: center; display: none; opacity: 0; transition-property: opacity; transition-duration: 0.25s;">
        <ui:VisualElement name="SettingsCard" class="card" style="width: 94%; max-width: 940px; max-height: 88%; background-color: #0E121B; border-color: #242E46; border-width: 2px; border-radius: 28px; padding: 28px; scale: 1 0; transition-property: scale, opacity; transition-duration: 0.28s; transition-timing-function: ease-out-back;">
            
            <!-- Header Row with Animated Close Button -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 6px;">
                <ui:Label text="SIMULATION SETTINGS" class="header-text" style="font-size: 36px; -unity-font-style: bold; color: #38BDF8; margin: 0;" />
                <ui:Button name="BtnCloseSettingsTop" class="modern-close-btn">
                    <ui:VisualElement class="modern-close-icon" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label text="Manage citizen state, visual style, or reset simulation timeline." style="font-size: 24px; color: #94A3B8; margin-bottom: 18px;" />
            
            <ui:ScrollView style="flex-grow: 1; width: 100%; padding-right: 6px;">
                <!-- Group 1: Past Survived Timelines -->
                <ui:VisualElement class="settings-section-card">
                    <ui:Label text="TIMELINE ARCHIVE" class="settings-section-title" />
                    <ui:ScrollView name="HistoryContainer" vertical-scroller-visibility="AlwaysVisible" style="height: 320px; background-color: #07090E; border-color: #242E46; border-width: 1.5px; border-radius: 16px; padding: 14px; margin-bottom: 14px;" />
                    <ui:Button name="BtnExpandHistory" text="VIEW ALL TIMELINES" class="settings-action-btn" style="background-color: #38BDF8; color: #082F49; -unity-font-style: bold; border-width: 0; width: 100%;" />
                </ui:VisualElement>

                <!-- Group 2: Display & Developer Preferences -->
                <ui:VisualElement class="settings-section-card">
                    <ui:Label text="SYSTEM &amp; DISPLAY" class="settings-section-title" />
                    <ui:Button name="BtnToggleTheme" text="Toggle Dark Mode" class="settings-action-btn" style="margin-bottom: 12px; background-color: #1E293B; border-color: #334155; border-width: 1.5px; color: #F8FAFC; width: 100%;" />
                    <ui:Button name="BtnToggleDevConsole" text="Dev Tools: OFF" class="settings-action-btn" style="background-color: rgba(239, 68, 68, 0.15); border-color: #EF4444; border-width: 1.5px; color: #F87171; width: 100%;" />
                </ui:VisualElement>

                <!-- Group 3: Danger Zone -->
                <ui:VisualElement class="settings-section-card" style="border-color: rgba(239, 68, 68, 0.4);">
                    <ui:Label text="DANGER ZONE" class="settings-section-title" style="color: #F87171;" />
                    <ui:Button name="BtnWipeHistory" text="MAKE NEW LIFE (RESET)" class="settings-action-btn" style="background-color: rgba(239, 68, 68, 0.2); border-color: #EF4444; border-width: 1.5px; color: #FFFFFF; -unity-font-style: bold; width: 100%;" />
                </ui:VisualElement>
            </ui:ScrollView>
            
            <ui:Button name="BtnCloseSettings" text="Back to Simulation" style="background-color: transparent; border-color: #38BDF8; border-width: 2px; color: #38BDF8; -unity-font-style: bold; font-size: 28px; border-radius: 27px; height: 54px; width: 65%; align-self: center; margin-top: 16px;" />
            
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="ExpandedHistoryOverlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(5, 8, 14, 0.92); justify-content: center; align-items: center; display: none; opacity: 0; padding: 30px; transition-property: opacity; transition-duration: 0.25s;">
        <ui:VisualElement name="ExpandedHistoryCard" class="card" style="width: 95%; max-width: 960px; height: 92%; background-color: #0E121B; border-color: #242E46; border-width: 2px; border-radius: 28px; padding: 28px; scale: 1 0; transition-property: scale, opacity; transition-duration: 0.28s; transition-timing-function: ease-out-back;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 16px;">
                <ui:Label text="ALL PAST TIMELINES" style="color: #38BDF8; font-size: 34px; -unity-font-style: bold; margin: 0;" />
                <ui:Button name="BtnCloseExpandedHistoryTop" class="modern-close-btn">
                    <ui:VisualElement class="modern-close-icon" />
                </ui:Button>
            </ui:VisualElement>
            <ui:ScrollView name="ExpandedHistoryContainer" vertical-scroller-visibility="AlwaysVisible" style="flex-grow: 1; margin-bottom: 20px; background-color: #07090E; border-color: #242E46; border-width: 1.5px; border-radius: 20px; padding: 18px;" />
            <ui:Button name="BtnCloseExpandedHistory" text="CLOSE ARCHIVE" class="settings-action-btn" style="background-color: transparent; border-color: #242E46; border-width: 2px; color: #94A3B8; font-size: 28px; width: 65%; align-self: center;" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- DEBUG MINIGAMES MENU -->
    <ui:Button name="BtnDebugGames" text="DEV" style="position: absolute; bottom: 180px; right: 20px; width: 90px; height: 90px; border-radius: 45px; font-size: 26px; background-color: #E74C3C; color: white; -unity-font-style: bold; border-width: 0;" />
    <ui:VisualElement name="DebugGamesOverlay" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(15,23,42,0.95); padding: 40px; justify-content: center; align-items: center; opacity: 0; transition-property: opacity; transition-duration: 0.2s;">
        <ui:VisualElement name="DebugGamesCard" class="card" style="width: 100%; height: 90%; background-color: #1E293B; border-color: #E74C3C; border-width: 2px; border-radius: 20px; padding: 25px; scale: 1 0; transition-property: scale; transition-duration: 0.3s; transition-timing-function: ease-out-back;">
            <ui:Label text="DEBUG TEST MENU &amp; CONSOLE" style="color: #E74C3C; font-size: 32px; -unity-font-style: bold; margin-bottom: 20px;" />
            <ui:ScrollView vertical-scroller-visibility="AlwaysVisible" style="flex-grow: 1; margin-bottom: 20px;">
                <ui:Label text="--- MINI GAMES ---" style="color: white; font-size: 24px; -unity-font-style: bold; margin-bottom: 10px;" />
                <ui:VisualElement name="DebugGamesList" />
                <ui:Label text="--- CONSOLE ERRORS ---" style="color: white; font-size: 24px; -unity-font-style: bold; margin-top: 20px; margin-bottom: 10px;" />
                <ui:Label name="DebugConsoleLog" text="" style="color: #E74C3C; font-size: 18px; white-space: normal;" />
            </ui:ScrollView>
            <ui:Button name="BtnCloseDebugGames" text="CLOSE MENU" class="action-button" style="background-color: #E74C3C; width: 100%; padding: 15px; font-size: 24px; border-radius: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
