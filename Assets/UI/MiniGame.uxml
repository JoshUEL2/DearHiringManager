<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <ui:Style src="styles.uss" />

    <!-- Full screen dark overlay -->
    <ui:VisualElement name="Overlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; display: none;">
        <!-- Terminal Window -->
        <ui:VisualElement class="popup-card" style="padding: 20px; max-height: 95%; margin-top: -20px; position: relative;">
            <!-- Abort Button (Top Left of Card) -->
            <ui:Button name="BtnAbortMinigame" text="X" class="popup-button" style="position: absolute; left: -20px; top: -20px; width: 60px; height: 60px; border-radius: 30px; font-size: 30px; -unity-font-style: bold; background-color: #E74C3C; color: white; justify-content: center; align-items: center;" />

            <!-- Header -->
            <ui:Label name="OperationNameText" text="[Name]" style="font-size: 38px; -unity-font-style: bold; color: #38BDF8; margin-bottom: 10px; -unity-text-align: middle-center;" />
            <ui:Label name="InstructionsText" text="[Instructions go here]" style="font-size: 28px; color: #FFFFFF; white-space: normal; margin-bottom: 30px; -unity-text-align: middle-center;" />

            <ui:ScrollView style="flex-grow: 1; min-height: 500px; max-height: 900px;">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
