/* Base Screen Background */
.screen-container {
    flex-grow: 1;
    background-color: #0A1128; /* Deep dark blue */
    padding: 20px; 
    padding-bottom: 160px; /* Room for bottom nav */
    align-items: stretch; 
}

/* Typography */
.header-text {
    font-size: 50px; 
    -unity-font-style: bold;
    color: #38BDF8; 
    margin-bottom: 12px;
    white-space: normal;
}

.sub-text {
    font-size: 32px; 
    color: #94A3B8;
    margin-bottom: 15px;
    white-space: normal;
}

/* UI Elements */
.card {
    width: 100%;
}

.top-card {
    background-color: rgba(43, 27, 21, 0.85); /* Glassmorphic dark brown */
    border-color: rgba(92, 58, 33, 0.5);
    border-width: 1px;
    border-radius: 20px;
    padding: 20px; 
    margin-bottom: 20px;
    flex-shrink: 0;
}

.action-button {
    background-color: rgba(56, 189, 248, 0.9); /* Sleek translucent blue */
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 20px;
    padding: 30px; 
    width: 100%;
    border-width: 0;
    transition: background-color 0.2s ease-in-out;
}

.action-button:hover {
    background-color: #0284C7;
}

/* Layout Helpers */
.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.column {
    flex-direction: column;
}

/* Dashboard Specifics */
.stat-col {
    flex-direction: column;
    width: 48%;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
}

.mini-label {
    font-size: 28px;
    color: #94A3B8;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat-value {
    font-size: 36px;
    -unity-font-style: bold;
    color: #2ECC71; 
}

/* Job Board & General Light Cards */
.job-card, .career-card {
    background-color: rgba(26, 36, 54, 0.85); /* Glassmorphism */
    border-color: rgba(255, 255, 255, 0.1); 
    border-width: 2px;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 30px;
    min-height: 200px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

.job-title {
    font-size: 40px; 
    -unity-font-style: bold;
    color: #38BDF8; 
    white-space: normal;
    margin-bottom: 8px;
}

.job-desc {
    font-size: 32px;
    color: #94A3B8;
    white-space: normal;
    margin-bottom: 5px;
}

.career-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 8px;
}

.card-btn, .apply-button {
    background-color: rgba(76, 175, 80, 0.9);
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    border-radius: 20px;
    padding: 20px 36px;
    border-width: 0;
    margin-top: 15px;
    flex-shrink: 0;
    transition: background-color 0.2s;
}

.card-btn:hover, .apply-button:hover {
    background-color: rgba(69, 160, 73, 1);
}

.job-salary {
    font-size: 32px;
    -unity-font-style: bold;
    color: #E74C3C;
}

/* Hustles (Danger/Illegal Actions) */
.progress-track {
    background-color: #334155;
    height: 4px; 
    width: 100%;
    margin-top: 5px;
    border-radius: 2px;
}
.progress-fill {
    height: 100%;
    border-radius: 2px;
}

.danger-card {
    background-color: rgba(26, 36, 54, 0.85);
    border-color: rgba(231, 76, 60, 0.3);
    border-width: 2px;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 30px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

.danger-text {
    font-size: 40px;
    -unity-font-style: bold;
    color: #E74C3C;
    white-space: normal;
    margin-bottom: 8px;
}

.danger-button {
    background-color: rgba(231, 76, 60, 0.9);
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    border-radius: 20px;
    padding: 20px 36px;
    border-width: 0;
    margin-top: 15px;
    flex-shrink: 0;
    transition: background-color 0.2s;
}

.danger-button:hover {
    background-color: rgba(192, 57, 43, 1);
}

/* Super Nav & Footer */
.bottom-nav-container {
    position: absolute;
    bottom: 40px;
    left: 30px;
    right: 30px;
    background-color: rgba(14, 38, 74, 0.95); /* Deep rich blue for better contrast */
    border-color: rgba(56, 189, 248, 0.5);
    border-width: 2px;
    border-radius: 36px;
    flex-direction: column;
    padding: 30px 24px; 
}

.nav-bar-row {
    flex-direction: row;
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 12px;
    width: 100%;
    flex-wrap: nowrap;
    overflow: hidden;
}

.nav-button {
    background-color: transparent;
    color: #94A3B8;
    border-width: 0;
    font-size: 28px; 
    -unity-font-style: bold;
    white-space: normal; 
    -unity-text-align: middle-center;
    flex-grow: 1;
    flex-shrink: 1; 
    margin: 0;
    padding: 5px;
    transition: color 0.2s;
}

.nav-button:hover {
    color: #38BDF8;
}

.advance-week-btn {
    background-color: #2ECC71;
    color: white;
    border-radius: 45px; /* Perfect pill */
    height: 120px;
    width: 280px; 
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    flex-shrink: 0;
    margin-left: 10px;
    margin-right: 10px;
    transition: background-color 0.2s, scale 0.1s;
}

.advance-week-btn:hover {
    background-color: #27AE60;
    scale: 1.05;
}

.footer-stats-row {
    flex-direction: row;
    justify-content: space-between;
}

.footer-stat {
    flex-direction: column;
    width: 30%;
}

/* Globally Hide Scrollbars for Mobile Swiping */
.unity-scroller--vertical, .unity-scroller--horizontal {
    opacity: 0;
    width: 0;
}

.footer-label, .footer-val {
    font-size: 30px;
    color: #FFFFFF;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* NEW CAREER UI CLASSES */
.badge {
    border-radius: 8px;
    padding: 4px 12px;
    -unity-font-style: bold;
    font-size: 28px;
    margin-right: 15px;
    -unity-text-align: middle-center;
}

.badge-blue {
    background-color: rgba(30, 58, 138, 0.9);
    color: #38BDF8;
}

.badge-orange {
    background-color: rgba(62, 39, 35, 0.9);
    color: #E67E22;
}

.task-card {
    background-color: rgba(15, 23, 42, 0.85); /* Dark surface */
    border-color: rgba(255, 255, 255, 0.2); 
    border-width: 1px;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.btn-do-task-green {
    background-color: #2ECC71;
    color: white;
    -unity-font-style: bold;
    font-size: 28px;
    border-radius: 12px;
    padding: 15px 30px;
    border-width: 0;
    transition: background-color 0.2s;
}

.btn-do-task-green:hover {
    background-color: #27AE60;
}

.btn-do-task-blue {
    background-color: #0284C7;
    color: white;
    -unity-font-style: bold;
    font-size: 28px;
    border-radius: 12px;
    padding: 15px 30px;
    border-width: 0;
    transition: background-color 0.2s;
}

.btn-do-task-blue:hover {
    background-color: #026AA7;
}

/* POPUP STYLING */
.popup-card {
    background-color: rgba(26, 36, 54, 0.98);
    border-color: #38BDF8;
    border-width: 3px;
    border-radius: 30px;
    padding: 50px;
    width: 85%;
    align-items: center;
}

.popup-button {
    background-color: #38BDF8;
    color: #0A1128;
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 20px;
    padding: 25px 40px;
    border-width: 0;
    margin-top: 30px;
    width: 100%;
    transition: background-color 0.2s, scale 0.1s;
}

.popup-button:hover {
    background-color: #0284C7;
    color: white;
    scale: 1.05;
}

.memory-card {
    width: 140px;
    height: 140px;
    margin: 10px;
    background-color: #1E293B;
    border-color: #475569;
    border-width: 4px;
    border-radius: 15px;
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    white-space: normal;
}
.memory-card:hover {
    background-color: #334155;
    border-color: #38BDF8;
}
.memory-card-matched {
    width: 140px;
    height: 140px;
    margin: 10px;
    border-width: 4px;
    border-radius: 15px;
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

/* === NEW MINIGAME STYLES === */

.grid-cell {
    width: 110px;
    height: 110px;
    margin: 4px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #475569;
    border-radius: 8px;
    font-size: 28px;
    -unity-font-style: bold;
    color: #94A3B8;
    -unity-text-align: middle-center;
}

.grid-cell-player {
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

.grid-cell-danger {
    background-color: #7F1D1D;
    border-color: #E74C3C;
    color: #FCA5A5;
}

.grid-cell-goal {
    background-color: #713F12;
    border-color: #F1C40F;
    color: #FDE68A;
}

.whack-cell {
    width: 170px;
    height: 170px;
    margin: 8px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #475569;
    border-radius: 12px;
    font-size: 50px;
    -unity-text-align: middle-center;
}

.whack-cell-active {
    background-color: #14532D;
    border-color: #2ECC71;
}

.whack-cell-decoy {
    background-color: #7F1D1D;
    border-color: #E74C3C;
}

.code-slot {
    width: 100px;
    height: 100px;
    margin: 6px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #38BDF8;
    border-radius: 10px;
    font-size: 36px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.code-symbol-btn {
    width: 80px;
    height: 80px;
    margin: 5px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.code-feedback-correct {
    color: #2ECC71;
}

.code-feedback-misplaced {
    color: #F1C40F;
}

.code-feedback-wrong {
    color: #475569;
}

.order-item {
    min-width: 140px;
    height: 80px;
    margin: 6px;
    padding: 10px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.order-item-selected {
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

.order-item-preview {
    background-color: #1E3A5F;
    border-color: #38BDF8;
    color: #38BDF8;
}

.drag-item {
    padding: 15px;
    margin-bottom: 8px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.drag-item-selected {
    border-color: #38BDF8;
    background-color: #1E3A5F;
}

.drag-item-matched {
    border-color: #2ECC71;
    background-color: #14532D;
    color: #4ADE80;
}

/* Grid Dodge Specific Styles */
.grid-dodge-hud {
    flex-direction: row; justify-content: center; width: 360px; margin-bottom: 20px; 
    background-color: rgba(26, 36, 54, 0.9); padding: 12px; border-radius: 20px;
    border-width: 2px; border-color: rgba(56, 189, 248, 0.5);
}
.grid-dodge-health {
    background-color: #E74C3C; padding: 10px 24px; border-radius: 14px; 
    border-bottom-width: 4px; border-color: #C0392B;
}
.grid-dodge-health-text {
    font-size: 26px; color: white; -unity-font-style: bold; margin: 0; padding: 0;
}
.grid-dodge-board {
    width: 380px; height: 380px; background-color: #022C22; border-radius: 20px; 
    border-width: 8px; border-color: #10B981; padding: 4px;
    overflow: hidden; position: relative;
}
.grid-dodge-cell {
    flex-grow: 1; border-width: 2px; border-radius: 12px; margin: 2px;
    transition-property: background-color, border-color, scale; transition-duration: 0.2s;
}
.grid-dodge-cell-safe {
    background-color: #FBBF24; border-color: #F59E0B;
    border-bottom-width: 5px; border-bottom-color: #D97706;
}
.grid-dodge-cell-hazard {
    background-color: #15803D; border-color: #166534;
    border-top-width: 5px; border-top-color: #22C55E;
}
.grid-dodge-cell-goal {
    background-color: #3B82F6; border-color: #2563EB;
    border-bottom-width: 5px; border-bottom-color: #1D4ED8;
}
.grid-dodge-player {
    position: absolute; width: 100%; height: 100%; 
    align-items: center; justify-content: center;
    transition-property: left, top; transition-duration: 0.15s; transition-timing-function: ease-out-bounce;
}
.grid-dodge-player-icon {
    font-size: 40px; -unity-text-align: middle-center;
    background-color: rgba(255,255,255,0.25); border-radius: 50%;
    width: 85%; height: 85%;
}
.grid-dodge-damage-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0; 
    background-color: rgba(220, 38, 38, 0); picking-mode: ignore;
    transition-property: background-color; transition-duration: 0.2s;
    border-radius: 12px;
}

/* TicketSwipe Specific Styles */
.ts-hud {
    flex-direction: row; justify-content: space-between; width: 400px; margin-bottom: 20px; 
}
.ts-hud-item {
    padding: 10px 20px; border-radius: 12px; border-width: 2px;
}
.ts-hud-score {
    background-color: #1E3A8A; border-color: #3B82F6;
}
.ts-hud-time {
    background-color: #7F1D1D; border-color: #EF4444;
}
.ts-hud-text {
    font-size: 24px; color: white; -unity-font-style: bold; margin: 0; padding: 0;
}
.ts-card-stack {
    width: 400px; height: 260px; position: relative; margin-bottom: 30px;
    align-items: center; justify-content: center;
}
.ts-card {
    position: absolute; width: 100%; height: 100%; left: 0; top: 0;
    background-color: #F8FAFC; border-radius: 16px; border-width: 3px; border-color: #CBD5E1;
    padding: 24px; align-items: center; justify-content: center;
    transition-property: translate, scale, opacity, background-color, border-color; 
    transition-duration: 0.3s; transition-timing-function: ease-out;
}
.ts-card-text {
    font-size: 28px; color: #0F172A; -unity-font-style: bold; white-space: normal; 
    -unity-text-align: middle-center;
}

.ts-btn:hover {
    scale: 1.05;
}
.ts-btn-spam {
    background-color: #B91C1C; border-color: #F87171;
}
.ts-btn-spam:hover { background-color: #DC2626; }
.ts-btn-resolve {
    background-color: #15803D; border-color: #4ADE80;
}
.ts-btn-resolve:hover { background-color: #16A34A; }
.ts-btn-escalate {
    background-color: #B45309; border-color: #FBBF24;
}
.ts-btn-escalate:hover { background-color: #D97706; }

/* TicketSwipe Post-It and Fixes */
.ts-btn-row {
    flex-direction: row; justify-content: space-between; width: 400px;
}
.ts-btn {
    width: 32%; height: 70px; margin: 0; border-radius: 12px; border-width: 2px;
    font-size: 18px; -unity-font-style: bold; color: white; white-space: normal;
    transition-property: scale, background-color; transition-duration: 0.1s;
}

.ts-card-mock {
    position: absolute; width: 100%; height: 100%;
    background-color: #E2E8F0; border-radius: 16px; border-width: 2px; border-color: #CBD5E1;
}
.ts-card-mock-1 { top: -6px; left: -6px; opacity: 0.8; }
.ts-card-mock-2 { top: -12px; left: -12px; opacity: 0.6; }
.ts-card-mock-3 { top: -18px; left: -18px; opacity: 0.4; }

.ts-post-it {
    width: 260px; background-color: #FEF08A; border-radius: 4px; padding: 15px;
    border-bottom-width: 4px; border-right-width: 4px; border-color: #CA8A04;
    transform-origin: center; rotate: 2deg;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5); /* May not work in old unity, but harmless */
}
.ts-post-it-title {
    font-size: 24px; -unity-font-style: bold; color: #854D0E; 
    -unity-text-align: middle-center; margin-bottom: 15px;
    border-bottom-width: 2px; border-color: #A16207; padding-bottom: 5px;
}
.ts-post-it-header {
    font-size: 18px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 2px;
}
.ts-post-it-desc {
    font-size: 16px; color: #422006; white-space: normal; margin-bottom: 10px;
}


/* =========================================
   CONSTRUCTION SITE: THERMAL SCANNER
========================================= */
.cs-main {
    flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%;
}
.cs-hud {
    flex-direction: row; justify-content: space-between; align-items: center;
    width: 700px; margin-bottom: 20px;
}
.cs-hud-title {
    font-size: 16px; -unity-font-style: bold; color: #E2E8F0;
}
.cs-hud-time {
    font-size: 28px; -unity-font-style: bold; color: #F87171;
}

.cs-wall {
    width: 700px; height: 400px; background-color: #64748B; border-radius: 12px;
    border-width: 4px; border-color: #334155; position: relative; overflow: hidden;
}

/* The Scanner Viewport */
.cs-scanner {
    width: 220px; height: 220px; position: absolute; left: 0; top: 0;
    border-radius: 110px; overflow: hidden; border-width: 4px; border-color: #38BDF8;
    background-color: #0F172A; /* Base color for thermal view */
}

/* The Thermal Layer (Inverse Translates) */
.cs-thermal-layer {
    width: 700px; height: 400px; position: absolute; left: 0; top: 0;
    background-color: #1E1B4B; /* Deep purple/blue cold thermal background */
}

/* The Hotspot */
.cs-hotspot {
    position: absolute;
    width: 30px;
    height: 30px;
    background-color: rgba(239, 68, 68, 0.4);
    border-radius: 15px;
    align-items: center;
    justify-content: center;
    transition: opacity 0.1s, scale 0.1s;
}
.cs-hotspot-core {
    width: 12px;
    height: 12px;
    background-color: rgba(239, 68, 68, 0.9);
    border-radius: 6px;
}

/* Scanner Overlays */
.cs-scanner-glass {
    position: absolute; width: 100%; height: 100%; left: 0; top: 0;
    align-items: center; justify-content: center;
    /* Optional scanlines effect using transparent border or background */
}
.cs-reticle {
    width: 30px; height: 30px; border-width: 2px; border-color: #38BDF8;
    border-radius: 15px; position: absolute;
}
.cs-progress-bar {
    position: absolute; bottom: 30px; width: 120px; height: 12px;
    background-color: rgba(0,0,0,0.5); border-radius: 6px; border-width: 1px; border-color: #0EA5E9;
    overflow: hidden;
}
.cs-progress-fill {
    height: 100%; width: 0%; background-color: #38BDF8;
}
.cs-status-text {
    position: absolute; bottom: 10px; font-size: 14px; color: #38BDF8; -unity-font-style: bold;
}

.cs-radar-sweep {
    position: absolute;
    width: 110px;
    height: 110px;
    top: 110px;
    left: 110px;
    background-color: rgba(56, 189, 248, 0.4);
    border-bottom-right-radius: 110px;
    transform-origin: 0% 0%;
}

/* ======================================================== */
/* QA Triage: Bureaucratic Bug Stamping */
/* ======================================================== */

.qa-main {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 500px;
}

.qa-desk {
    width: 100%;
    height: 100%;
    background-color: #5C4033; /* Dark mahogany wood color */
    flex-direction: column;
}

.qa-hud {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    background-color: rgba(0,0,0,0.4);
    border-bottom-width: 4px;
    border-bottom-color: #3e2b22;
}

.qa-hud-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FBBF24;
}

.qa-hud-score {
    font-size: 24px;
    -unity-font-style: bold;
    color: #34D399;
}

.qa-hud-time {
    font-size: 24px;
    -unity-font-style: bold;
    color: #F87171;
}

.qa-play-area {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.qa-paper {
    width: 600px;
    height: 350px;
    background-color: #FDFBF7;
    border-radius: 4px;
    border-width: 2px;
    border-color: #D4D4D8;
    padding: 20px;
    box-shadow: 0px 10px 20px rgba(0,0,0,0.5);
    flex-direction: column;
}

.qa-paper-slide-in {
    translate: 0px 0px;
    transition: translate 0.3s ease-out-back;
}

.qa-paper-slide-out {
    translate: 1000px 0px;
    transition: translate 0.3s ease-in;
}

.qa-paper-slide-hidden {
    translate: -1000px 0px;
    transition: none;
}

.qa-paper-header {
    font-size: 32px;
    -unity-font-style: bold;
    color: #3F3F46;
    -unity-text-align: middle-center;
    border-bottom-width: 2px;
    border-bottom-color: #E4E4E7;
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.qa-paper-log {
    font-size: 24px;
    color: #18181B;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
    -unity-font-definition: none; /* Monospace fallback */
}

.qa-paper-stamps-area {
    flex-direction: row;
    justify-content: space-around;
    height: 120px;
    margin-top: 20px;
}

.qa-stamp-box {
    width: 200px;
    border-width: 3px;
    border-color: #A1A1AA;
    border-radius: 8px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 10px;
    position: relative;
}

.qa-stamp-box-title {
    font-size: 16px;
    color: #71717A;
    -unity-font-style: bold;
}

.qa-ink {
    position: absolute;
    top: 35px;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition: opacity 0.15s, scale 0.15s ease-out-bounce;
    scale: 2 2;
}

.qa-ink-visible {
    opacity: 0.85;
    scale: 1 1;
}

.qa-ink-red {
    color: #DC2626;
}

.qa-ink-blue {
    color: #2563EB;
}

.qa-controls {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 20px 40px;
    background-color: rgba(0,0,0,0.5);
    border-top-width: 4px;
    border-top-color: #3e2b22;
}

.qa-stamp-group {
    flex-direction: column;
    align-items: center;
}

.qa-group-title {
    font-size: 18px;
    color: #D4D4D8;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.qa-stamp-row {
    flex-direction: row;
}

.qa-stamp-btn {
    width: 120px;
    height: 60px;
    margin: 0 10px;
    border-radius: 8px;
    font-size: 20px;
    -unity-font-style: bold;
    color: white;
    border-width: 4px;
    border-bottom-width: 8px;
    transition: translate 0.1s, border-bottom-width 0.1s;
}

.qa-stamp-btn:active {
    border-bottom-width: 4px;
    translate: 0 4px;
}

.qa-stamp-btn-red {
    background-color: #B91C1C;
    border-color: #7F1D1D;
}

.qa-stamp-btn-blue {
    background-color: #1D4ED8;
    border-color: #1E3A8A;
}

.qa-submit-group {
    justify-content: center;
    align-items: center;
    padding-bottom: 10px;
}

.qa-submit-btn {
    width: 200px;
    height: 80px;
    background-color: #047857;
    border-color: #064E3B;
    border-width: 4px;
    border-bottom-width: 12px;
    border-radius: 12px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    transition: translate 0.1s, border-bottom-width 0.1s;
}

.qa-submit-btn:active {
    border-bottom-width: 4px;
    translate: 0 8px;
}
