/* Base Screen Background */
.screen-container {
    flex-grow: 1;
    background-color: #0A1128; /* Deep dark blue */
    padding: 20px; 
    padding-bottom: 160px; /* Room for bottom nav */
    align-items: stretch; 
}

/* Typography */
.header-text {
    font-size: 50px; 
    -unity-font-style: bold;
    color: #38BDF8; 
    margin-bottom: 12px;
    white-space: normal;
}

.sub-text {
    font-size: 32px; 
    color: #94A3B8;
    margin-bottom: 15px;
    white-space: normal;
}

/* UI Elements */
.card {
    width: 100%;
}

.top-card {
    background-color: rgba(43, 27, 21, 0.85); /* Glassmorphic dark brown */
    border-color: rgba(92, 58, 33, 0.5);
    border-width: 1px;
    border-radius: 20px;
    padding: 20px; 
    margin-bottom: 20px;
    flex-shrink: 0;
}

.action-button {
    background-color: rgba(56, 189, 248, 0.9); /* Sleek translucent blue */
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 20px;
    padding: 30px; 
    width: 100%;
    border-width: 0;
    transition: background-color 0.2s ease-in-out;
}

.action-button:hover {
    background-color: #0284C7;
}

/* Layout Helpers */
.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.column {
    flex-direction: column;
}

/* Dashboard Specifics */
.stat-col {
    flex-direction: column;
    width: 48%;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
}

.mini-label {
    font-size: 28px;
    color: #94A3B8;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat-value {
    font-size: 36px;
    -unity-font-style: bold;
    color: #2ECC71; 
}

/* Job Board & General Light Cards */
.job-card, .career-card {
    background-color: rgba(26, 36, 54, 0.85); /* Glassmorphism */
    border-color: rgba(255, 255, 255, 0.1); 
    border-width: 2px;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 30px;
    min-height: 200px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

.job-title {
    font-size: 40px; 
    -unity-font-style: bold;
    color: #38BDF8; 
    white-space: normal;
    margin-bottom: 8px;
}

.job-desc {
    font-size: 32px;
    color: #94A3B8;
    white-space: normal;
    margin-bottom: 5px;
}

.career-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 8px;
}

.card-btn, .apply-button {
    background-color: rgba(76, 175, 80, 0.9);
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    border-radius: 20px;
    padding: 20px 36px;
    border-width: 0;
    margin-top: 15px;
    flex-shrink: 0;
    transition: background-color 0.2s;
}

.card-btn:hover, .apply-button:hover {
    background-color: rgba(69, 160, 73, 1);
}

.job-salary {
    font-size: 32px;
    -unity-font-style: bold;
    color: #E74C3C;
}

/* Hustles (Danger/Illegal Actions) */
.progress-track {
    background-color: #334155;
    height: 4px; 
    width: 100%;
    margin-top: 5px;
    border-radius: 2px;
}
.progress-fill {
    height: 100%;
    border-radius: 2px;
}

.danger-card {
    background-color: rgba(26, 36, 54, 0.85);
    border-color: rgba(231, 76, 60, 0.3);
    border-width: 2px;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 30px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

.danger-text {
    font-size: 40px;
    -unity-font-style: bold;
    color: #E74C3C;
    white-space: normal;
    margin-bottom: 8px;
}

.danger-button {
    background-color: rgba(231, 76, 60, 0.9);
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    border-radius: 20px;
    padding: 20px 36px;
    border-width: 0;
    margin-top: 15px;
    flex-shrink: 0;
    transition: background-color 0.2s;
}

.danger-button:hover {
    background-color: rgba(192, 57, 43, 1);
}

/* Super Nav & Footer */
.bottom-nav-container {
    position: absolute;
    bottom: 40px;
    left: 30px;
    right: 30px;
    background-color: rgba(14, 38, 74, 0.95); /* Deep rich blue for better contrast */
    border-color: rgba(56, 189, 248, 0.5);
    border-width: 2px;
    border-radius: 36px;
    flex-direction: column;
    padding: 30px 24px; 
}

.nav-bar-row {
    flex-direction: row;
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 12px;
    width: 100%;
    flex-wrap: nowrap;
    overflow: hidden;
}

.nav-button {
    background-color: transparent;
    color: #94A3B8;
    border-width: 0;
    font-size: 28px; 
    -unity-font-style: bold;
    white-space: normal; 
    -unity-text-align: middle-center;
    flex-grow: 1;
    flex-shrink: 1; 
    margin: 0;
    padding: 5px;
    transition: color 0.2s;
}

.nav-button:hover {
    color: #38BDF8;
}

.advance-week-btn {
    background-color: #2ECC71;
    color: white;
    border-radius: 45px; /* Perfect pill */
    height: 120px;
    width: 280px; 
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    flex-shrink: 0;
    margin-left: 10px;
    margin-right: 10px;
    transition: background-color 0.2s, scale 0.1s;
}

.advance-week-btn:hover {
    background-color: #27AE60;
    scale: 1.05;
}

.footer-stats-row {
    flex-direction: row;
    justify-content: space-between;
}

.footer-stat {
    flex-direction: column;
    width: 30%;
}

/* Globally Hide Scrollbars for Mobile Swiping */
.unity-scroller--vertical, .unity-scroller--horizontal {
    opacity: 0;
    width: 0;
}

.footer-label, .footer-val {
    font-size: 30px;
    color: #FFFFFF;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* NEW CAREER UI CLASSES */
.badge {
    border-radius: 8px;
    padding: 4px 12px;
    -unity-font-style: bold;
    font-size: 28px;
    margin-right: 15px;
    -unity-text-align: middle-center;
}

.badge-blue {
    background-color: rgba(30, 58, 138, 0.9);
    color: #38BDF8;
}

.badge-orange {
    background-color: rgba(62, 39, 35, 0.9);
    color: #E67E22;
}

.task-card {
    background-color: rgba(15, 23, 42, 0.85); /* Dark surface */
    border-color: rgba(255, 255, 255, 0.2); 
    border-width: 1px;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.btn-do-task-green {
    background-color: #2ECC71;
    color: white;
    -unity-font-style: bold;
    font-size: 28px;
    border-radius: 12px;
    padding: 15px 30px;
    border-width: 0;
    transition: background-color 0.2s;
}

.btn-do-task-green:hover {
    background-color: #27AE60;
}

.btn-do-task-blue {
    background-color: #0284C7;
    color: white;
    -unity-font-style: bold;
    font-size: 28px;
    border-radius: 12px;
    padding: 15px 30px;
    border-width: 0;
    transition: background-color 0.2s;
}

.btn-do-task-blue:hover {
    background-color: #026AA7;
}

/* POPUP STYLING */
.popup-card {
    background-color: rgba(26, 36, 54, 0.98);
    border-color: #38BDF8;
    border-width: 3px;
    border-radius: 30px;
    padding: 50px;
    width: 85%;
    align-items: center;
}

.popup-button {
    background-color: #38BDF8;
    color: #0A1128;
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 20px;
    padding: 25px 40px;
    border-width: 0;
    margin-top: 30px;
    width: 100%;
    transition: background-color 0.2s, scale 0.1s;
}

.popup-button:hover {
    background-color: #0284C7;
    color: white;
    scale: 1.05;
}

.memory-card {
    width: 140px;
    height: 140px;
    margin: 10px;
    background-color: #1E293B;
    border-color: #475569;
    border-width: 4px;
    border-radius: 15px;
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    white-space: normal;
}
.memory-card:hover {
    background-color: #334155;
    border-color: #38BDF8;
}
.memory-card-matched {
    width: 140px;
    height: 140px;
    margin: 10px;
    border-width: 4px;
    border-radius: 15px;
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

/* === NEW MINIGAME STYLES === */

.grid-cell {
    width: 110px;
    height: 110px;
    margin: 4px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #475569;
    border-radius: 8px;
    font-size: 28px;
    -unity-font-style: bold;
    color: #94A3B8;
    -unity-text-align: middle-center;
}

.grid-cell-player {
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

.grid-cell-danger {
    background-color: #7F1D1D;
    border-color: #E74C3C;
    color: #FCA5A5;
}

.grid-cell-goal {
    background-color: #713F12;
    border-color: #F1C40F;
    color: #FDE68A;
}

.whack-cell {
    width: 170px;
    height: 170px;
    margin: 8px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #475569;
    border-radius: 12px;
    font-size: 50px;
    -unity-text-align: middle-center;
}

.whack-cell-active {
    background-color: #14532D;
    border-color: #2ECC71;
}

.whack-cell-decoy {
    background-color: #7F1D1D;
    border-color: #E74C3C;
}

.code-slot {
    width: 100px;
    height: 100px;
    margin: 6px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #38BDF8;
    border-radius: 10px;
    font-size: 36px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.code-symbol-btn {
    width: 80px;
    height: 80px;
    margin: 5px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.code-feedback-correct {
    color: #2ECC71;
}

.code-feedback-misplaced {
    color: #F1C40F;
}

.code-feedback-wrong {
    color: #475569;
}

.order-item {
    min-width: 140px;
    height: 80px;
    margin: 6px;
    padding: 10px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.order-item-selected {
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

.order-item-preview {
    background-color: #1E3A5F;
    border-color: #38BDF8;
    color: #38BDF8;
}

.drag-item {
    padding: 15px;
    margin-bottom: 8px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.drag-item-selected {
    border-color: #38BDF8;
    background-color: #1E3A5F;
}

.drag-item-matched {
    border-color: #2ECC71;
    background-color: #14532D;
    color: #4ADE80;
}
