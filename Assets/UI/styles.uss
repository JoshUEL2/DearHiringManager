:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-SemiBold FontAsset.asset");
}

/* Base Screen Background */
.screen-container {
    flex-grow: 1;
    background-color: #0A1128; /* Deep dark blue */
    padding: 20px; 
    padding-bottom: 160px; /* Room for bottom nav */
    align-items: stretch;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-SemiBold FontAsset.asset");
}

/* Typography */
.header-text {
    font-size: 50px; 
    -unity-font-style: bold;
    color: #38BDF8; 
    margin-bottom: 12px;
    white-space: normal;
}

.sub-text {
    font-size: 32px; 
    color: #94A3B8;
    margin-bottom: 15px;
    white-space: normal;
}

/* UI Elements */
.card {
    width: 100%;
}

.top-card {
    background-color: rgba(43, 27, 21, 0.85); /* Glassmorphic dark brown */
    border-color: rgba(92, 58, 33, 0.5);
    border-width: 1px;
    border-radius: 20px;
    padding: 20px; 
    margin-bottom: 20px;
    flex-shrink: 0;
}

.action-button {
    background-color: rgba(56, 189, 248, 0.9); /* Sleek translucent blue */
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 20px;
    padding: 30px; 
    width: 100%;
    border-width: 0;
    transition: background-color 0.2s ease-in-out;
}

.action-button:hover {
    background-color: #0284C7;
}

/* Layout Helpers */
.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.column {
    flex-direction: column;
}

/* Dashboard Specifics */
.stat-col {
    flex-direction: column;
    width: 48%;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
}

.mini-label {
    font-size: 28px;
    color: #94A3B8;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat-value {
    font-size: 32px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

/* Job Board & General Light Cards */
.job-card, .career-card {
    background-color: rgba(26, 36, 54, 0.85); /* Glassmorphism */
    border-color: rgba(255, 255, 255, 0.1); 
    border-width: 2px;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 30px;
    min-height: 200px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

.job-title {
    font-size: 40px; 
    -unity-font-style: bold;
    color: #38BDF8; 
    white-space: normal;
    margin-bottom: 8px;
}

.job-desc {
    font-size: 32px;
    color: #94A3B8;
    white-space: normal;
    margin-bottom: 5px;
}

.career-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 8px;
}

.card-btn, .apply-button {
    background-color: rgba(76, 175, 80, 0.9);
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    border-radius: 20px;
    padding: 20px 36px;
    border-width: 0;
    margin-top: 15px;
    flex-shrink: 0;
    transition: background-color 0.2s;
}

.card-btn:hover, .apply-button:hover {
    background-color: rgba(69, 160, 73, 1);
}

.job-salary {
    font-size: 32px;
    -unity-font-style: bold;
    color: #E74C3C;
}

/* Hustles (Danger/Illegal Actions) */
.progress-track {
    background-color: #334155;
    height: 4px; 
    width: 100%;
    margin-top: 5px;
    border-radius: 2px;
}
.progress-fill {
    height: 100%;
    border-radius: 2px;
}

.danger-card {
    background-color: rgba(26, 36, 54, 0.85);
    border-color: rgba(231, 76, 60, 0.3);
    border-width: 2px;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 30px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

.danger-text {
    font-size: 40px;
    -unity-font-style: bold;
    color: #E74C3C;
    white-space: normal;
    margin-bottom: 8px;
}

.danger-button {
    background-color: rgba(231, 76, 60, 0.9);
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    border-radius: 20px;
    padding: 20px 36px;
    border-width: 0;
    margin-top: 15px;
    flex-shrink: 0;
    transition: background-color 0.2s;
}

.danger-button:hover {
    background-color: rgba(192, 57, 43, 1);
}

/* Super Nav & Footer */
.bottom-nav-blur-shield {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 420px;
    background-color: transparent;
    border-top-width: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-size: 100% 100%;
    transition: translate 0.4s ease-in-out, opacity 0.4s ease-in-out;
    translate: 0 0;
    opacity: 1;
}

.bottom-nav-blur-shield.bottom-nav-hidden {
    translate: 0 1500px;
    opacity: 0;
}

.bottom-nav-container {
    position: absolute;
    bottom: 40px;
    left: 30px;
    right: 30px;
    background-color: rgba(12, 22, 46, 0.98); /* Deep rich opaque cyber blue */
    border-color: rgba(56, 189, 248, 0.6);
    border-width: 2px;
    border-radius: 36px;
    flex-direction: column;
    padding: 24px 18px; 
}

.nav-bar-row {
    flex-direction: row;
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 12px;
    width: 100%;
    flex-wrap: nowrap;
    overflow: hidden;
}

.nav-button {
    background-color: transparent;
    border-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1; 
    margin: 0;
    padding: 4px 2px;
    transition: scale 0.15s ease-out;
}

.nav-button:hover {
    scale: 1.06;
}

.nav-button-icon {
    font-size: 42px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.nav-button-label {
    font-size: 22px;
    color: #94A3B8;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition: color 0.2s;
}

.nav-button:hover .nav-button-label {
    color: #38BDF8;
}

.advance-week-btn {
    background-color: #2ECC71;
    border-radius: 40px; /* Perfect pill */
    height: 98px;
    width: 220px; 
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-width: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    padding: 6px 12px;
    transition: background-color 0.2s, scale 0.1s;
}

.advance-week-btn:hover {
    background-color: #27AE60;
    scale: 1.05;
}

.advance-week-icon {
    font-size: 30px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.advance-week-label {
    font-size: 34px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.footer-stats-row {
    flex-direction: row;
    justify-content: space-between;
}

.footer-stat {
    flex-direction: column;
    width: 30%;
}

/* Globally Hide Scrollbars for Mobile Swiping */
.unity-scroller--vertical, .unity-scroller--horizontal {
    opacity: 0;
    width: 0;
}

.footer-label, .footer-val {
    font-size: 30px;
    color: #FFFFFF;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* NEW CAREER UI CLASSES */
.badge {
    border-radius: 8px;
    padding: 4px 12px;
    -unity-font-style: bold;
    font-size: 28px;
    margin-right: 15px;
    -unity-text-align: middle-center;
}

.badge-blue {
    background-color: rgba(30, 58, 138, 0.9);
    color: #38BDF8;
}

.badge-orange {
    background-color: rgba(62, 39, 35, 0.9);
    color: #E67E22;
}

.task-card {
    background-color: rgba(15, 23, 42, 0.85); /* Dark surface */
    border-color: rgba(255, 255, 255, 0.2); 
    border-width: 1px;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.btn-do-task-green {
    background-color: #2ECC71;
    color: white;
    -unity-font-style: bold;
    font-size: 28px;
    border-radius: 12px;
    padding: 15px 30px;
    border-width: 0;
    transition: background-color 0.2s;
}

.btn-do-task-green:hover {
    background-color: #27AE60;
}

.btn-do-task-blue {
    background-color: #0284C7;
    color: white;
    -unity-font-style: bold;
    font-size: 28px;
    border-radius: 12px;
    padding: 15px 30px;
    border-width: 0;
    transition: background-color 0.2s;
}

.btn-do-task-blue:hover {
    background-color: #026AA7;
}

/* POPUP STYLING */
.popup-card {
    background-color: rgba(26, 36, 54, 0.98);
    border-color: #38BDF8;
    border-width: 3px;
    border-radius: 30px;
    padding: 50px;
    width: 85%;
    align-items: center;
}

.popup-button {
    background-color: #38BDF8;
    color: #0A1128;
    -unity-font-style: bold;
    font-size: 36px;
    border-radius: 20px;
    padding: 25px 40px;
    border-width: 0;
    margin-top: 30px;
    width: 100%;
    transition: background-color 0.2s, scale 0.1s;
}

.popup-button:hover {
    background-color: #0284C7;
    color: white;
    scale: 1.05;
}

.memory-card {
    width: 140px;
    height: 140px;
    margin: 10px;
    background-color: #1E293B;
    border-color: #475569;
    border-width: 4px;
    border-radius: 15px;
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    white-space: normal;
}
.memory-card:hover {
    background-color: #334155;
    border-color: #38BDF8;
}
.memory-card-matched {
    width: 140px;
    height: 140px;
    margin: 10px;
    border-width: 4px;
    border-radius: 15px;
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

/* === NEW MINIGAME STYLES === */

.grid-cell {
    width: 110px;
    height: 110px;
    margin: 4px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #475569;
    border-radius: 8px;
    font-size: 28px;
    -unity-font-style: bold;
    color: #94A3B8;
    -unity-text-align: middle-center;
}

.grid-cell-player {
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

.grid-cell-danger {
    background-color: #7F1D1D;
    border-color: #E74C3C;
    color: #FCA5A5;
}

.grid-cell-goal {
    background-color: #713F12;
    border-color: #F1C40F;
    color: #FDE68A;
}

.whack-cell {
    width: 170px;
    height: 170px;
    margin: 8px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #475569;
    border-radius: 12px;
    font-size: 50px;
    -unity-text-align: middle-center;
}

.whack-cell-active {
    background-color: #14532D;
    border-color: #2ECC71;
}

.whack-cell-decoy {
    background-color: #7F1D1D;
    border-color: #E74C3C;
}

.code-slot {
    width: 100px;
    height: 100px;
    margin: 6px;
    background-color: #1E293B;
    border-width: 3px;
    border-color: #38BDF8;
    border-radius: 10px;
    font-size: 36px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.code-symbol-btn {
    width: 80px;
    height: 80px;
    margin: 5px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.code-feedback-correct {
    color: #2ECC71;
}

.code-feedback-misplaced {
    color: #F1C40F;
}

.code-feedback-wrong {
    color: #475569;
}

.order-item {
    min-width: 140px;
    height: 80px;
    margin: 6px;
    padding: 10px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.order-item-selected {
    background-color: #14532D;
    border-color: #2ECC71;
    color: #4ADE80;
}

.order-item-preview {
    background-color: #1E3A5F;
    border-color: #38BDF8;
    color: #38BDF8;
}

.drag-item {
    padding: 15px;
    margin-bottom: 8px;
    background-color: #1E293B;
    border-width: 2px;
    border-color: #475569;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.drag-item-selected {
    border-color: #38BDF8;
    background-color: #1E3A5F;
}

.drag-item-matched {
    border-color: #2ECC71;
    background-color: #14532D;
    color: #4ADE80;
}

/* Grid Dodge Specific Styles */
.grid-dodge-hud {
    flex-direction: row; justify-content: center; width: 360px; margin-bottom: 20px; 
    background-color: rgba(26, 36, 54, 0.9); padding: 12px; border-radius: 20px;
    border-width: 2px; border-color: rgba(56, 189, 248, 0.5);
}
.grid-dodge-health {
    background-color: #E74C3C; padding: 10px 24px; border-radius: 14px; 
    border-bottom-width: 4px; border-color: #C0392B;
}
.grid-dodge-health-text {
    font-size: 26px; color: white; -unity-font-style: bold; margin: 0; padding: 0;
}
.grid-dodge-board {
    width: 380px; height: 380px; background-color: #022C22; border-radius: 20px; 
    border-width: 8px; border-color: #10B981; padding: 4px;
    overflow: hidden; position: relative;
}
.grid-dodge-cell {
    flex-grow: 1; border-width: 2px; border-radius: 12px; margin: 2px;
    transition-property: background-color, border-color, scale; transition-duration: 0.2s;
}
.grid-dodge-cell-safe {
    background-color: #FBBF24; border-color: #F59E0B;
    border-bottom-width: 5px; border-bottom-color: #D97706;
}
.grid-dodge-cell-hazard {
    background-color: #15803D; border-color: #166534;
    border-top-width: 5px; border-top-color: #22C55E;
}
.grid-dodge-cell-goal {
    background-color: #3B82F6; border-color: #2563EB;
    border-bottom-width: 5px; border-bottom-color: #1D4ED8;
}
.grid-dodge-player {
    position: absolute; width: 100%; height: 100%; 
    align-items: center; justify-content: center;
    transition-property: left, top; transition-duration: 0.15s; transition-timing-function: ease-out-bounce;
}
.grid-dodge-player-icon {
    font-size: 40px; -unity-text-align: middle-center;
    background-color: rgba(255,255,255,0.25); border-radius: 50%;
    width: 85%; height: 85%;
}
.grid-dodge-damage-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0; 
    transition-property: background-color; transition-duration: 0.2s;
    border-radius: 12px;
}

/* TicketSwipe Specific Styles */
.ts-hud {
    flex-direction: row; justify-content: space-between; width: 400px; margin-bottom: 20px; 
}
.ts-hud-item {
    padding: 10px 20px; border-radius: 12px; border-width: 2px;
}
.ts-hud-score {
    background-color: #1E3A8A; border-color: #3B82F6;
}
.ts-hud-time {
    background-color: #7F1D1D; border-color: #EF4444;
}
.ts-hud-text {
    font-size: 24px; color: white; -unity-font-style: bold; margin: 0; padding: 0;
}
.ts-card-stack {
    width: 400px; height: 260px; position: relative; margin-bottom: 30px;
    align-items: center; justify-content: center;
}
.ts-card {
    position: absolute; width: 100%; height: 100%; left: 0; top: 0;
    background-color: #F8FAFC; border-radius: 16px; border-width: 3px; border-color: #CBD5E1;
    padding: 24px; align-items: center; justify-content: center;
    transition-property: translate, scale, opacity, background-color, border-color; 
    transition-duration: 0.3s; transition-timing-function: ease-out;
}
.ts-card-text {
    font-size: 28px; color: #0F172A; -unity-font-style: bold; white-space: normal; 
    -unity-text-align: middle-center;
}

.ts-btn:hover {
    scale: 1.05;
}
.ts-btn-spam {
    background-color: #B91C1C; border-color: #F87171;
}
.ts-btn-spam:hover { background-color: #DC2626; }
.ts-btn-resolve {
    background-color: #15803D; border-color: #4ADE80;
}
.ts-btn-resolve:hover { background-color: #16A34A; }
.ts-btn-escalate {
    background-color: #B45309; border-color: #FBBF24;
}
.ts-btn-escalate:hover { background-color: #D97706; }

/* TicketSwipe Post-It and Fixes */
.ts-btn-row {
    flex-direction: row; justify-content: space-between; width: 400px;
}
.ts-btn {
    width: 32%; height: 70px; margin: 0; border-radius: 12px; border-width: 2px;
    font-size: 18px; -unity-font-style: bold; color: white; white-space: normal;
    transition-property: scale, background-color; transition-duration: 0.1s;
}

.ts-card-mock {
    position: absolute; width: 100%; height: 100%;
    background-color: #E2E8F0; border-radius: 16px; border-width: 2px; border-color: #CBD5E1;
}
.ts-card-mock-1 { top: -6px; left: -6px; opacity: 0.8; }
.ts-card-mock-2 { top: -12px; left: -12px; opacity: 0.6; }
.ts-card-mock-3 { top: -18px; left: -18px; opacity: 0.4; }

.ts-post-it {
    width: 260px; background-color: #FEF08A; border-radius: 4px; padding: 15px;
    border-bottom-width: 4px; border-right-width: 4px; border-color: #CA8A04;
    transform-origin: center; rotate: 2deg;
}
.ts-post-it-title {
    font-size: 24px; -unity-font-style: bold; color: #854D0E; 
    -unity-text-align: middle-center; margin-bottom: 15px;
    border-bottom-width: 2px; border-color: #A16207; padding-bottom: 5px;
}
.ts-post-it-header {
    font-size: 18px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 2px;
}
.ts-post-it-desc {
    font-size: 16px; color: #422006; white-space: normal; margin-bottom: 10px;
}


/* =========================================
   CONSTRUCTION SITE: THERMAL SCANNER
========================================= */
.cs-main {
    flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%;
}
.cs-hud {
    flex-direction: row; justify-content: space-between; align-items: center;
    width: 700px; margin-bottom: 20px;
}
.cs-hud-title {
    font-size: 16px; -unity-font-style: bold; color: #E2E8F0;
}
.cs-hud-time {
    font-size: 28px; -unity-font-style: bold; color: #F87171;
}

.cs-wall {
    width: 700px; height: 400px; background-color: #64748B; border-radius: 12px;
    border-width: 4px; border-color: #334155; position: relative; overflow: hidden;
}

/* The Scanner Viewport */
.cs-scanner {
    width: 220px; height: 220px; position: absolute; left: 0; top: 0;
    border-radius: 110px; overflow: hidden; border-width: 4px; border-color: #38BDF8;
    background-color: #0F172A; /* Base color for thermal view */
}

/* The Thermal Layer (Inverse Translates) */
.cs-thermal-layer {
    width: 700px; height: 400px; position: absolute; left: 0; top: 0;
    background-color: #1E1B4B; /* Deep purple/blue cold thermal background */
}

/* The Hotspot */
.cs-hotspot {
    position: absolute;
    width: 30px;
    height: 30px;
    background-color: rgba(239, 68, 68, 0.4);
    border-radius: 15px;
    align-items: center;
    justify-content: center;
    transition: opacity 0.1s, scale 0.1s;
}
.cs-hotspot-core {
    width: 12px;
    height: 12px;
    background-color: rgba(239, 68, 68, 0.9);
    border-radius: 6px;
}

/* Scanner Overlays */
.cs-scanner-glass {
    position: absolute; width: 100%; height: 100%; left: 0; top: 0;
    align-items: center; justify-content: center;
    /* Optional scanlines effect using transparent border or background */
}
.cs-reticle {
    width: 30px; height: 30px; border-width: 2px; border-color: #38BDF8;
    border-radius: 15px; position: absolute;
}
.cs-progress-bar {
    position: absolute; bottom: 30px; width: 120px; height: 12px;
    background-color: rgba(0,0,0,0.5); border-radius: 6px; border-width: 1px; border-color: #0EA5E9;
    overflow: hidden;
}
.cs-progress-fill {
    height: 100%; width: 0%; background-color: #38BDF8;
}
.cs-status-text {
    position: absolute; bottom: 10px; font-size: 14px; color: #38BDF8; -unity-font-style: bold;
}

.cs-radar-sweep {
    position: absolute;
    width: 110px;
    height: 110px;
    top: 110px;
    left: 110px;
    background-color: rgba(56, 189, 248, 0.4);
    border-bottom-right-radius: 110px;
    transform-origin: 0% 0%;
}

/* ======================================================== */

/* QA Triage: Bureaucratic Bug Stamping */

.qa-main {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 500px;
}

.qa-desk {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #3b2818;
    flex-direction: column;
}

.qa-hud {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: rgba(0,0,0,0.5);
    height: 60px;
}

.qa-hud-score { font-size: 24px; -unity-font-style: bold; color: #34D399; }
.qa-hud-time { font-size: 24px; -unity-font-style: bold; color: #F87171; }

.qa-folders-area {
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-start;
    padding-top: 20px;
    height: 200px;
}

.qa-folder {
    width: 180px;
    height: 120px;
    border-radius: 8px;
    border-bottom-width: 10px;
    align-items: center;
    justify-content: center;
}

.qa-folder-ui { background-color: #1D4ED8; border-color: #1E3A8A; }
.qa-folder-network { background-color: #B91C1C; border-color: #7F1D1D; }
.qa-folder-logic { background-color: #047857; border-color: #064E3B; }

.qa-folder-label {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
}

.qa-folder-hover {
    scale: 1.1 1.1;
    transition: scale 0.1s;
}

.qa-paper-area {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 20px;
}

.qa-paper-drag {
    transition: scale 0.15s ease-out;
    width: 400px;
    height: 220px;
    background-color: #FDFBF7;
    border-radius: 4px;
    border-width: 2px;
    border-color: #D4D4D8;
    padding: 20px;
    align-items: center;
    position: absolute;
    bottom: 20px;
}

.qa-paper-header {
    font-size: 24px;
    -unity-font-style: bold;
    color: #3F3F46;
    border-bottom-width: 2px;
    border-bottom-color: #E4E4E7;
    padding-bottom: 5px;
    margin-bottom: 15px;
}

.qa-paper-log {
    font-size: 22px;
    color: #18181B;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
}

.qa-paper-hovering-folder {
    scale: 0.5 0.5;
    opacity: 0.7;
}

/* Git Merge Resolution */

.gm-main {
    flex-grow: 1;
    width: 100%;
    min-width: 600px;
    height: 100%;
    min-height: 500px;
    background-color: #1E1E1E;
    flex-direction: column;
}

.gm-hud {
    flex-direction: row;
    justify-content: space-between;
    padding: 15px 25px;
    background-color: #2D2D2D;
    border-bottom-width: 2px;
    border-bottom-color: #3C3C3C;
}

.gm-hud-score { font-size: 24px; -unity-font-style: bold; color: #4ADE80; }
.gm-hud-time { font-size: 24px; -unity-font-style: bold; color: #F87171; }

.gm-objective-box {
    padding: 15px 25px;
    background-color: #252526;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
}

.gm-objective-title { font-size: 20px; color: #A1A1AA; margin-right: 15px; }
.gm-objective-value { font-size: 24px; -unity-font-style: bold; color: #E4E4E7; }

.gm-editor-window {
    height: 400px;
    margin: 20px;
    background-color: #1E1E1E;
    border-width: 2px;
    border-color: #3C3C3C;
    border-radius: 8px;
    overflow: hidden;
}

.gm-editor-header {
    background-color: #2D2D2D;
    padding: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #111111;
}

.gm-editor-tab {
    font-size: 18px;
    color: #E4E4E7;
    background-color: #1E1E1E;
    padding: 5px 15px;
    align-self: flex-start;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.gm-conflict-area {
    flex-grow: 1;
    padding: 20px;
    justify-content: center;
    translate: 0 1500px;
    opacity: 0;
    transition: translate 0.3s ease-out-back, opacity 0.2s;
}

.gm-slide-in {
    translate: 0 0;
    opacity: 1;
}

.gm-block-btn {
    background-color: #252526;
    border-width: 2px;
    border-radius: 6px;
    padding: 15px;
    margin: 10px 0px;
    transition: scale 0.1s, background-color 0.2s, border-color 0.2s, translate 0.05s;
}

.gm-block-btn:hover {
    scale: 1.02 1.02;
}

.gm-block-btn:active {
    scale: 0.98 0.98;
}

.gm-block-current {
    border-color: #059669;
    background-color: rgba(5, 150, 105, 0.1);
}

.gm-block-current:hover { background-color: rgba(5, 150, 105, 0.2); }

.gm-block-incoming {
    border-color: #2563EB;
    background-color: rgba(37, 99, 235, 0.1);
}

.gm-block-incoming:hover { background-color: rgba(37, 99, 235, 0.2); }

.gm-block-merged {
    border-color: #9333EA;
    background-color: rgba(147, 51, 234, 0.3);
}

.gm-block-header {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.gm-text-green { color: #34D399; }
.gm-text-blue { color: #60A5FA; }

.gm-block-code {
    font-size: 22px;
    color: #E4E4E7;
    -unity-font-style: italic;
    white-space: normal;
}

.gm-separator {
    align-items: center;
    margin: 5px 0px;
}

.gm-separator-text {
    color: #52525B;
    font-size: 20px;
    -unity-font-style: bold;
}

.gm-error-shake {
    translate: 10px 0;
    transition: translate 0.05s;
    background-color: rgba(220, 38, 38, 0.3);
    border-color: #DC2626;
}

/* CSS Minigames Shared Theme */
.css-main {
    flex-grow: 1;
    width: 100%;
    min-width: 600px;
    height: 100%;
    min-height: 500px;
    background-color: #1E1E1E;
    flex-direction: column;
}
.css-hud {
    flex-direction: row;
    justify-content: space-between;
    padding: 15px 25px;
    background-color: #2D2D2D;
    border-bottom-width: 2px;
    border-bottom-color: #3C3C3C;
}
.css-hud-score { font-size: 22px; -unity-font-style: bold; color: #E879F9; }
.css-hud-time { font-size: 22px; -unity-font-style: bold; color: #22D3EE; }

.css-code-box {
    background-color: #0F172A;
    padding: 20px;
    border-bottom-width: 2px;
    border-bottom-color: #1E293B;
}
.css-code-line {
    font-size: 20px;
    color: #94A3B8;
    -unity-font-style: italic;
    margin-bottom: 5px;
}
.css-code-highlight {
    color: #38BDF8;
    -unity-font-style: bold;
}

.css-canvas {
    height: 350px;
    position: relative;
    background-color: #111827;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.css-grid-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    /* background-image removed */
    opacity: 0.1;
    -unity-background-scale-mode: scale-and-crop;
}

.css-btn {
    position: absolute;
    bottom: 30px;
    background-color: #D946EF;
    border-color: #F0ABFC;
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    padding: 15px 40px;
    border-radius: 8px;
    border-width: 2px;
    transition: scale 0.1s;
}
.css-btn:active { scale: 0.95 0.95; }

.css-hint-text {
    position: absolute;
    bottom: 30px;
    color: #94A3B8;
    font-size: 20px;
    -unity-font-style: italic;
}

.css-flash-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: white;
    opacity: 0;
}

/* CenterDiv Specific */
.cd-track {
    width: 80%;
    height: 80px;
    background-color: rgba(255,255,255,0.05);
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(255,255,255,0.1);
    position: relative;
    justify-content: center;
}
.cd-target {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 40px;
    border-width: 3px;
    border-color: #D946EF;
    translate: -50% 0;
}
.cd-moving {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: #22D3EE;
    translate: -50% 0;
}

/* SizeMatch Specific */
.sm-target {
    width: 200px;
    height: 150px;
    border-width: 4px;
    border-color: #D946EF;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
}
.sm-changing {
    width: 200px;
    height: 150px;
    background-color: #FACC15;
    border-radius: 8px;
    scale: 0.2 0.2;
}

/* DragCenter Specific */
.dc-work-area {
    width: 100%;
    height: 100%;
    position: absolute;
}
.dc-icon {
    position: absolute;
    width: 120px;
    height: 80px;
    background-color: #22D3EE;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    translate: -50% -50%;
    border-width: 2px;
    border-color: #A5F3FC;
}
.dc-icon-text {
    font-size: 32px;
    color: #083344;
    -unity-font-style: bold;
}
.dc-crosshair {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}
.dc-crosshair-h {
    position: absolute;
    width: 100%;
    height: 2px;
    background-color: #D946EF;
    top: 50%;
    translate: 0 -50%;
}
.dc-crosshair-v {
    position: absolute;
    width: 2px;
    height: 100%;
    background-color: #D946EF;
    left: 50%;
    translate: -50% 0;
}
.dc-score-area {
    position: absolute;
    top: 30%;
    background-color: #1E293B;
    padding: 15px 30px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #334155;
}
.dc-score-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: #E2E8F0;
}

/* Page Transition Classes */
.bottom-nav-container {
    transition: translate 0.4s ease-in-out, opacity 0.4s ease-in-out;
    translate: 0 0;
    opacity: 1;
}

.bottom-nav-hidden {
    translate: 0 1500px;
    opacity: 0;
}

.section-content-container {
    transition: translate 0.4s ease-in-out, opacity 0.4s ease-in-out;
    translate: 0 0;
    opacity: 1;
}

.section-content-hidden {
    translate: 0 1500px;
    opacity: 0;
}

.dashboard-middle-container {
    transition: translate 0.4s ease-in-out, opacity 0.4s ease-in-out;
    translate: 0 0;
    opacity: 1;
}

.dashboard-middle-hidden {
    translate: 0 1500px;
    opacity: 0;
}

/* --- CAREERS OVERHAUL STYLES --- */

.stunning-card {
    background-color: rgba(30, 41, 59, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 25px;
}

.stunning-card-header {
    font-size: 32px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 20px;
}

.corporate-badge {
    background-color: #38BDF8;
    border-radius: 12px;
    padding: 12px 24px;
    align-self: flex-start;
    margin-bottom: 25px;
}

.corporate-badge-text {
    color: #0F172A;
    font-size: 36px;
    -unity-font-style: bold;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.stat-label {
    font-size: 32px;
    color: #CBD5E1;
}

.stat-value {
    font-size: 32px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.salary-highlight {
    color: #2ECC71;
    font-size: 34px;
    text-shadow: 0 0 12px rgba(46, 204, 113, 0.6);
}

.animated-slider {
    margin-top: 15px;
    margin-bottom: 15px;
}

.animated-slider .unity-base-slider__tracker {
    background-color: #1E293B;
    border-radius: 6px;
    height: 12px;
    border-width: 0;
}

.animated-slider .unity-base-slider__dragger {
    background-color: #38BDF8;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 2px;
    border-color: #FFFFFF;
    margin-top: -9px;
    transition: scale 0.2s ease-in-out;
}

.animated-slider .unity-base-slider__dragger:hover {
    scale: 1.2;
    background-color: #F1C40F;
}

.promo-button {
    background-color: rgba(241, 196, 15, 0.15);
    border-color: #F1C40F;
    border-width: 2px;
    color: #F1C40F;
    font-size: 32px;
    -unity-font-style: bold;
    padding: 20px;
    border-radius: 16px;
    transition: scale 0.2s ease-in-out, background-color 0.2s;
    margin-bottom: 25px;
}

.promo-button:hover {
    scale: 1.02;
    background-color: rgba(241, 196, 15, 0.3);
}

.promo-button:active {
    scale: 0.97;
}

.danger-button-advanced {
    background-color: transparent;
    border-color: #E74C3C;
    border-width: 3px;
    color: #E74C3C;
    font-size: 28px;
    -unity-font-style: bold;
    padding: 20px;
    border-radius: 16px;
    transition: scale 0.2s, background-color 0.2s;
}

.danger-button-advanced:hover {
    background-color: rgba(231, 76, 60, 0.2);
    scale: 1.02;
}

.danger-button-advanced:active {
    scale: 0.98;
    background-color: rgba(231, 76, 60, 0.5);
    color: white;
}

.task-card-stunning {
    background-color: rgba(30, 41, 59, 0.8);
    border-left-width: 6px;
    border-color: #38BDF8;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 15px;
    flex-direction: row;
    align-items: center;
    transition: scale 0.2s, background-color 0.2s;
}

.task-card-stunning:hover {
    scale: 1.02;
    background-color: rgba(56, 189, 248, 0.15);
}

.task-card-stunning.extra {
    border-color: #2ECC71;
}

.task-card-stunning.extra:hover {
    background-color: rgba(46, 204, 113, 0.15);
}

.btn-task-stunning {
    background-color: #38BDF8;
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    padding: 15px 30px;
    border-radius: 12px;
    border-width: 0;
    transition: scale 0.2s;
    margin-left: 20px;
}

.btn-task-stunning:hover {
    scale: 1.05;
}

.btn-task-stunning:active {
    scale: 0.95;
}

.btn-task-stunning.extra {
    background-color: #2ECC71;
}

/* SQUIRCLE CARD STYLE FOR HUSTLES */
.squircle-card {
    border-radius: 40px;
    border-width: 6px;
    border-color: rgba(255, 255, 255, 0.2);
    transition-property: scale, rotate, background-color, border-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}
.squircle-card:hover {
    scale: 1.05;
    rotate: -1.5deg;
}

/* MINIGAME BACKGROUND ANIMATIONS (UI TOOLKIT) */
.anim-pattern-overlay {
    transition-property: opacity, translate;
    transition-duration: 2s;
    opacity: 0.3;
}
.anim-pattern-overlay:hover {
    opacity: 0.6;
}

.anim-bg-bottles { background-color: rgba(30, 80, 130, 0.85); }
.anim-bg-lawn { background-color: rgba(30, 100, 40, 0.85); }
.anim-bg-dogs { background-color: rgba(100, 80, 30, 0.85); }
.anim-bg-racer { background-color: rgba(130, 60, 20, 0.85); }
.anim-bg-forge { background-color: rgba(70, 70, 80, 0.85); }
.anim-bg-briefcase { background-color: rgba(60, 30, 80, 0.85); }
.anim-bg-atm { background-color: rgba(20, 60, 30, 0.85); }
.anim-bg-hack { background-color: rgba(80, 10, 10, 0.85); }

.terminal-card .unity-scroll-view__content-container { flex-grow: 1; justify-content: flex-end; }

/* ============================================================== */
/* THREE-MODE THEME SYSTEM: DEFAULT (LOGO OBSIDIAN), DARK, LIGHT   */
/* ============================================================== */

/* 1. DEFAULT THEME: Logo Obsidian (Darker Dark Mode) */
.theme-default.screen-container, .theme-default .screen-container {
    background-color: #07090E;
    color: #F8FAFC;
}
.theme-default .card, .theme-default .terminal-card {
    background-color: #0E121B;
    border-color: #242E46;
}
.theme-default .top-card-root {
    background-color: #0E121B;
    border-color: rgba(61, 75, 110, 0.6);
}
.theme-default .bottom-nav-container {
    background-color: rgba(14, 18, 27, 0.98);
    border-color: rgba(61, 75, 110, 0.8);
}
.theme-default .header-text, .theme-default #DashboardTitle {
    color: #E2E8F0;
}
.theme-default #DistrictAccentBar {
    background-color: #FF1A46;
}
.theme-default #CashText {
    color: #FFB703;
}
.theme-default #JobText {
    color: #909CBF;
}
.theme-default .sub-text, .theme-default .job-desc, .theme-default .footer-label {
    color: #909CBF;
}
.theme-default .nav-button {
    color: #909CBF;
}
.theme-default .nav-button:hover {
    color: #FFB703;
}
.theme-default .task-card {
    background-color: rgba(14, 18, 27, 0.92);
    border-color: rgba(61, 75, 110, 0.5);
}
.theme-default #SettingsCard, .theme-default #ExpandedHistoryCard, .theme-default .popup-card {
    background-color: #0E121B;
    border-color: #3D4B6E;
}

/* 2. DARK THEME: Cyber Slate / Blue (Standard Dark) */
.theme-dark.screen-container, .theme-dark .screen-container {
    background-color: #0A1128;
    color: #FFFFFF;
}
.theme-dark .card, .theme-dark .terminal-card {
    background-color: #0A1128;
    border-color: #475569;
}
.theme-dark .top-card-root {
    background-color: rgba(10, 17, 40, 0.95);
    border-color: rgba(56, 189, 248, 0.4);
}
.theme-dark .bottom-nav-container {
    background-color: rgba(12, 22, 46, 0.98);
    border-color: rgba(56, 189, 248, 0.6);
}
.theme-dark .header-text, .theme-dark #DashboardTitle {
    color: #38BDF8;
}
.theme-dark #DistrictAccentBar {
    background-color: #38BDF8;
}
.theme-dark #CashText {
    color: #F8FAFC;
}
.theme-dark #JobText {
    color: #38BDF8;
}
.theme-dark .sub-text, .theme-dark .job-desc, .theme-dark .footer-label {
    color: #94A3B8;
}
.theme-dark .nav-button {
    color: #94A3B8;
}
.theme-dark .nav-button:hover {
    color: #38BDF8;
}
.theme-dark .task-card {
    background-color: rgba(15, 23, 42, 0.85);
    border-color: rgba(255, 255, 255, 0.2);
}
.theme-dark #SettingsCard, .theme-dark #ExpandedHistoryCard, .theme-dark .popup-card {
    background-color: #0F172A;
    border-color: #38BDF8;
}

/* 3. LIGHT THEME: Daylight Dossier / Paper */
.theme-light.screen-container, .theme-light .screen-container {
    background-color: #F1F5F9;
    color: #0F172A;
}
.theme-light .card, .theme-light .terminal-card {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
}
.theme-light .top-card-root {
    background-color: #FFFFFF;
    border-color: rgba(2, 132, 199, 0.35);
}
.theme-light .bottom-nav-container {
    background-color: rgba(255, 255, 255, 0.98);
    border-color: rgba(148, 163, 184, 0.8);
}
.theme-light .header-text, .theme-light #DashboardTitle {
    color: #0284C7;
}
.theme-light #LogText {
    color: #0F172A;
}
.theme-light #DistrictAccentBar {
    background-color: #0284C7;
}
.theme-light #CashText {
    color: #0F172A;
}
.theme-light #JobText {
    color: #0284C7;
}
.theme-light #BtnViewCV {
    color: #0F172A;
    border-color: rgba(2, 132, 199, 0.4);
}
.theme-light .sub-text, .theme-light .job-desc, .theme-light .footer-label {
    color: #475569;
}
.theme-light .footer-val {
    color: #0F172A;
}
.theme-light .nav-button {
    color: #334155;
}
.theme-light .nav-button:hover {
    color: #0284C7;
}
.theme-light .nav-button-label {
    color: #334155;
}
.theme-light .task-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
}
.theme-light .job-title, .theme-light .career-title {
    color: #0F172A;
}
.theme-light #SettingsCard, .theme-light #ExpandedHistoryCard, .theme-light .popup-card {
    background-color: #FFFFFF;
    border-color: #0284C7;
}
.theme-light #SettingsCard .unity-label, .theme-light #ExpandedHistoryCard .unity-label {
    color: #0F172A;
}
