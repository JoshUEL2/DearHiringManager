<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="DragCenterContainer" class="css-main" style="display: none;">
        
        <ui:VisualElement class="css-hud">
            <ui:Label name="DcScoreText" text="CENTERED: 0 / 3" class="css-hud-score" />
            <ui:Label name="DcTimeText" text="TIME: 15.0s" class="css-hud-time" />
        </ui:VisualElement>

        <ui:VisualElement class="css-code-box">
            <ui:Label text=".icon {" class="css-code-line" />
            <ui:Label text="    top: 50%;" class="css-code-line css-code-highlight" />
            <ui:Label text="    left: 50%;" class="css-code-line css-code-highlight" />
            <ui:Label text="    transform: translate(-50%, -50%);" class="css-code-line" />
            <ui:Label text="}" class="css-code-line" />
        </ui:VisualElement>

        <ui:VisualElement class="css-canvas">
            
            <ui:VisualElement name="DcWorkArea" class="dc-work-area">
                <ui:VisualElement name="DcTargetCrosshair" class="dc-crosshair">
                    <ui:VisualElement class="dc-crosshair-h" />
                    <ui:VisualElement class="dc-crosshair-v" />
                </ui:VisualElement>
                
                <ui:VisualElement name="DcDraggableIcon" class="dc-icon">
                    <ui:Label text="&lt;div&gt;" class="dc-icon-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="DcScoreArea" class="dc-score-area" style="display:none;">
                <ui:Label name="DcScoreValueText" text="98% MATCH" class="dc-score-text" />
            </ui:VisualElement>

            <ui:Button name="DcConfirmBtn" text="CONFIRM CENTER" class="css-btn" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
