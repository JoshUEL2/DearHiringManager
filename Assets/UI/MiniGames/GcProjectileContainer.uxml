<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="GcProjectileContainer" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;" />

                        <!-- Player Podium -->
                        <ui:VisualElement name="GcPodium" style="position: absolute; bottom: 10px; left: 50%; width: 40px; height: 60px; background-color: #E2E8F0; margin-left: -20px; border-top-left-radius: 5px; border-top-right-radius: 5px;" />
                    </ui:VisualElement>
                    <ui:Label text="DRAG TO DODGE OBJECTIONS" style="font-size: 16px; color: #818CF8; -unity-text-align: middle-center; margin-top: 10px;" />
                </ui:VisualElement>

                <!-- GAME TYPE 39: Frantic Backspace -->
                <ui:VisualElement name="FranticBackspaceContainer" style="display: none; width: 100%; flex-direction: column; background-color: #F3F4F6; padding: 20px; border-radius: 10px; border-width: 2px; border-color: #D1D5DB; margin-bottom: 20px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px; align-items: center;">
                        <ui:Label text="Urgent Message" style="font-size: 20px; color: #374151; -unity-font-style: bold;" />
                        <ui:VisualElement style="background-color: #FEE2E2; padding: 5px 10px; border-radius: 15px;">
                            <ui:Label name="FbTimerText" text="AUTO-SEND: 6.0s" style="font-size: 16px; color: #DC2626; -unity-font-style: bold;" />
                        </ui:VisualElement>
</ui:UXML>