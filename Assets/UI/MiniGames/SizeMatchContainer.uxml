<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="SizeMatchContainer" class="css-main" style="display: none; height: 500px;">
        
        <ui:VisualElement class="css-hud">
            <ui:Label name="SmScoreText" text="MATCHED: 0 / 3" class="css-hud-score" />
            <ui:Label name="SmTimeText" text="TIME: 15.0s" class="css-hud-time" />
        </ui:VisualElement>

        <ui:VisualElement class="css-code-box">
            <ui:Label text=".box {" class="css-code-line" />
            <ui:Label text="    width: 200px;" class="css-code-line css-code-highlight" />
            <ui:Label text="    height: 150px;" class="css-code-line css-code-highlight" />
            <ui:Label text="}" class="css-code-line" />
        </ui:VisualElement>

        <ui:VisualElement class="css-canvas">
            <ui:VisualElement class="css-grid-bg" />
            
            <ui:VisualElement name="SmTargetBox" class="sm-target">
                <ui:VisualElement name="SmChangingBox" class="sm-changing" />
            </ui:VisualElement>
            
            <ui:Label text="TAP TO MATCH SIZE" class="css-hint-text" />
            <ui:VisualElement name="SmFlashOverlay" class="css-flash-overlay" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
