<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="SizeMatchContainer" style="display: none; margin-bottom: 30px; padding: 20px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 10px;">
                        <ui:Label name="SmRoundText" text="Matched: 0/3" style="font-size: 26px; color: #94A3B8; -unity-font-style: bold;" />
                        <ui:Label name="SmTimerText" text="15.0s" style="font-size: 26px; color: #F87171; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- The Browser Window -->
                    <ui:VisualElement name="SmWorkArea" style="background-color: #E2E8F0; width: 100%; height: 350px; border-radius: 10px; margin-bottom: 30px; align-items: center; justify-content: center; position: relative; overflow: hidden; border-width: 4px; border-color: #94A3B8;">
                        <!-- Static target box -->
                        <ui:VisualElement name="SmTargetBox" style="position: absolute; width: 200px; height: 150px; border-width: 6px; border-color: #334155; border-radius: 10px; background-color: rgba(51, 65, 85, 0.2);" />
                        
                        <!-- Pulsating foreground box (Button) -->
                        <ui:Button name="SmBtnChangingBox" text="this" style="position: absolute; width: 50px; height: 50px; background-color: #F59E0B; color: #0F172A; font-size: 24px; -unity-font-style: bold; border-radius: 8px; border-width: 4px; border-color: #D97706; padding: 0; margin: 0; transition: background-color 0.1s;" />
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>