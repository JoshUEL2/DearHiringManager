<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="CenterDivContainer" class="css-main" style="display: none;">
        
        <ui:VisualElement class="css-hud">
            <ui:Label name="CdScoreText" text="CENTERED: 0 / 3" class="css-hud-score" />
            <ui:Label name="CdTimeText" text="TIME: 15.0s" class="css-hud-time" />
        </ui:VisualElement>

        <ui:VisualElement class="css-code-box">
            <ui:Label text=".container {" class="css-code-line" />
            <ui:Label text="    justify-content: center;" class="css-code-line css-code-highlight" />
            <ui:Label text="}" class="css-code-line" />
        </ui:VisualElement>

        <ui:VisualElement class="css-canvas">
            <ui:VisualElement class="css-grid-bg" />
            
            <ui:VisualElement class="cd-track">
                <ui:VisualElement name="CdTargetBox" class="cd-target" />
                <ui:VisualElement name="CdMovingBox" class="cd-moving" />
            </ui:VisualElement>

            <ui:Button name="CdCenterBtn" text="SET POSITION" class="css-btn" />
            <ui:VisualElement name="CdFlashOverlay" class="css-flash-overlay" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
