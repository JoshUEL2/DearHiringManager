<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="IceShatterContainer" style="display: none; width: 100%; min-width: 400px; height: 450px; flex-direction: column; background-color: #0F172A; border-radius: 12px; border-width: 4px; border-color: #38BDF8; margin-bottom: 20px; position: relative; overflow: hidden; box-shadow: inset 0 0 30px rgba(56,189,248,0.3);">
        
        <!-- Frost Overlay: Controls white opacity as you freeze -->
        <ui:VisualElement name="IsFrostOverlay" style="position: absolute; width: 100%; height: 100%; background-color: rgba(255,255,255,0); z-index: 10; align-items: center; justify-content: center;" pointer-events="none" />

        <!-- Header -->
        <ui:VisualElement style="width: 100%; padding: 10px; background-color: rgba(15,23,42,0.8); border-bottom-width: 2px; border-color: #0284C7; align-items: center;">
            <ui:Label text="LUXURY CRYO THERAPY" style="font-size: 24px; color: #BAE6FD; -unity-font-style: bold; letter-spacing: 2px; text-shadow: 0 0 10px rgba(56,189,248,0.8);" />
            <ui:Label name="IsTimerText" text="TIME: 15.0s" style="font-size: 16px; color: #7DD3FC; margin-top: 5px;" />
        </ui:VisualElement>

        <!-- Node Area -->
        <ui:VisualElement name="IsNodeArea" style="flex-grow: 1; position: relative; overflow: hidden;" />

        <!-- Temperature Vitals -->
        <ui:VisualElement style="width: 100%; height: 60px; padding: 10px; background-color: rgba(0,0,0,0.6); border-top-width: 2px; border-color: #0284C7; justify-content: center; align-items: center;">
            <ui:VisualElement style="width: 90%; height: 30px; background-color: #1E293B; border-radius: 15px; border-width: 2px; border-color: #334155; overflow: hidden; position: relative;">
                <ui:VisualElement name="IsTempFill" style="position: absolute; left: 0; top: 0; height: 100%; width: 100%; background-color: #22C55E; transition-property: width, background-color; transition-duration: 0.2s;" />
                <ui:Label text="CORE TEMP" style="position: absolute; width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 16px; color: white; -unity-font-style: bold; text-shadow: 1px 1px 2px rgba(0,0,0,0.8);" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
