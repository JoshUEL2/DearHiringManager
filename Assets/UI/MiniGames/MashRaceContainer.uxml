<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="MashRaceContainer" style="display: none; align-items: stretch; margin-bottom: 30px;">
                    <ui:Label name="PlayerMashLabel" text="YOUR PROGRESS" style="font-size: 24px; color: #2ECC71; -unity-font-style: bold; margin-bottom: 5px;" />
                    <ui:VisualElement style="height: 40px; background-color: #1E293B; border-radius: 10px; border-width: 2px; border-color: #2ECC71; margin-bottom: 15px; overflow: hidden;">
                        <ui:VisualElement name="PlayerProgressBar" style="width: 0%; height: 100%; background-color: #2ECC71; border-radius: 8px;" />
                    </ui:VisualElement>
                    <ui:Label name="OpponentMashLabel" text="OPPONENT" style="font-size: 24px; color: #E74C3C; -unity-font-style: bold; margin-bottom: 5px;" />
                    <ui:VisualElement style="height: 40px; background-color: #1E293B; border-radius: 10px; border-width: 2px; border-color: #E74C3C; margin-bottom: 20px; overflow: hidden;">
                        <ui:VisualElement name="OpponentProgressBar" style="width: 0%; height: 100%; background-color: #E74C3C; border-radius: 8px;" />
                    </ui:VisualElement>
                    <ui:Label name="MashTimerText" text="Time: 8s" style="font-size: 28px; color: #F1C40F; -unity-font-style: bold; margin-bottom: 15px; -unity-text-align: middle-center;" />
                    <ui:Button name="BtnMashTap" text="⚡ MASH!" class="popup-button" style="background-color: #2ECC71; color: white; font-size: 38px; padding: 30px;" />
                </ui:VisualElement>
</ui:UXML>