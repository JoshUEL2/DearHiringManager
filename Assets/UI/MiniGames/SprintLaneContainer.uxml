<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="SprintLaneContainer" style="display: none; align-items: center; margin-bottom: 30px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 10px;">
                        <ui:Label name="SprintDistanceText" text="Distance: 0 / 12" style="font-size: 28px; color: #2ECC71; -unity-font-style: bold;" />
                        <ui:Label name="SprintTimerText" text="" style="font-size: 28px; color: #F1C40F; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <!-- Obstacle indicator -->
                    <ui:VisualElement name="SprintLaneDisplay" style="width: 100%; height: 200px; background-color: #0F172A; border-radius: 10px; border-width: 2px; border-color: #334155; margin-bottom: 15px; align-items: center; justify-content: center;">
                        <ui:Label name="SprintObstacleText" text="⬆ HIGH OBSTACLE" style="font-size: 40px; color: #E74C3C; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <!-- Distance progress bar -->
                    <ui:VisualElement style="width: 100%; height: 20px; background-color: #1E293B; border-radius: 10px; border-width: 2px; border-color: #2ECC71; margin-bottom: 20px; overflow: hidden;">
                        <ui:VisualElement name="SprintProgressBar" style="width: 0%; height: 100%; background-color: #2ECC71; border-radius: 8px;" />
                    </ui:VisualElement>
                    <!-- Jump / Duck buttons -->
                    <ui:VisualElement style="flex-direction: row; justify-content: center;">
                        <ui:Button name="BtnSprintJump" text="⬆ JUMP" class="popup-button" style="width: 280px; margin-right: 20px; background-color: #2ECC71; font-size: 34px;" />
                        <ui:Button name="BtnSprintDuck" text="⬇ DUCK" class="popup-button" style="width: 280px; margin-left: 20px; background-color: #0EA5E9; font-size: 34px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>