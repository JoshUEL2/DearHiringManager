<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="RetroRacerContainer" style="display: none; width: 100%; min-width: 400px; height: 500px; flex-direction: column; background-color: #38BDF8; border-radius: 12px; border-width: 4px; border-color: #1E40AF; margin-bottom: 20px; position: relative; overflow: hidden;">
        
        <!-- UI Overlay -->
        <ui:VisualElement style="position: absolute; top: 15px; width: 100%; flex-direction: row; justify-content: space-between; padding: 0 20px; z-index: 10;">
            <ui:Label name="RrDistanceLabel" text="DISTANCE: 0" style="font-size: 24px; color: white; -unity-font-style: bold; text-shadow: 2px 2px 0 rgba(0,0,0,0.5);" />
            <ui:Label text="TIME: 20" name="RrTimeLabel" style="font-size: 24px; color: #FCD34D; -unity-font-style: bold; text-shadow: 2px 2px 0 rgba(0,0,0,0.5);" />
        </ui:VisualElement>
        
        <!-- Sky & Horizon -->
        <ui:VisualElement style="position: absolute; top: 0; width: 100%; height: 50%; background-color: #38BDF8; overflow: hidden;">
            <ui:Label text="☁️" style="position: absolute; top: 20px; left: 10%; font-size: 60px;" />
            <ui:Label text="☁️" style="position: absolute; top: 40px; right: 20%; font-size: 50px;" />
            <ui:Label text="☀️" style="position: absolute; top: 70px; left: 45%; font-size: 70px;" />
            <ui:VisualElement style="position: absolute; bottom: 0; width: 100%; height: 20px; background-color: #064E3B;" /> <!-- Distant mountains -->
        </ui:VisualElement>
        
        <!-- Ground (Road) -->
        <ui:VisualElement name="RrRoad" style="position: absolute; top: 50%; width: 100%; height: 50%; background-color: #4B5563; overflow: hidden; align-items: center;">
            
            <!-- We will pool 8 Road Lines (Rumble strips) here -->
            <ui:VisualElement name="RrLine0" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine1" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine2" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine3" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine4" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine5" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine6" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine7" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            
            <!-- We will pool 8 Obstacles here -->
            <ui:Label name="RrObs0" text="🚕" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs1" text="🚧" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs2" text="🚕" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs3" text="🛢️" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs4" text="🚕" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs5" text="🚧" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs6" text="🚕" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            <ui:Label name="RrObs7" text="🛢️" style="position: absolute; font-size: 20px; top: 0; -unity-text-align: middle-center;" />
            
            <!-- Player -->
            <ui:Label name="RrPlayer" text="🛵" style="position: absolute; font-size: 80px; bottom: 20px; -unity-text-align: middle-center; text-shadow: 0 10px 0 rgba(0,0,0,0.4);" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
