<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="StealthInjectContainer" style="display: none; margin-bottom: 30px; padding: 20px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 20px;">
                        <ui:Label name="SiStatusText" text="Reviewer distracted..." style="font-size: 26px; color: #94A3B8; -unity-font-style: bold;" />
                        <ui:Label name="SiTimerText" text="15.0s" style="font-size: 26px; color: #F87171; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- The Work Area -->
                    <ui:VisualElement name="SiWorkArea" style="background-color: #0F172A; width: 100%; height: 250px; border-radius: 10px; margin-bottom: 30px; align-items: center; justify-content: center; border-width: 4px; border-color: #334155; transition: background-color 0.2s;">
                        <!-- Reviewer Icon -->
                        <ui:Label name="SiReviewerIcon" text="🙈" style="font-size: 100px; -unity-text-align: middle-center; margin-bottom: 10px;" />
                        <!-- Reviewer State Text -->
                        <ui:Label name="SiReviewerStateText" text="SAFE" style="font-size: 32px; color: #22C55E; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Progress Bar Area -->
                    <ui:VisualElement style="width: 100%; margin-bottom: 20px;">
                        <ui:Label text="INJECTION PROGRESS" style="font-size: 20px; color: #94A3B8; margin-bottom: 5px; -unity-font-style: bold;" />
                        <ui:VisualElement style="width: 100%; height: 30px; background-color: #1E293B; border-radius: 15px; border-width: 2px; border-color: #38BDF8; overflow: hidden;">
                            <ui:VisualElement name="SiProgressBarFill" style="width: 0%; height: 100%; background-color: #38BDF8; border-radius: 12px; transition: width 0.1s;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Inject Button -->
                    <ui:Label name="SiBtnInject" text="[ HOLD TO INJECT ]" class="popup-button" style="-unity-text-align: middle-center; width: 90%; align-self: center; background-color: #F59E0B; color: #0F172A; font-size: 38px; -unity-font-style: bold; border-radius: 20px; padding: 25px; border-width: 4px; border-color: #D97706;" />
                </ui:VisualElement>
</ui:UXML>