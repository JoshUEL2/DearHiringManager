<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="ConstructionSiteContainer" class="cs-main" style="display: none;">
        
        <!-- Top HUD Area -->
        <ui:VisualElement class="cs-hud">
            <ui:VisualElement class="cs-hud-panel">
                <ui:Label name="CsInspectionText" text="INSPECTION: 0.0s / 10.0s" class="cs-hud-text" />
            </ui:VisualElement>
            <ui:VisualElement class="cs-hud-panel">
                <ui:Label name="CsTimeText" text="TIME LEFT: 20.0s" class="cs-hud-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Wind Indicator -->
        <ui:VisualElement class="cs-wind-panel">
            <ui:Label name="CsWindLabel" text="WIND: CALM" class="cs-wind-text" />
            <ui:VisualElement name="CsWindBar" class="cs-wind-bar">
                <ui:VisualElement name="CsWindFill" class="cs-wind-fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The I-Beam Track -->
        <ui:VisualElement class="cs-track-area">
            <!-- Structural I-Beam Background -->
            <ui:VisualElement class="cs-beam">
                <ui:VisualElement class="cs-beam-rivet-row top-rivets" />
                <ui:VisualElement class="cs-beam-rivet-row bottom-rivets" />
            </ui:VisualElement>
            
            <!-- Dynamic Safe Zone -->
            <ui:VisualElement name="CsBalanceZone" class="cs-zone" />
            
            <!-- Player Marker (Inspector Hard Hat) -->
            <ui:VisualElement name="CsPlayerMarker" class="cs-player">
                <ui:Label text="👷" class="cs-player-icon" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Screen Flash for Danger -->
        <ui:VisualElement name="CsDangerFlash" class="cs-danger-flash" />

        <!-- Heavy Machinery Controls -->
        <ui:VisualElement class="cs-controls">
            <ui:Button name="BtnCsLeft" text="⬅️ LEAN LEFT" class="cs-btn cs-btn-left" />
            <ui:Button name="BtnCsRight" text="LEAN RIGHT ➡️" class="cs-btn cs-btn-right" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
