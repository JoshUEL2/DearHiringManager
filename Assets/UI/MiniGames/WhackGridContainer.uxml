<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="WhackGridContainer" style="display: none; align-items: center; margin-bottom: 30px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 15px;">
                        <ui:Label name="WhackScoreText" text="Hits: 0 / 12" style="font-size: 28px; color: #2ECC71; -unity-font-style: bold;" />
                        <ui:Label name="WhackTimerText" text="Time: 15s" style="font-size: 28px; color: #F1C40F; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="WhackGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: center; width: 100%; height: 400px;">
                        <!-- 9 cells generated dynamically -->
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>