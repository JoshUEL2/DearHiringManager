<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="TicketSwipeContainer" style="display: none; align-items: center; margin-bottom: 20px; width: 100%; flex-direction: column;">
        
        <!-- Top HUD -->
        <ui:VisualElement class="ts-hud">
            <ui:VisualElement class="ts-hud-item ts-hud-score">
                <ui:Label name="TsScoreText" text="SCORE: 0 / 10" class="ts-hud-text" />
            </ui:VisualElement>
            <ui:VisualElement class="ts-hud-item ts-hud-time">
                <ui:Label name="TsTimeText" text="TIME: 15.0" class="ts-hud-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Card Stack Area -->
        <ui:VisualElement name="TsCardStack" class="ts-card-stack">
            <!-- Cards will be dynamically injected here via C# -->
        </ui:VisualElement>

        <!-- Action Buttons -->
        <ui:VisualElement class="ts-btn-row">
            <ui:Button name="BtnTsSpam" text="🗑️ SPAM" class="ts-btn ts-btn-spam" />
            <ui:Button name="BtnTsResolve" text="✅ RESOLVE" class="ts-btn ts-btn-resolve" />
            <ui:Button name="BtnTsEscalate" text="⚠️ ESCALATE" class="ts-btn ts-btn-escalate" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
