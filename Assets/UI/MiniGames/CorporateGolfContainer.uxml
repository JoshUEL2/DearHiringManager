<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="CorporateGolfContainer" style="display: none; width: 100%; min-width: 400px; height: 500px; flex-direction: column; background-color: #166534; border-radius: 12px; border-width: 8px; border-color: #064E3B; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; justify-content: flex-start; padding: 10px;">
        
        <!-- Header Info Area -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; padding: 10px; background-color: rgba(0,0,0,0.5); border-radius: 8px; margin-bottom: 10px; z-index: 10;">
            <ui:Label name="CgTimeText" text="TIME: 15.0s" style="font-size: 24px; color: #F87171; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <ui:Label text="DRAG BALL TO AIM. HIT THE SAND TRAP!" style="font-size: 18px; color: white; -unity-font-style: bold; margin-bottom: 5px; text-shadow: 2px 2px 0 rgba(0,0,0,0.5); z-index: 10;" />

        <!-- Play Area -->
        <ui:VisualElement name="CgPlayArea" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; overflow: hidden;">
            
            <!-- The Hole -->
            <ui:VisualElement name="CgHole" style="position: absolute; width: 40px; height: 40px; background-color: #000000; border-radius: 20px; top: 120px; left: 50%; translate: -50% 0;">
                <ui:Label text="⛳" style="position: absolute; top: -30px; left: 10px; font-size: 30px;" />
            </ui:VisualElement>

            <!-- The Sand Trap -->
            <ui:VisualElement name="CgSandTrap" style="position: absolute; width: 120px; height: 80px; background-color: #FCD34D; border-radius: 40px; top: 150px; right: 20px; border-width: 2px; border-color: #D97706;" />

            <!-- The CEO (watching) - moved down to avoid text -->
            <ui:Label name="CgCeo" text="👨‍💼" style="position: absolute; top: 180px; left: 10px; font-size: 50px;" />

            <!-- The Aiming Line (slingshot) with arrowhead -->
            <ui:VisualElement name="CgAimLine" style="position: absolute; width: 8px; height: 0px; background-color: #FDE047; transform-origin: 50% 0%; display: none;">
                <ui:Label text="▼" style="position: absolute; bottom: -18px; left: 50%; translate: -50% 0; font-size: 24px; color: #FDE047;" name="CgAimArrow" />
            </ui:VisualElement>

            <!-- The Ball -->
            <ui:VisualElement name="CgBall" style="position: absolute; width: 24px; height: 24px; background-color: white; border-radius: 12px; bottom: 60px; left: 50%; translate: -50% 0; border-width: 1px; border-color: #D1D5DB; box-shadow: 0 4px 6px rgba(0,0,0,0.3);" />
            
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>