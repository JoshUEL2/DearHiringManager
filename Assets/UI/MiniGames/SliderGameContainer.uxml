<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="SliderGameContainer" style="display: none; align-items: center; margin-bottom: 30px;">
                    <ui:Label name="SliderTargetText" text="Current: 50%" style="font-size: 28px; color: #FFFFFF; -unity-font-style: bold; margin-bottom: 20px;" />
                    <ui:Slider name="GameSlider" low-value="0" high-value="100" value="50" style="width: 100%; margin-bottom: 30px;" />
                    <ui:Button name="BtnSubmitSlider" text="SUBMIT" class="popup-button" style="background-color: #2ECC71; color: white;" />
                </ui:VisualElement>
</ui:UXML>