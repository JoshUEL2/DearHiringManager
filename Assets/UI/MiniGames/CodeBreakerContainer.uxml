<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="CodeBreakerContainer" style="display: none; align-items: center; margin-bottom: 30px;">
                    <ui:Label name="CodeAttemptsText" text="Attempts: 6 remaining" style="font-size: 28px; color: #F1C40F; -unity-font-style: bold; margin-bottom: 15px;" />
                    <!-- Current guess slots -->
                    <ui:VisualElement name="CodeGuessRow" style="flex-direction: row; justify-content: center; margin-bottom: 15px;">
                        <!-- 4 slots generated dynamically -->
                    </ui:VisualElement>
                    <!-- Symbol input buttons -->
                    <ui:VisualElement name="CodeSymbolRow" style="flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 15px;">
                        <!-- Symbol buttons generated dynamically -->
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: column; align-items: center; width: 100%;">
                        <ui:Button name="BtnCodeSubmit" text="GUESS" class="popup-button" style="background-color: #2ECC71; color: white; margin-bottom: 10px; width: 300px;" />
                        <ui:Button name="BtnCodeClear" text="CLEAR" class="popup-button" style="background-color: #E74C3C; color: white; width: 300px;" />
                    </ui:VisualElement>
                    <!-- Guess history -->
                    <ui:VisualElement name="CodeHistoryList" style="width: 80%; margin-top: 20px; padding: 15px; background-color: #1E293B; border-radius: 15px; border-width: 3px; border-color: #334155; align-items: center; min-height: 20px; display: none;">
                        <!-- History rows added dynamically -->
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>