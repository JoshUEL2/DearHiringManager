<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="KanbanContainer" style="display: none; width: 100%; flex-grow: 1; min-height: 500px; flex-direction: row; padding: 10px; padding-top: 50px; background-color: #ECEFF1; position: relative;">
                    <ui:Label name="KanbanTimerText" text="15.0s" style="position: absolute; top: 10px; right: 20px; font-size: 32px; color: #E74C3C; -unity-font-style: bold; z-index: 10;" />
                    
                    <ui:VisualElement style="flex-grow: 1; margin: 5px; background-color: #CFD8DC; border-radius: 8px; padding: 10px;">
                        <ui:Label text="TODO" style="font-size: 20px; color: #455A64; -unity-font-style: bold; margin-bottom: 10px; align-self: center;" />
                        <ui:VisualElement name="KanbanColTodo" style="flex-grow: 1; align-items: center;" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="flex-grow: 1; margin: 5px; background-color: #CFD8DC; border-radius: 8px; padding: 10px;">
                        <ui:Label text="IN PROGRESS" style="font-size: 20px; color: #455A64; -unity-font-style: bold; margin-bottom: 10px; align-self: center;" />
                        <ui:VisualElement name="KanbanColProgress" style="flex-grow: 1; align-items: center;" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="flex-grow: 1; margin: 5px; background-color: #CFD8DC; border-radius: 8px; padding: 10px;">
                        <ui:Label text="DONE" style="font-size: 20px; color: #455A64; -unity-font-style: bold; margin-bottom: 10px; align-self: center;" />
                        <ui:VisualElement name="KanbanColDone" style="flex-grow: 1; align-items: center;" />
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>