<ui:VisualElement name="GridDodgeContainer" style="display: none; align-items: center; margin-bottom: 30px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 10px;">
                        <ui:Label name="GridHealthText" text="❤️ 3" style="font-size: 28px; color: #E74C3C; -unity-font-style: bold;" />
                        <ui:Label name="GridMoveText" text="Moves: 0" style="font-size: 28px; color: #94A3B8; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="GridDodgeGrid" style="flex-direction: column; flex-wrap: nowrap; justify-content: center; width: 100%; height: 400px;">
                        <!-- 25 cells generated dynamically -->
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>