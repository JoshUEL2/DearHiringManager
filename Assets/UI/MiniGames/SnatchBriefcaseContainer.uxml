<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="SnatchBriefcaseContainer" style="display: none; width: 100%; min-width: 400px; height: 500px; flex-direction: column; background-color: #1F2937; border-radius: 10px; border-width: 6px; border-color: #FCD34D; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; justify-content: center; padding: 20px;">
        
        <ui:VisualElement style="flex-grow: 1; width: 100%;" />
        
        <!-- Leather Texture Background -->
        <ui:VisualElement style="position: absolute; width: 100%; height: 100%; opacity: 0.8; background-color: #451A03;" />
        
        <ui:Label text="CRACK THE LOCK!" style="font-size: 28px; color: #FCD34D; -unity-font-style: bold; margin-bottom: 30px;" />
        
        <!-- The 3 Dials -->
        <ui:VisualElement style="flex-direction: row; justify-content: center; width: 100%; margin-bottom: 30px; position: relative;">
            
            <!-- Selection Highlight Box -->
            <ui:VisualElement style="position: absolute; width: 320px; height: 75px; background-color: rgba(255, 255, 255, 0.15); border-color: rgba(255, 255, 255, 0.4); border-top-width: 2px; border-bottom-width: 2px; top: 75px;" />
            
            <!-- Dial 0 -->
            <ui:VisualElement style="width: 80px; height: 225px; background-color: #D4AF37; border-radius: 10px; margin: 0 10px; flex-direction: column; overflow: hidden; border-width: 2px; border-color: #9CA3AF; justify-content: space-between;">
                <ui:Label name="SbDial0_Top" text="0" style="font-size: 45px; color: rgba(0,0,0,0.5); -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                <ui:Label name="SbDial0_Mid" text="1" style="font-size: 55px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                <ui:Label name="SbDial0_Bot" text="2" style="font-size: 45px; color: rgba(0,0,0,0.5); -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
            </ui:VisualElement>

            <!-- Dial 1 -->
            <ui:VisualElement style="width: 80px; height: 225px; background-color: #D4AF37; border-radius: 10px; margin: 0 10px; flex-direction: column; overflow: hidden; border-width: 2px; border-color: #9CA3AF; justify-content: space-between;">
                <ui:Label name="SbDial1_Top" text="0" style="font-size: 45px; color: rgba(0,0,0,0.5); -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                <ui:Label name="SbDial1_Mid" text="1" style="font-size: 55px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                <ui:Label name="SbDial1_Bot" text="2" style="font-size: 45px; color: rgba(0,0,0,0.5); -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
            </ui:VisualElement>

            <!-- Dial 2 -->
            <ui:VisualElement style="width: 80px; height: 225px; background-color: #D4AF37; border-radius: 10px; margin: 0 10px; flex-direction: column; overflow: hidden; border-width: 2px; border-color: #9CA3AF; justify-content: space-between;">
                <ui:Label name="SbDial2_Top" text="0" style="font-size: 45px; color: rgba(0,0,0,0.5); -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                <ui:Label name="SbDial2_Mid" text="1" style="font-size: 55px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                <ui:Label name="SbDial2_Bot" text="2" style="font-size: 45px; color: rgba(0,0,0,0.5); -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
            </ui:VisualElement>

        </ui:VisualElement>
        
        <!-- Sticky Note Target -->
        <ui:VisualElement style="background-color: #FEF08A; padding: 10px 20px; border-radius: 2px; rotate: -3deg; margin-bottom: 20px; border-bottom-width: 3px; border-right-width: 3px; border-color: rgba(0,0,0,0.3);">
            <ui:Label name="SbTargetText" text="TARGET: 7 - 3 - 9" style="font-size: 24px; color: #1E3A8A; -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
        
        <ui:Button name="BtnSbStop" text="STOP DIAL 1" class="popup-button" style="background-color: #EF4444; color: white; font-size: 28px; padding: 15px 40px; border-radius: 15px; -unity-font-style: bold;" />
        
    </ui:VisualElement>
</ui:UXML>