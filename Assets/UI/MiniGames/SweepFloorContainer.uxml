<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="SweepFloorContainer" style="display: none; align-items: center; margin-bottom: 30px; width: 100%;">
                    <ui:VisualElement style="flex-direction: row; justify-content: center; margin-bottom: 15px;">
                        <ui:Label name="SweepFloorStatusText" text="Sweep everywhere!" style="font-size: 28px; color: #94A3B8; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SweepFloorGrid" style="flex-direction: column; flex-wrap: nowrap; justify-content: center; width: 100%; height: 400px; border-width: 4px; border-color: #3E2723;">
                        <!-- 25 cells generated dynamically -->
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>