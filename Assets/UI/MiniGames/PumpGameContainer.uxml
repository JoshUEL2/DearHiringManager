<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="PumpGameContainer" style="display: none; flex-direction: column; align-items: center; margin-bottom: 30px; width: 100%;">
                    <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: center; width: 100%; height: 350px;">
                        <!-- Left: Progress Bar (Normal Mode) -->
                        <ui:VisualElement name="PumpNormalBar" style="height: 100%; width: 60px; background-color: #1E293B; border-radius: 10px; border-width: 3px; border-color: #475569; margin-right: 40px; justify-content: flex-end; overflow: hidden;">
                            <ui:VisualElement name="PumpProgressBar" style="width: 100%; height: 0%; background-color: #2ECC71; border-radius: 6px;" />
                        </ui:VisualElement>
                        
                        <!-- Left: Circular Dial (Balance Mode) -->
                        <ui:VisualElement name="PumpDialContainer" style="display: none; width: 220px; height: 220px; border-radius: 110px; border-width: 8px; border-color: #1E293B; background-color: #0F172A; position: relative; justify-content: center; align-items: center; margin-right: 40px;">
                            <!-- Green Target Zone -->
                            <ui:VisualElement name="PumpDialTargetZone" style="position: absolute; width: 100%; height: 100%; justify-content: flex-start; align-items: center; transform-origin: center;">
                                <ui:VisualElement style="position: absolute; width: 102px; height: 102px; left: 102px; top: 0px; overflow: hidden;">
                                    <ui:VisualElement name="PumpDialTargetArc" style="position: absolute; width: 102px; height: 102px; left: 0px; top: 0px; overflow: hidden; transform-origin: 0% 100%;">
                                        <ui:VisualElement style="position: absolute; width: 204px; height: 204px; left: -102px; top: 0px; border-radius: 102px; border-width: 16px; border-color: #2ECC71;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- The Needle Rotator -->
                            <ui:VisualElement name="PumpDialNeedleRotator" style="position: absolute; width: 100%; height: 100%; justify-content: center; align-items: center; transform-origin: center; rotate: -120deg;">
                                <!-- The needle pointing UP (so rotation 0 points UP) -->
                                <ui:VisualElement style="position: absolute; top: 20px; width: 4px; height: 90px; background-color: #FFFFFF; border-radius: 2px;" />
                            </ui:VisualElement>
                            
                            <!-- Center Pivot Cover -->
                            <ui:VisualElement style="position: absolute; width: 30px; height: 30px; border-radius: 15px; background-color: #E2E8F0; border-width: 4px; border-color: #94A3B8;" />
                            
                            <ui:Label text="OIL TEMP" style="position: absolute; bottom: 30px; font-size: 14px; color: #FFFFFF; -unity-font-style: bold;" />
                        </ui:VisualElement>
                        
                        <!-- Right: Pump Area -->
                        <ui:VisualElement name="PumpTrackArea" style="height: 100%; width: 80px; background-color: #0F172A; border-radius: 40px; border-width: 4px; border-color: #334155; position: relative; align-items: center;">
                            <!-- The Shaft (visual only) -->
                            <ui:VisualElement name="PumpShaft" style="width: 20px; height: 100%; background-color: #94A3B8; position: absolute; top: 20px; z-index: -1;" />
                            <!-- The Handle -->
                            <ui:VisualElement name="PumpHandle" style="position: absolute; top: 0px; width: 100px; height: 40px; background-color: #E74C3C; border-radius: 10px; border-width: 3px; border-color: #C0392B; justify-content: center; align-items: center;">
                                <ui:VisualElement style="width: 60px; height: 10px; background-color: rgba(0,0,0,0.3); border-radius: 5px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <!-- Timer for Temp Gauge -->
                    <ui:VisualElement name="PumpHoldTimerContainer" style="display: none; margin-top: 20px; width: 60%; align-items: center;">
                        <ui:Label text="HOLD TEMP" style="font-size: 20px; color: #94A3B8; margin-bottom: 5px; -unity-font-style: bold;" />
                        <ui:VisualElement style="width: 100%; height: 15px; background-color: #1E293B; border-radius: 7px; border-width: 2px; border-color: #38BDF8; overflow: hidden;">
                            <ui:VisualElement name="PumpHoldTimerBar" style="width: 0%; height: 100%; background-color: #38BDF8; border-radius: 5px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>