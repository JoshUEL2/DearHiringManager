<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="QATriageContainer" class="qa-main" style="display: none;">
        
        <!-- The Wooden Desk Background -->
        <ui:VisualElement class="qa-desk">
            
            <!-- Top HUD -->
            <ui:VisualElement class="qa-hud">
                <ui:Label name="QaScoreText" text="FILED: 0 / 5" class="qa-hud-score" />
                <ui:Label name="QaTimeText" text="TIME: 20.0s" class="qa-hud-time" />
            </ui:VisualElement>

            <!-- Top Area: Folders -->
            <ui:VisualElement class="qa-folders-area">
                <ui:VisualElement name="QaFolder0" class="qa-folder qa-folder-ui">
                    <ui:Label text="UI" class="qa-folder-label" />
                </ui:VisualElement>
                <ui:VisualElement name="QaFolder1" class="qa-folder qa-folder-network">
                    <ui:Label text="NETWORK" class="qa-folder-label" />
                </ui:VisualElement>
                <ui:VisualElement name="QaFolder2" class="qa-folder qa-folder-logic">
                    <ui:Label text="LOGIC" class="qa-folder-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bottom Area: The Paper (Draggable) -->
            <ui:VisualElement name="QaPaperArea" class="qa-paper-area">
                <ui:VisualElement name="QaPaper" class="qa-paper-drag">
                    <ui:Label text="BUG REPORT" class="qa-paper-header" />
                    <ui:Label name="QaBugLog" text="NullReferenceException in Login()" class="qa-paper-log" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
