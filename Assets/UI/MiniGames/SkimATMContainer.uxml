<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="SkimATMContainer" style="display: none; width: 100%; min-width: 400px; height: 500px; flex-direction: column; background-color: #111827; border-radius: 8px; border-width: 12px; border-color: #374151; margin-bottom: 20px; position: relative; overflow: hidden; padding: 0; border-top-width: 25px;">
        
        <!-- CRT Screen Effect (Top) -->
        <ui:VisualElement style="flex-grow: 1; background-color: #064E3B; padding: 20px; justify-content: center; align-items: center; overflow: hidden; border-radius: 15px; border-width: 4px; border-color: #1F2937; margin: 10px;">
            <!-- Scanline overlay effect -->
            <ui:VisualElement style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.1); opacity: 0.5;" />
            
            <ui:Label text="INSERT CARD" style="font-size: 32px; color: #34D399; -unity-font-style: bold; margin-bottom: 5px; text-shadow: 2px 2px 0 rgba(0,0,0,0.5);" />
            <ui:Label text="[ SYSTEM OVERRIDE ]" style="font-size: 16px; color: #EF4444; -unity-font-style: bold; margin-bottom: 15px;" />
            
            <ui:VisualElement style="flex-direction: row; justify-content: space-around; width: 100%; margin-top: 5px; background-color: rgba(0,0,0,0.4); padding: 10px; border-radius: 8px;">
                <ui:Label name="SaTimerText" text="TIME: 10.0s" style="font-size: 24px; color: #F87171; -unity-font-style: bold;" />
                <ui:Label name="SaConnectionText" text="LINKS: 0/4" style="font-size: 24px; color: #6EE7B7; -unity-font-style: bold;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Broken Numpad & Exposed Wires (Bottom) -->
        <ui:VisualElement style="flex-grow: 1.2; background-color: #1F2937; margin: 10px; border-radius: 8px; padding: 10px; position: relative;">
            
            <!-- Broken aesthetics background -->
            <ui:VisualElement style="position: absolute; top: -5px; left: -5px; right: -5px; bottom: -5px; border-width: 2px; border-color: #9CA3AF; border-style: dashed; opacity: 0.3;" />
            <ui:Label text="DANGER: HIGH VOLTAGE" style="position: absolute; bottom: -5px; right: 0; font-size: 12px; color: #FCD34D; -unity-font-style: bold;" />
            
            <!-- Wire drag container (transparent overlay on top of panels) -->
            <ui:VisualElement name="SaWireContainer" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 10;" />

            <!-- Terminals -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; height: 100%; padding: 0 10px;">
                
                <!-- Left Terminals -->
                <ui:VisualElement name="SaLeftPanel" style="height: 100%; justify-content: space-around; width: 60px; background-color: #111827; border-radius: 5px; border-width: 2px; border-color: #4B5563; padding: 5px;" />
                
                <!-- Right Terminals -->
                <ui:VisualElement name="SaRightPanel" style="height: 100%; justify-content: space-around; width: 60px; background-color: #111827; border-radius: 5px; border-width: 2px; border-color: #4B5563; padding: 5px;" />
                
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>