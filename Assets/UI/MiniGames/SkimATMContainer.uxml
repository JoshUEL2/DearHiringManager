<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="SkimATMContainer" style="display: none; width: 100%; min-width: 400px; height: 500px; flex-direction: column; background-color: #374151; border-radius: 15px; border-width: 8px; border-color: #1F2937; margin-bottom: 20px; position: relative; overflow: hidden; padding: 0;">
        
        <!-- Top Screen Section (ATM Screen) -->
        <ui:VisualElement style="flex-grow: 1; background-color: #064E3B; border-bottom-width: 6px; border-color: #1F2937; padding: 20px; justify-content: center; align-items: center; overflow: hidden;">
            <ui:Label text="ATM SYSTEM OVERRIDE" style="font-size: 28px; color: #34D399; -unity-font-style: bold; margin-bottom: 10px; text-shadow: 1px 1px 2px rgba(52, 211, 153, 0.5);" />
            
            <ui:VisualElement style="flex-direction: row; justify-content: space-around; width: 100%; margin-top: 15px;">
                <ui:Label name="SaTimerText" text="TIME: 10.0s" style="font-size: 32px; color: #F87171; -unity-font-style: bold;" />
                <ui:Label name="SaConnectionText" text="LINKS: 0/4" style="font-size: 32px; color: #6EE7B7; -unity-font-style: bold;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Hardware Panel (Exposed wires) -->
        <ui:VisualElement style="flex-grow: 1.5; background-color: #111827; padding: 20px; flex-direction: row; justify-content: space-between; align-items: center; border-top-width: 4px; border-top-color: #4B5563;">
            
            <!-- Left Panel -->
            <ui:VisualElement name="SaLeftPanel" style="height: 100%; justify-content: space-around; background-color: #1F2937; padding: 10px; border-radius: 10px; border-width: 2px; border-color: #374151;">
            </ui:VisualElement>
            
            <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; opacity: 0.5;">
                <ui:Label text="/// HARDWARE BYPASS ///" style="color: #6B7280; -unity-font-style: bold; font-size: 18px;" />
            </ui:VisualElement>

            <!-- Right Panel -->
            <ui:VisualElement name="SaRightPanel" style="height: 100%; justify-content: space-around; background-color: #1F2937; padding: 10px; border-radius: 10px; border-width: 2px; border-color: #374151;">
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>