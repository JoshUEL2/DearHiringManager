<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <ui:Style src="styles.uss" />
    <ui:VisualElement class="screen-container" style="padding-bottom: 0;">

        <!-- TOP CARD -->
        <ui:VisualElement class="card top-card">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                <ui:VisualElement style="flex-direction: column; align-items: flex-start; flex-shrink: 1;">
                    <ui:Label name="PlayerNameText" text="PlayerName" class="header-text" style="color: #F1C40F; font-size: 60px; margin: 0; margin-bottom: 10px; white-space: normal;" />
                    <ui:VisualElement style="background-color: rgba(56, 189, 248, 0.15); border-color: #38BDF8; border-width: 2px; border-radius: 12px; padding: 5px 15px;">
                        <ui:Label name="JobText" text="Unemployed" style="color: #38BDF8; font-size: 28px; -unity-font-style: bold; margin: 0; white-space: normal;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 30px;">
                <ui:Button name="BtnViewCV" text="Current CV" style="background-color: #2ECC71; color: white; padding: 10px 20px; font-size: 28px; border-radius: 8px; border-width: 0; margin: 0; margin-right: 15px;" />
                <ui:Label name="SubTitleText" text="• Week 1" class="sub-text" style="font-size: 32px; color: #FFFFFF; margin: 0;" />
            </ui:VisualElement>
            
            <ui:VisualElement class="row">
                <ui:VisualElement class="stat-col" name="ColCash">
                    <ui:Label text="CASH RESERVE" class="mini-label"/>
                    <ui:Label name="CashText" text="$0" class="stat-value" style="color: #2ECC71;"/>
                </ui:VisualElement>
                
                <ui:VisualElement class="stat-col" name="ColExpenses">
                    <ui:Label text="EXPENSES/WK" class="mini-label"/>
                    <ui:Label name="ExpenseText" text="-$0" class="stat-value" style="color: #E74C3C;"/>
                </ui:VisualElement>
                
                <ui:VisualElement class="stat-col" name="ColDistrict">
                    <ui:Label text="HOME DISTRICT" class="mini-label"/>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label name="DistrictText" text="Slums" class="stat-value" style="color: #F1C40F; margin-right: 15px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="DynamicMiddleWrapper" class="section-content-container section-content-hidden" style="flex-grow: 1; background-color: #0A1128; padding-top: 20px; padding-left: 20px; padding-right: 20px;">
            <!-- DRAG HEADER -->
            <ui:VisualElement name="DragHeader" style="align-items: center; margin-bottom: 20px;">
                <!-- Drag Handle Pill -->
                <ui:VisualElement style="width: 120px; height: 8px; background-color: rgba(255, 255, 255, 0.2); border-radius: 4px; margin-bottom: 20px;" />
                
                <ui:VisualElement style="flex-direction: row; width: 100%; justify-content: space-between; align-items: center;">
                    <ui:Label text="CAREERS PORTAL" class="header-text" style="color: #38BDF8; margin: 0;" />
                    <ui:Button name="BtnCloseMenu" text="✕" style="background-color: transparent; color: #E74C3C; font-size: 50px; -unity-font-style: bold; border-width: 0; padding: 0; margin: 0; cursor: link;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="JobBoardContainer" style="flex-grow: 1; display: flex;">
                <ui:Label text="Available Vacancies in your District:" class="sub-text" style="margin-bottom: 10px;" />
                <ui:ScrollView name="JobScrollView" style="flex-grow: 1;" />
            </ui:VisualElement>

                        <ui:VisualElement name="ActiveJobContainer" style="flex-grow: 1; display: none;">
                <ui:ScrollView name="ActiveJobScrollView" style="flex-grow: 1;">
                    
                    <!-- ID Badge / Dossier -->
                    <ui:VisualElement class="stunning-card" style="margin-bottom: 20px;">
                        <ui:VisualElement class="corporate-badge">
                            <ui:Label name="JobTitleText" text="Level 1 Job" class="corporate-badge-text" />
                        </ui:VisualElement>
                        
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Base Salary" class="stat-label" />
                            <ui:Label name="BaseSalaryText" text="$0" class="stat-value" />
                        </ui:VisualElement>
                        
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Level Bonus" class="stat-label" />
                            <ui:Label name="PromoBonusText" text="+0%" class="stat-value" style="color: #2ECC71;" />
                        </ui:VisualElement>
                        
                        <ui:VisualElement class="stat-row" style="margin-top: 20px; border-top-width: 1px; border-color: rgba(255,255,255,0.1); padding-top: 20px;">
                            <ui:Label text="WEEKLY INCOME" class="stat-label" style="font-size: 36px; -unity-font-style: bold; color: #FFFFFF;" />
                            <ui:Label name="SalaryText" text="$0" class="salary-highlight" style="font-size: 42px; text-shadow: none;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Performance & Hours -->
                    <ui:VisualElement class="stunning-card" style="margin-bottom: 25px;">
                        <ui:VisualElement class="stat-row" style="margin-bottom: 5px;">
                            <ui:Label text="Performance Rating" class="stat-label" style="font-size: 28px;" />
                            <ui:Label name="PerfVal" text="0%" class="stat-value" style="font-size: 28px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="height: 14px; background-color: rgba(255,255,255,0.05); border-radius: 7px; margin-bottom: 25px;">
                            <ui:VisualElement name="PerfFill" style="height: 100%; width: 0%; background-color: #38BDF8; border-radius: 7px;" />
                        </ui:VisualElement>

                        <ui:VisualElement class="stat-row" style="margin-bottom: 15px;">
                            <ui:Label text="Current Schedule" class="stat-label" style="font-size: 28px;" />
                            <ui:Label name="HoursAlignText" text="40 hrs/wk" class="stat-value" style="color: #38BDF8; font-size: 28px;" />
                            <!-- Hide the old HoursText since it's redundant but kept for C# binding -->
                            <ui:Label name="HoursText" text="" style="display: none;" />
                        </ui:VisualElement>

                        <ui:VisualElement class="row" style="margin-top: 10px;">
                            <ui:Button name="BtnRequestLessHours" text="Request -5 Hrs" class="btn-task-stunning" style="flex-grow: 1; margin-left: 0; margin-right: 8px; font-size: 24px; background-color: rgba(231, 76, 60, 0.2); border-width: 2px; border-color: #E74C3C; color: #E74C3C; padding: 15px;" />
                            <ui:Button name="BtnRequestMoreHours" text="Request +5 Hrs" class="btn-task-stunning" style="flex-grow: 1; margin-left: 8px; font-size: 24px; background-color: rgba(46, 204, 113, 0.2); border-width: 2px; border-color: #2ECC71; color: #2ECC71; padding: 15px;" />
                        </ui:VisualElement>
                        
                        <ui:Label text="Caution: Repeated schedule modifications may trigger involuntary termination." style="font-size: 20px; color: #F87171; margin-top: 20px; white-space: normal; -unity-text-align: middle-center;" />
                    </ui:VisualElement>

                    <!-- Promotion -->
                    <ui:Button name="BtnPromotion" text="Request Promotion" class="promo-button" />

                    <!-- Tasks -->
                    <ui:VisualElement style="margin-top: 15px;">
                        <ui:VisualElement class="row" style="align-items: center; margin-bottom: 15px; margin-left: 10px;">
                            <ui:Label text="Core Duties" style="font-size: 32px; -unity-font-style: bold; color: #FFFFFF;" />
                            <ui:Label name="regularTasksStatus" text="PENDING" style="font-size: 24px; -unity-font-style: bold; margin-left: 15px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="regularTasksContainer" />
                    </ui:VisualElement>

                    <ui:VisualElement style="margin-top: 25px;">
                        <ui:VisualElement class="row" style="align-items: center; margin-bottom: 15px; margin-left: 10px;">
                            <ui:Label text="Overtime (Optional)" style="font-size: 32px; -unity-font-style: bold; color: #2ECC71;" />
                            <ui:Label name="extraTasksStatus" text="AVAILABLE" style="font-size: 24px; -unity-font-style: bold; margin-left: 15px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="extraTasksContainer" />
                    </ui:VisualElement>

                    <!-- Resign -->
                    <ui:Button name="BtnQuitJob" text="QUIT JOB" class="danger-button-advanced" style="margin-top: 30px; margin-bottom: 40px;" />

                </ui:ScrollView>
            </ui:VisualElement>        </ui:VisualElement>
    </ui:VisualElement>

    <!-- BOTTOM NAV & FOOTER -->
    <ui:VisualElement class="bottom-nav-container">
        <!-- Nav Buttons -->
        <ui:VisualElement class="nav-bar-row">
            <ui:Button name="BtnCareers" text="Careers" class="nav-button" />
            <ui:Button name="BtnHustles" text="Hustles" class="nav-button" />
            <ui:Button name="BtnAdvanceWeek" text="+ Week" class="advance-week-btn" />
            <ui:Button name="BtnEducation" text="Education" class="nav-button" />
            <ui:Button name="BtnActivities" text="Activities" class="nav-button" />
        </ui:VisualElement>

        <!-- Progress Bars -->
        <ui:VisualElement class="footer-stats-row">
            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Performance" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="PerfVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="PerfFill" class="progress-fill" style="width: 0%; background-color: #F1C40F;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Job Luck" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="LuckVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="LuckFill" class="progress-fill" style="width: 0%; background-color: #2ECC71;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="footer-stat">
                <ui:VisualElement class="row">
                    <ui:Label text="Stress" class="footer-label" style="font-size: 24px; color: #94A3B8; margin-bottom: 5px;" />
                    <ui:Label name="StressVal" text="0%" class="footer-val" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track">
                    <ui:VisualElement name="StressFill" class="progress-fill" style="width: 0%; background-color: #E74C3C;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>