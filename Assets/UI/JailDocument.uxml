<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    
    <ui:Style src="styles.uss" />

    <ui:VisualElement class="screen-container" style="background-color: #1B2631; justify-content: space-between;">
        
        <ui:VisualElement style="align-items: center; margin-top: 40px;">
            <ui:Label text="🔒" style="font-size: 80px; margin-bottom: 20px;" />
            <ui:Label text="STATE PENITENTIARY" class="header-text" style="color: #ECF0F1; font-size: 24px;" />
            <ui:Label text="CHARGES: Attempted Illegal Side Hustle" class="sub-text" style="color: #E74C3C; font-weight: bold;" />

            <ui:VisualElement class="card" style="background-color: #2C3E50; border-color: #34495E; margin-top: 30px; align-items: center; width: 100%;">
                <ui:Label text="SENTENCE REMAINING" class="sub-text" style="color: #BDC3C7; font-size: 28px;" />
                <ui:Label name="JailWeeksText" text="0 WEEKS" class="header-text" style="color: #F1C40F; font-size: 36px;" />
            </ui:VisualElement>

            <!-- Prison Yard Activities -->
            <ui:Label text="Prison Yard Activities (Max 1 of each per week):" style="font-size: 28px; font-weight: bold; color: #BDC3C7; margin-top: 20px; margin-bottom: 10px; align-self: flex-start;" />
            
            <ui:ScrollView style="width: 100%; height: 500px;">
                <ui:VisualElement class="job-card" style="background-color: #2C3E50; border-color: #34495E; margin-bottom: 5px;">
                    <ui:VisualElement class="row">
                        <ui:Label text="Workout" style="color: #FFFFFF; font-size: 28px; -unity-font-style: bold;" />
                        <ui:Button name="BtnWorkout" text="DO ACTION" class="apply-button" style="background-color: #F1C40F; color: black;" />
                    </ui:VisualElement>
                    <ui:Label text="Lift cement blocks (Manual Luck +0.5%)" style="color: #3498DB; font-size: 28px;" />
                </ui:VisualElement>

                <ui:VisualElement class="job-card" style="background-color: #2C3E50; border-color: #34495E; margin-bottom: 5px;">
                    <ui:VisualElement class="row">
                        <ui:Label text="Read Tech Docs" style="color: #FFFFFF; font-size: 28px; -unity-font-style: bold;" />
                        <ui:Button name="BtnTechDocs" text="DO ACTION" class="apply-button" style="background-color: #F1C40F; color: black;" />
                    </ui:VisualElement>
                    <ui:Label text="Memorize coding docs (Tech Luck +0.5%)" style="color: #3498DB; font-size: 28px;" />
                </ui:VisualElement>

                <ui:VisualElement class="job-card" style="background-color: #2C3E50; border-color: #34495E; margin-bottom: 5px;">
                    <ui:VisualElement class="row">
                        <ui:Label text="Practice Social Skills" style="color: #FFFFFF; font-size: 28px; -unity-font-style: bold;" />
                        <ui:Button name="BtnSocial" text="DO ACTION" class="apply-button" style="background-color: #F1C40F; color: black;" />
                    </ui:VisualElement>
                    <ui:Label text="Settle inmate disputes (Hospitality Luck +0.5%)" style="color: #3498DB; font-size: 28px;" />
                </ui:VisualElement>

                <ui:VisualElement class="job-card" style="background-color: #2C3E50; border-color: #34495E; margin-bottom: 5px;">
                    <ui:VisualElement class="row">
                        <ui:Label text="Bribe / C-Suite Chat" style="color: #FFFFFF; font-size: 28px; -unity-font-style: bold;" />
                        <ui:Button name="BtnBribe" text="DO ACTION" class="apply-button" style="background-color: #F1C40F; color: black;" />
                    </ui:VisualElement>
                    <ui:Label text="Chat with hedge manager (Corporate Luck +0.5%)" style="color: #3498DB; font-size: 28px;" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:Button name="BtnServeWeek" text="SERVE WEEK IN CELLS" class="advance-week-btn" style="background-color: #27AE60; height: 100px; font-size: 32px; margin-bottom: 20px; width: 100%; border-radius: 12px;" />
        
    </ui:VisualElement>
</ui:UXML>
