<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    
    <ui:Style src="styles.uss" />

    <ui:VisualElement name="GraphOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; display: none;">
        
        <ui:VisualElement class="popup-card" style="width: 95%;">
            
            <ui:Label text="PERSONAL TRANSACTIONS CHART" style="font-size: 40px; -unity-font-style: bold; color: #38BDF8; margin-bottom: 15px;" />
            <ui:Label text="Trailing Weekly Income vs Spending History" style="font-size: 28px; color: #94A3B8; margin-bottom: 30px;" />

            <!-- The container where our C# script will draw the graph -->
            <ui:VisualElement name="GraphArea" style="width: 100%; height: 500px; background-color: #1E293B; border-color: #475569; border-width: 2px; border-radius: 20px; margin-bottom: 30px; overflow: hidden; position: relative;" />

            <ui:VisualElement class="row" style="justify-content: space-around; margin-bottom: 30px;">
                <ui:Label text="■ Weekly Income" style="color: #2ECC71; font-size: 28px; -unity-font-style: bold;" />
                <ui:Label text="■ Rent/Food Spent" style="color: #E74C3C; font-size: 28px; -unity-font-style: bold;" />
            </ui:VisualElement>

            <ui:Button name="BtnCloseGraph" text="Close Ledger" class="popup-button" style="background-color: #475569;" />
            
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>
