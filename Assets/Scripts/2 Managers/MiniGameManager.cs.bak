        if (wbContainer != null) wbGrid = wbContainer.Q<VisualElement>("BugGrid");

        tsContainer = root.Q<VisualElement>("TicketSwipeContainer");
        if (tsContainer != null)
        {
            tsCard = tsContainer.Q<VisualElement>("TicketCard");
            if (tsCard != null) tsText = tsCard.Q<Label>("TicketSwipeText");
            
            if (tsCard != null)
            {
                tsCard.RegisterCallback<PointerDownEvent>(ev => {
                    if (currentConfig == null || currentConfig.type != GameType.TicketSwipe || !isPlaying) return;
                    tsStartPos = ev.position;
                    tsCard.CapturePointer(ev.pointerId);
                });
                tsCard.RegisterCallback<PointerMoveEvent>(ev => {
                    if (currentConfig == null || currentConfig.type != GameType.TicketSwipe || !isPlaying || !tsCard.HasPointerCapture(ev.pointerId)) return;
                    Vector2 delta = (Vector2)ev.position - tsStartPos;
                    tsCard.style.translate = new Translate(delta.x, delta.y, 0);
                    float rot = delta.x * 0.05f;
                    tsCard.style.rotate = new Rotate(Angle.Degrees(rot));
                });
                tsCard.RegisterCallback<PointerUpEvent>(ev => {
                    if (tsCard.HasPointerCapture(ev.pointerId))
                    {
                        tsCard.ReleasePointer(ev.pointerId);
                        Vector2 delta = (Vector2)ev.position - tsStartPos;
                        if (delta.x < -150f || delta.x > 150f || delta.y < -150f)
                        {
                            HandleTicketSwipe(delta);
                        }
                        else
                        {
                            tsCard.style.translate = new Translate(0, 0, 0);
                            tsCard.style.rotate = new Rotate(Angle.Degrees(0));
                        }
                    }
                });
            }
        }

