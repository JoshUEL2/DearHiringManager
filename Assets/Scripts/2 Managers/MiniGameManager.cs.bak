            ztCircle = ztContainer.Q<VisualElement>("ZenCircle");
            ztTarget = ztContainer.Q<VisualElement>("ZenTarget");
            ztSponge = ztContainer.Q<VisualElement>("ZenSponge");
            
            if (ztContainer != null)
            {
                ztContainer.RegisterCallback<PointerMoveEvent>(ev => {
                    if (currentConfig == null || currentConfig.type != GameType.ZenTracing || !isPlaying) return;
                    Vector2 localPos = ztCircle.WorldToLocal(ev.position);
                    Vector2 center = new Vector2(ztCircle.layout.width / 2f, ztCircle.layout.height / 2f);
                    Vector2 dir = localPos - center;
                    float angle = Mathf.Atan2(dir.y, dir.x) * Mathf.Rad2Deg;
                    if (angle < 0) angle += 360f;
                    ztAngle = angle;
                });
            }
        }

        isContainer = root.Q<VisualElement>("IceShatterContainer");
        if (isContainer != null) isFrostOverlay = isContainer.Q<VisualElement>("FrostOverlay");

        nmContainer = root.Q<VisualElement>("NameMemoryContainer");
        if (nmContainer != null)
        {
            nmVipArea = nmContainer.Q<VisualElement>("VipDisplayArea");
            nmQuestionText = nmContainer.Q<Label>("MemoryQuestionText");
            nmAnswerRow = nmContainer.Q<VisualElement>("MemoryAnswerRow");
        }

        rrContainer = root.Q<VisualElement>("RetroRacerContainer");
        if (rrContainer != null)
        {
            rrRoad = rrContainer.Q<VisualElement>("RacerRoad");
            rrPlayer = rrContainer.Q<VisualElement>("RacerPlayer");
            btnRrLeft = rrContainer.Q<Button>("BtnRaceLeft");
            btnRrRight = rrContainer.Q<Button>("BtnRaceRight");
        }

        // Footer
        btnAbort = root.Q<Button>("BtnAbort");
        btnAbort.clicked += AbortGame;


        overlay.style.display = DisplayStyle.None;
        overlay.pickingMode = PickingMode.Ignore;
    }

