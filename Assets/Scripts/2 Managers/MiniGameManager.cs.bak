    private void SetupConstructionSite()
    {
        if (csContainer == null) return;
        csContainer.Clear();
        csTimeInZone = 0f;
        csBalancePos = 50f; // 0 to 100%
        csDrift = 0f;

        Label header = new Label("Inspection: 0.0 / 10.0   Time: 15.0");
        header.name = "HeaderLabel";
        header.style.fontSize = 24;
        header.style.color = Color.white;
        header.style.unityTextAlign = TextAnchor.MiddleCenter;
        header.style.marginBottom = 20;
        csContainer.Add(header);
        
        Label windArrow = new Label("WIND: ➡️");
        windArrow.name = "WindLabel";
        windArrow.style.fontSize = 28;
        windArrow.style.color = Color.cyan;
        windArrow.style.unityTextAlign = TextAnchor.MiddleCenter;
        windArrow.style.marginBottom = 20;
        csContainer.Add(windArrow);

        VisualElement track = new VisualElement();
        track.style.width = 400;
        track.style.height = 40;
        track.style.backgroundColor = Color.gray;
        track.style.alignSelf = Align.Center;
        track.style.marginBottom = 30;
        track.style.flexDirection = FlexDirection.Row;
        csContainer.Add(track);

        csBalanceZone = new VisualElement();
        csBalanceZone.style.width = new Length(30, LengthUnit.Percent);
        csBalanceZone.style.height = new Length(100, LengthUnit.Percent);
        csBalanceZone.style.backgroundColor = Color.green;
        csBalanceZone.style.position = Position.Absolute;
        csBalanceZone.style.left = new Length(35, LengthUnit.Percent); // centered
        track.Add(csBalanceZone);

        csPlayerMarker = new VisualElement();
        csPlayerMarker.style.width = 20;
        csPlayerMarker.style.height = 40;
        csPlayerMarker.style.backgroundColor = Color.yellow;
        csPlayerMarker.style.position = Position.Absolute;
        csPlayerMarker.style.left = new Length(50, LengthUnit.Percent);
        track.Add(csPlayerMarker);

        VisualElement btnRow = new VisualElement();
        btnRow.style.flexDirection = FlexDirection.Row;
        btnRow.style.justifyContent = Justify.Center;
        csContainer.Add(btnRow);

        btnCsLeft = new Button();
        btnCsLeft.text = "⬅️ LEAN LEFT";
        btnCsLeft.style.fontSize = 18;
        btnCsLeft.style.width = 150;
        btnCsLeft.style.height = 60;
        btnCsLeft.style.marginRight = 20;
        btnRow.Add(btnCsLeft);

        btnCsRight = new Button();
        btnCsRight.text = "LEAN RIGHT ➡️";
        btnCsRight.style.fontSize = 18;
        btnCsRight.style.width = 150;
        btnCsRight.style.height = 60;
        btnCsRight.style.marginLeft = 20;
        btnRow.Add(btnCsRight);

        timer = 15f;
        activeGameRoutine = StartCoroutine(ConstructionSiteRoutine());
    }

    private IEnumerator ConstructionSiteRoutine()
    {
        isPlaying = true;
        Label header = csContainer.Q<Label>("HeaderLabel");
        Label wind = csContainer.Q<Label>("WindLabel");
        
        float nextDriftChange = 2f;
        csDrift = 15f; // start drifting right
        
        bool leftPressed = false;
        bool rightPressed = false;
        
        btnCsLeft.RegisterCallback<PointerDownEvent>(e => leftPressed = true);
        btnCsLeft.RegisterCallback<PointerUpEvent>(e => leftPressed = false);
        btnCsLeft.RegisterCallback<PointerLeaveEvent>(e => leftPressed = false);
        
        btnCsRight.RegisterCallback<PointerDownEvent>(e => rightPressed = true);
        btnCsRight.RegisterCallback<PointerUpEvent>(e => rightPressed = false);
        btnCsRight.RegisterCallback<PointerLeaveEvent>(e => rightPressed = false);

        while (isPlaying)
        {
            timer -= Time.deltaTime;
            nextDriftChange -= Time.deltaTime;
            
            if (nextDriftChange <= 0f)
            {
                nextDriftChange = UnityEngine.Random.Range(2f, 3f);
                csDrift = UnityEngine.Random.Range(10f, 25f) * (UnityEngine.Random.value > 0.5f ? 1f : -1f);
                if (wind != null)
                    wind.text = csDrift > 0 ? "WIND: ➡️" : "WIND: ⬅️";
            }
            
            float move = csDrift * Time.deltaTime;
            if (leftPressed) move -= 30f * Time.deltaTime;
            if (rightPressed) move += 30f * Time.deltaTime;
            
            csBalancePos += move;
            if (csPlayerMarker != null)
            {
                // Subtract half width (approx 2.5%) for centering
                csPlayerMarker.style.left = new Length(Mathf.Clamp(csBalancePos - 2.5f, 0f, 95f), LengthUnit.Percent);
            }
            
            if (csBalancePos < 0f || csBalancePos > 100f)
            {
                EndGame(false); // fell off
                yield break;
            }
            
            // Check if in green zone (35% to 65%)
            if (csBalancePos >= 35f && csBalancePos <= 65f)
            {
                csTimeInZone += Time.deltaTime;
                csBalanceZone.style.backgroundColor = Color.green;
            }
            else
            {
                csBalanceZone.style.backgroundColor = new Color(0f, 0.5f, 0f);
            }
            
            if (header != null)
                header.text = $"Inspection: {csTimeInZone:0.0} / 10.0   Time: {timer:0.0}";
                
            if (csTimeInZone >= 10f)
            {
                EndGame(true);
                yield break;
            }
            
            if (timer <= 0f)
            {
                EndGame(false);
                yield break;
            }
            
            yield return null;
        }
    }

    // ZenTracing
    private void SetupZenTracing()
    {
        ztAngle = 0f;
        ztTargetAngle = 0f;
        ztScore = 0f;
        timer = currentConfig.timeLimit;
        activeGameRoutine = StartCoroutine(ZenTracingRoutine());
    }

    private IEnumerator ZenTracingRoutine()
    {
        isPlaying = true;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(ztScore >= currentConfig.timeLimit * 0.8f); // 80% accuracy needed
                yield break;
            }

            // Move target
            ztTargetAngle += 90f * Time.deltaTime; // 90 degrees per second
            if (ztTargetAngle >= 360f) ztTargetAngle -= 360f;

            if (ztTarget != null)
            {
                float rad = ztTargetAngle * Mathf.Deg2Rad;
                ztTarget.style.left = new Length(50f + Mathf.Cos(rad) * 50f, LengthUnit.Percent);
                ztTarget.style.top = new Length(50f + Mathf.Sin(rad) * 50f, LengthUnit.Percent);
            }
            if (ztSponge != null)
            {
                float rad = ztAngle * Mathf.Deg2Rad;
                ztSponge.style.left = new Length(50f + Mathf.Cos(rad) * 50f, LengthUnit.Percent);
                ztSponge.style.top = new Length(50f + Mathf.Sin(rad) * 50f, LengthUnit.Percent);
            }

            // Check diff
            float diff = Mathf.Abs(Mathf.DeltaAngle(ztAngle, ztTargetAngle));
            if (diff < 20f)
            {
                ztScore += Time.deltaTime;
                if (ztSponge != null) ztSponge.style.backgroundColor = Color.green;
            }
            else
            {
                if (ztSponge != null) ztSponge.style.backgroundColor = Color.red;
            }

            yield return null;
        }
    }

    // IceShatter
    private void SetupIceShatter()
    {
        isBodyTemp = 100f;
        timer = currentConfig.timeLimit;
        
        if (isContainer != null)
        {
            foreach (var node in isNodes) isContainer.Remove(node);
        }
        isNodes.Clear();
        
        activeGameRoutine = StartCoroutine(IceShatterRoutine());
    }

    private IEnumerator IceShatterRoutine()
    {
        isPlaying = true;
        float spawnTimer = 0f;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(true);
                yield break;
            }

            spawnTimer -= Time.deltaTime;
            if (spawnTimer <= 0f)
            {
                Button node = new Button();
                node.style.width = 60;
                node.style.height = 60;
                node.style.position = Position.Absolute;
                node.style.left = new Length(Random.Range(10f, 90f), LengthUnit.Percent);
                node.style.top = new Length(Random.Range(10f, 90f), LengthUnit.Percent);
                node.style.backgroundColor = new Color(0.2f, 0.8f, 1f, 0.8f);
                node.style.borderTopLeftRadius = 30; node.style.borderTopRightRadius = 30; node.style.borderBottomLeftRadius = 30; node.style.borderBottomRightRadius = 30;
                node.style.borderTopWidth = 2; node.style.borderBottomWidth = 2; node.style.borderLeftWidth = 2; node.style.borderRightWidth = 2;
                node.style.borderTopColor = Color.white; node.style.borderBottomColor = Color.white; node.style.borderLeftColor = Color.white; node.style.borderRightColor = Color.white;
                
                node.clicked += () => {
                    if (!isPlaying) return;
                    isBodyTemp = Mathf.Clamp(isBodyTemp + 10f, 0f, 100f);
                    isContainer.Remove(node);
                    isNodes.Remove(node);
                };

                isNodes.Add(node);
                isContainer.Add(node);
                spawnTimer = Random.Range(0.5f, 1.5f);
            }

            isBodyTemp -= (5f + isNodes.Count * 2f) * Time.deltaTime;
            if (isFrostOverlay != null)
            {
                float freezePercent = 1f - (isBodyTemp / 100f);
                isFrostOverlay.style.backgroundColor = new Color(1f, 1f, 1f, freezePercent * 0.8f);
            }

            if (isBodyTemp <= 0f)
            {
                EndGame(false); // Froze to death
                yield break;
            }

            yield return null;
        }
    }

    // NameMemory
    private void SetupNameMemory()
    {
        timer = currentConfig.timeLimit;
        nmIsAnsweringPhase = false;
        
        if (nmVipArea != null) nmVipArea.Clear();
        nmVips.Clear();
        
        if (nmAnswerRow != null) nmAnswerRow.Clear();
        nmAnswers.Clear();

        // Pick 3 random VIPs
        List<string> selectedVips = new List<string>();
        List<string> pool = new List<string>(currentConfig.vipNames);
        for (int i = 0; i < 3; i++)
        {
            if (pool.Count == 0) break;
            int idx = Random.Range(0, pool.Count);
            selectedVips.Add(pool[idx]);
            pool.RemoveAt(idx);
        }

        nmCorrectIndex = Random.Range(0, 3);
        string questionTarget = selectedVips[nmCorrectIndex].Split(' ')[2]; // E.g. "Tech" from "Sarah from Tech"
        nmQuestionText.text = "Memorize the VIPs!";
        nmQuestionText.style.display = DisplayStyle.Flex;

        for (int i = 0; i < 3; i++)
        {
            VisualElement vip = new VisualElement();
            vip.style.width = 100;
            vip.style.height = 150;
            vip.style.backgroundColor = new Color(0.2f, 0.2f, 0.2f);
            vip.style.borderTopLeftRadius = 10; vip.style.borderTopRightRadius = 10; vip.style.borderBottomLeftRadius = 10; vip.style.borderBottomRightRadius = 10;
            vip.style.justifyContent = Justify.Center;
            vip.style.alignItems = Align.Center;

            Label nameLbl = new Label(selectedVips[i].Split(' ')[0]);
            nameLbl.style.fontSize = 24;
            nameLbl.style.color = Color.white;
            vip.Add(nameLbl);

            Label deptLbl = new Label(selectedVips[i].Split(' ')[2]);
            deptLbl.style.fontSize = 18;
            deptLbl.style.color = Color.gray;
            vip.Add(deptLbl);

            nmVips.Add(vip);
            nmVipArea.Add(vip);

            Button ansBtn = new Button();
            ansBtn.text = selectedVips[i].Split(' ')[0];
            ansBtn.AddToClassList("popup-button");
            ansBtn.style.display = DisplayStyle.None;
            int capturedIdx = i;
            ansBtn.clicked += () => {
                if (!isPlaying || !nmIsAnsweringPhase) return;
                EndGame(capturedIdx == nmCorrectIndex);
            };
            nmAnswers.Add(ansBtn);
            nmAnswerRow.Add(ansBtn);
        }

        activeGameRoutine = StartCoroutine(NameMemoryRoutine(questionTarget));
    }

    private IEnumerator NameMemoryRoutine(string questionTarget)
    {
        isPlaying = true;
        
        // Memorize phase
        yield return new WaitForSeconds(5f);
        if (!isPlaying) yield break;

        // Shuffle & Ask phase
        nmIsAnsweringPhase = true;
        nmQuestionText.text = $"Who was from {questionTarget}?";
        
        foreach (var vip in nmVips) vip.style.display = DisplayStyle.None;
        foreach (var ans in nmAnswers) ans.style.display = DisplayStyle.Flex;

        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(false);
                yield break;
            }
            yield return null;
        }
    }

    // RetroRacer
    private void SetupRetroRacer()
    {
        timer = currentConfig.timeLimit;
        rrPlayerX = 0.5f;
        
        if (btnRrLeft != null)
        {
            btnRrLeft.RegisterCallback<PointerDownEvent>(ev => { if(isPlaying) rrPlayerX -= 0.1f; });
        }
        if (btnRrRight != null)
        {
            btnRrRight.RegisterCallback<PointerDownEvent>(ev => { if(isPlaying) rrPlayerX += 0.1f; });
        }

        if (rrRoad != null) rrRoad.Clear();
        rrObstacles.Clear();
        rrObstaclePos.Clear();

        activeGameRoutine = StartCoroutine(RetroRacerRoutine());
    }

    private IEnumerator RetroRacerRoutine()
    {
        isPlaying = true;
        float spawnTimer = 0f;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(true);
                yield break;
            }

            rrPlayerX = Mathf.Clamp01(rrPlayerX);
            if (rrPlayer != null)
            {
                rrPlayer.style.left = new Length(rrPlayerX * 100f, LengthUnit.Percent);
            }

            spawnTimer -= Time.deltaTime;
            if (spawnTimer <= 0f)
            {
                VisualElement obs = new VisualElement();
                obs.style.position = Position.Absolute;
                obs.style.backgroundColor = Color.red;
                obs.style.width = 10;
                obs.style.height = 10;
                obs.style.top = new Length(50f, LengthUnit.Percent); // Horizon
                float startX = Random.Range(0.4f, 0.6f); // Spawns near center horizon
                obs.style.left = new Length(startX * 100f, LengthUnit.Percent);
                rrRoad.Add(obs);
                rrObstacles.Add(obs);
                rrObstaclePos.Add(new Vector2(startX, 0f)); // x = lane, y = progress (0 to 1)

                spawnTimer = Random.Range(0.8f, 1.5f);
            }

            for (int i = rrObstacles.Count - 1; i >= 0; i--)
            {
                Vector2 pos = rrObstaclePos[i];
                pos.y += Time.deltaTime * 0.8f; // Speed of approach
                rrObstaclePos[i] = pos;

                if (pos.y >= 1f)
                {
                    // Check collision
                    if (Mathf.Abs(pos.x - rrPlayerX) < 0.15f)
                    {
                        EndGame(false);
                        yield break;
                    }

                    rrRoad.Remove(rrObstacles[i]);
                    rrObstacles.RemoveAt(i);
                    rrObstaclePos.RemoveAt(i);
                }
                else
                {
                    // Scale and spread
                    float spread = (pos.x - 0.5f) * pos.y * 3f; // Move outwards from center
                    rrObstacles[i].style.left = new Length((0.5f + spread) * 100f, LengthUnit.Percent);
                    rrObstacles[i].style.top = new Length((0.5f + (pos.y * 0.5f)) * 100f, LengthUnit.Percent);
                    float size = 10f + (pos.y * 90f);
                    rrObstacles[i].style.width = size;
                    rrObstacles[i].style.height = size;
                }
            }

            yield return null;
        }
    }

    // Phase 3 & 4 Custom Games
    // MowGreens
    private void SetupMowGreens()
    {
        timer = currentConfig.timeLimit > 0 ? currentConfig.timeLimit : 15f;
        mgTilesCut = 0;
        mgCutStatus = new bool[25];
        
        if (mgContainer != null)
        {
            mgGrid = mgContainer.Q<VisualElement>("MowGrid");
            if (mgGrid == null)
            {
                mgGrid = new VisualElement();
                mgGrid.style.flexDirection = FlexDirection.Row;
                mgGrid.style.flexWrap = Wrap.Wrap;
                mgGrid.style.width = 300;
                mgGrid.style.height = 300;
                mgGrid.name = "MowGrid";
                mgContainer.Add(mgGrid);
            }
            mgGrid.Clear();
            
            for (int i = 0; i < 25; i++)
            {
                VisualElement tile = new VisualElement();
                tile.style.width = 58;
                tile.style.height = 58;
                tile.style.marginTop = 1; tile.style.marginBottom = 1; tile.style.marginLeft = 1; tile.style.marginRight = 1;
                tile.style.backgroundColor = Color.green; // Tall grass
                int idx = i;
                
                tile.RegisterCallback<PointerMoveEvent>(ev => {
                    if (isPlaying && !mgCutStatus[idx])
                    {
                        mgCutStatus[idx] = true;
                        tile.style.backgroundColor = new Color(0.3f, 0.5f, 0.3f); // Cut grass
                        mgTilesCut++;
                        if (mgTilesCut >= 25) EndGame(true);
                    }
                });
                mgGrid.Add(tile);
            }
        }
        activeGameRoutine = StartCoroutine(MowGreensRoutine());
    }

    private IEnumerator MowGreensRoutine()
    {
        isPlaying = true;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(false);
                yield break;
            }
            yield return null;
        }
    }

    private void SetupWalkDogs()
    {
        timer = currentConfig.timeLimit > 0 ? currentConfig.timeLimit : 15f;
        
        if (wdContainer != null)
        {
            wdContainer.Clear();
            VisualElement row = new VisualElement();
            row.style.flexDirection = FlexDirection.Row;
            row.style.justifyContent = Justify.SpaceAround;
            row.style.width = new Length(100, LengthUnit.Percent);
            row.style.height = 200;
            
            for (int i = 0; i < 3; i++)
            {
                VisualElement col = new VisualElement();
                col.style.width = 60;
                col.style.height = 200;
                col.style.flexDirection = FlexDirection.Column;
                col.style.justifyContent = Justify.FlexEnd;
                
                VisualElement bg = new VisualElement();
                bg.style.width = 40;
                bg.style.height = 150;
                bg.style.backgroundColor = Color.gray;
                
                VisualElement bar = new VisualElement();
                bar.style.width = 40;
                bar.style.height = 50; // Middle
                bar.style.backgroundColor = Color.green;
                bg.Add(bar);
                
                Button yank = new Button();
                yank.text = "YANK";
                yank.style.height = 40;
                
                int idx = i;
                wdTensions[i] = 0.5f; // Middle
                wdBars[i] = bar;
                wdBtns[i] = yank;
                
                yank.RegisterCallback<PointerDownEvent>(ev => { if(isPlaying) wdTensions[idx] -= 0.5f; });
                
                col.Add(bg);
                col.Add(yank);
                row.Add(col);
            }
            wdContainer.Add(row);
        }
        activeGameRoutine = StartCoroutine(WalkDogsRoutine());
    }

    private IEnumerator WalkDogsRoutine()
    {
        isPlaying = true;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(true); // survived
                yield break;
            }
            
            for (int i = 0; i < 3; i++)
            {
                wdTensions[i] += Random.Range(0.1f, 0.4f) * Time.deltaTime; // dogs pull
                wdTensions[i] = Mathf.Clamp01(wdTensions[i]);
                
                if (wdBars[i] != null)
                {
                    wdBars[i].style.height = new Length(wdTensions[i] * 100f, LengthUnit.Percent);
                    if (wdTensions[i] > 0.8f || wdTensions[i] < 0.2f) wdBars[i].style.backgroundColor = Color.red;
                    else wdBars[i].style.backgroundColor = Color.green;
                }
                
                if (wdTensions[i] >= 1f || wdTensions[i] <= 0f)
                {
                    EndGame(false); // Dog escaped or choked
                    yield break;
                }
            }
            yield return null;
        }
    }

    private void SetupSkimATM()
    {
        timer = currentConfig.timeLimit > 0 ? currentConfig.timeLimit : 15f;
        saConnections = 0;
        saActiveNode = null;
        
        if (saContainer != null)
        {
            saContainer.Clear();
            VisualElement leftCol = new VisualElement();
            VisualElement rightCol = new VisualElement();
            leftCol.style.flexDirection = FlexDirection.Column;
            rightCol.style.flexDirection = FlexDirection.Column;
            
            saLeftNodes.Clear();
            saRightNodes.Clear();
            
            Color[] colors = { Color.red, Color.blue, Color.green, Color.yellow };
            // Shuffle rights
            Color[] rightColors = { Color.red, Color.blue, Color.green, Color.yellow };
            for(int i = 0; i < rightColors.Length; i++) {
                int r = Random.Range(i, rightColors.Length);
                Color temp = rightColors[i];
                rightColors[i] = rightColors[r];
                rightColors[r] = temp;
            }
            
            for (int i = 0; i < 4; i++)
            {
                Button lBtn = new Button();
                lBtn.style.width = 40; lBtn.style.height = 40; lBtn.style.marginTop = 10; lBtn.style.marginBottom = 10; lBtn.style.marginLeft = 10; lBtn.style.marginRight = 10;
                lBtn.style.backgroundColor = colors[i];
                Color c = colors[i];
                lBtn.clicked += () => { if(isPlaying && lBtn.enabledSelf) saActiveNode = lBtn; };
                saLeftNodes.Add(lBtn);
                leftCol.Add(lBtn);
                
                Button rBtn = new Button();
                rBtn.style.width = 40; rBtn.style.height = 40; rBtn.style.marginTop = 10; rBtn.style.marginBottom = 10; rBtn.style.marginLeft = 10; rBtn.style.marginRight = 10;
                rBtn.style.backgroundColor = rightColors[i];
                Color targetC = rightColors[i];
                rBtn.clicked += () => {
                    if (isPlaying && saActiveNode != null && saActiveNode.style.backgroundColor == rBtn.style.backgroundColor && rBtn.enabledSelf)
                    {
                        saActiveNode.enabledSelf = false;
                        rBtn.enabledSelf = false;
                        saConnections++;
                        saActiveNode = null;
                        if (saConnections >= 4) EndGame(true);
                    }
                    else if (isPlaying && saActiveNode != null)
                    {
                        // Wrong connection
                        EndGame(false);
                    }
                };
                saRightNodes.Add(rBtn);
                rightCol.Add(rBtn);
            }
            saContainer.Add(leftCol);
            saContainer.Add(rightCol);
        }
        activeGameRoutine = StartCoroutine(SkimATMRoutine());
    }

    private IEnumerator SkimATMRoutine()
    {
        isPlaying = true;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(false);
                yield break;
            }
            yield return null;
        }
    }

    private void SetupCorporateGolf()
    {
        timer = currentConfig.timeLimit > 0 ? currentConfig.timeLimit : 15f;
        cgClicks = 0;
        cgPower = 0f;
        cgMovingUp = true;
        
        if (cgContainer != null)
        {
            cgContainer.Clear();
            VisualElement bar = new VisualElement();
            bar.style.width = 40;
            bar.style.height = 300;
            bar.style.backgroundColor = Color.gray;
            bar.style.justifyContent = Justify.FlexEnd;
            
            cgSnapZone = new VisualElement();
            cgSnapZone.style.width = 40;
            cgSnapZone.style.height = 30; // 10%
            cgSnapZone.style.bottom = 30; // 10% up from bottom
            cgSnapZone.style.position = Position.Absolute;
            cgSnapZone.style.backgroundColor = Color.green;
            bar.Add(cgSnapZone);
            
            cgMarker = new VisualElement();
            cgMarker.style.width = 50;
            cgMarker.style.height = 10;
            cgMarker.style.backgroundColor = Color.white;
            cgMarker.style.position = Position.Absolute;
            cgMarker.style.left = -5;
            bar.Add(cgMarker);
            
            cgBtnSwing = new Button();
            cgBtnSwing.text = "SWING!";
            cgBtnSwing.style.marginTop = 20;
            cgBtnSwing.clicked += () => {
                if (!isPlaying) return;
                cgClicks++;
                if (cgClicks == 1) { /* Starts */ }
                else if (cgClicks == 2) { cgMovingUp = false; /* Top of swing */ }
                else if (cgClicks == 3) {
                    // Check accuracy
                    if (cgPower >= 0.1f && cgPower <= 0.2f) EndGame(true); // Perfect snap
                    else EndGame(false);
                }
            };
            
            cgContainer.Add(bar);
            cgContainer.Add(cgBtnSwing);
        }
        activeGameRoutine = StartCoroutine(CorporateGolfRoutine());
    }

    private IEnumerator CorporateGolfRoutine()
    {
        isPlaying = true;
        while (isPlaying)
        {
            if (cgClicks == 1)
            {
                if (cgMovingUp) cgPower += Time.deltaTime * 1.5f;
                if (cgPower >= 1f) { cgPower = 1f; cgMovingUp = false; }
            }
            else if (cgClicks == 2)
            {
                cgPower -= Time.deltaTime * 1.5f;
                if (cgPower <= 0f) { EndGame(false); yield break; }
            }
            
            if (cgMarker != null)
            {
                cgMarker.style.bottom = new Length(cgPower * 100f, LengthUnit.Percent);
            }
            yield return null;
        }
    }

    private void SetupTwoPhaseHeist()
    {
        timer = currentConfig.timeLimit > 0 ? currentConfig.timeLimit : 25f;
        
        if (tphContainer != null)
        {
            tphContainer.Clear();
            Label lbl = new Label("HEIST: Mash to Download!");
            lbl.style.color = Color.white;
            tphBtnDownload = new Button();
            tphBtnDownload.text = "MASH!";
            
            tphDownloadBar = new VisualElement();
            tphDownloadBar.style.width = 200;
            tphDownloadBar.style.height = 30;
            tphDownloadBar.style.backgroundColor = Color.gray;
            
            VisualElement fill = new VisualElement();
            fill.name = "Fill";
            fill.style.width = new Length(0, LengthUnit.Percent);
            fill.style.height = new Length(100, LengthUnit.Percent);
            fill.style.backgroundColor = Color.green;
            tphDownloadBar.Add(fill);
            
            tphDownloadProgress = 0f;
            tphBtnDownload.clicked += () => {
                if (!isPlaying) return;
                tphDownloadProgress += 0.05f;
                fill.style.width = new Length(tphDownloadProgress * 100f, LengthUnit.Percent);
                if (tphDownloadProgress >= 1f) EndGame(true);
            };
            
            tphContainer.Add(lbl);
            tphContainer.Add(tphDownloadBar);
            tphContainer.Add(tphBtnDownload);
        }
        
        activeGameRoutine = StartCoroutine(TwoPhaseHeistRoutine());
    }

    private IEnumerator TwoPhaseHeistRoutine()
    {
        isPlaying = true;
        while (isPlaying)
        {
            timer -= Time.deltaTime;
            if (timer <= 0f)
            {
                EndGame(false);
                yield break;
            }
            tphDownloadProgress -= Time.deltaTime * 0.1f; // decays
            if (tphDownloadProgress < 0) tphDownloadProgress = 0f;
            if (tphDownloadBar != null)
            {
                var fill = tphDownloadBar.Q<VisualElement>("Fill");
                if (fill != null) fill.style.width = new Length(tphDownloadProgress * 100f, LengthUnit.Percent);
            }
            yield return null;
        }
    }
    private void EndGame(bool win)
    {
        if (win)
            MarkWinReady();
        else
            AbortGame();
    }
}
