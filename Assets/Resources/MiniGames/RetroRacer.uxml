<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="RetroRacerContainer" style="display: none; width: 100%; min-width: 440px; height: 720px; flex-direction: column; background-color: #38BDF8; border-radius: 16px; border-width: 4px; border-color: #1E40AF; margin-bottom: 20px; position: relative; overflow: hidden;">
        
        <!-- UI Overlay -->
        <ui:VisualElement style="position: absolute; top: 15px; width: 100%; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 24px; z-index: 20;">
            <ui:Label name="RrDistanceLabel" text="DISTANCE: 0" style="font-size: 26px; color: white; -unity-font-style: bold; text-shadow: 2px 2px 0 rgba(0,0,0,0.6);" />
            <ui:VisualElement name="RrFoodContainer" style="flex-direction: row; align-items: center; background-color: rgba(0,0,0,0.45); padding: 6px 14px; border-radius: 12px;">
                <ui:Label text="MEALS:" style="font-size: 24px; color: #34D399; -unity-font-style: bold; margin-right: 8px;" />
                <ui:VisualElement name="RrFoodPip0" class="mg-icon mg-icon-burger" style="width: 32px; height: 32px; margin-right: 6px;" />
                <ui:VisualElement name="RrFoodPip1" class="mg-icon mg-icon-burger" style="width: 32px; height: 32px; margin-right: 6px;" />
                <ui:VisualElement name="RrFoodPip2" class="mg-icon mg-icon-burger" style="width: 32px; height: 32px;" />
            </ui:VisualElement>
            <ui:Label text="TIME: 20" name="RrTimeLabel" style="font-size: 26px; color: #FCD34D; -unity-font-style: bold; text-shadow: 2px 2px 0 rgba(0,0,0,0.6);" />
        </ui:VisualElement>
        
        <!-- Sky and Horizon -->
        <ui:VisualElement style="position: absolute; top: 0; width: 100%; height: 45%; background-color: #38BDF8; overflow: hidden;">
            <ui:VisualElement class="mg-icon mg-icon-cloud" style="position: absolute; top: 30px; left: 8%; width: 100px; height: 60px;" />
            <ui:VisualElement class="mg-icon mg-icon-cloud" style="position: absolute; top: 60px; right: 14%; width: 88px; height: 52px;" />
            <ui:VisualElement class="mg-icon mg-icon-sun" style="position: absolute; top: 35px; left: 45%; width: 80px; height: 80px;" />
            <ui:VisualElement style="position: absolute; bottom: 0; width: 100%; height: 24px; background-color: #064E3B;" />
        </ui:VisualElement>
        
        <!-- Ground (Road) -->
        <ui:VisualElement name="RrRoad" style="position: absolute; top: 45%; width: 100%; height: 55%; background-color: #4B5563; overflow: hidden; align-items: center;">
            
            <!-- Road Lines -->
            <ui:VisualElement name="RrLine0" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine1" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine2" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine3" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine4" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine5" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine6" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            <ui:VisualElement name="RrLine7" style="position: absolute; width: 10px; height: 2px; background-color: white; top: 0;" />
            
            <!-- 8 Obstacles -->
            <ui:VisualElement name="RrObs0" class="mg-icon mg-icon-car" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs1" class="mg-icon mg-icon-cone" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs2" class="mg-icon mg-icon-car" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs3" class="mg-icon mg-icon-cone" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs4" class="mg-icon mg-icon-car" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs5" class="mg-icon mg-icon-cone" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs6" class="mg-icon mg-icon-car" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            <ui:VisualElement name="RrObs7" class="mg-icon mg-icon-cone" style="position: absolute; width: 50px; height: 50px; top: 0; margin-left: -25px; margin-top: -25px; display: none;" />
            
            <!-- Player Scooter -->
            <ui:VisualElement name="RrPlayer" class="mg-icon mg-icon-scooter" style="position: absolute; width: 88px; height: 88px; bottom: 25px; margin-left: -44px;" />
        </ui:VisualElement>

        <!-- Drag to steer hint -->
        <ui:Label name="RrDragHint" text="SWIPE TO STEER" picking-mode="Ignore" style="position: absolute; bottom: 12px; width: 100%; -unity-text-align: middle-center; font-size: 22px; color: rgba(255,255,255,0.85); -unity-font-style: bold; text-shadow: 1px 1px 0 rgba(0,0,0,0.6);" />

    </ui:VisualElement>
</ui:UXML>