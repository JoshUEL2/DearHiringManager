<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="FoodPrepContainer" style="display: none; align-items: center; flex-direction: column; width: 100%; margin-bottom: 30px;">
                    <ui:Label name="PrepTimerText" text="15.0s" style="font-size: 32px; color: #F1C40F; -unity-font-style: bold; margin-bottom: 10px;" />
                    <ui:Label name="PrepScoreText" text="Prepped: 0 / 12" style="font-size: 24px; color: #2ECC71; -unity-font-style: bold; margin-bottom: 20px;" />

                    <!-- 2x2 Grid of Stations -->
                    <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; justify-content: center; width: 340px;">
                        <!-- Station 0: Grill -->
                        <ui:VisualElement name="Station0" style="width: 150px; height: 180px; background-color: #1E293B; border-radius: 12px; margin: 10px; border-width: 4px; border-color: #334155; align-items: center; justify-content: flex-end; position: relative; overflow: hidden;">
                            <ui:VisualElement name="PrepBar0" style="position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background-color: #E74C3C;" />
                            <ui:VisualElement name="GreenZone0" style="position: absolute; bottom: 70%; height: 25%; left: 0; right: 0; background-color: rgba(46, 204, 113, 0.4); border-top-width: 2px; border-bottom-width: 2px; border-color: #2ECC71;" />
                            <ui:Label text="🍔" style="font-size: 50px; margin-bottom: 20px;" />
                            <ui:Label name="StationStatus0" text="" style="position: absolute; top: 10px; font-size: 16px; color: white; -unity-font-style: bold;" />
                            <!-- Invisible input button covering the whole station -->
                            <ui:Button name="BtnStation0" style="position: absolute; width: 100%; height: 100%; opacity: 0;" />
                        </ui:VisualElement>

                        <!-- Station 1: Fryer -->
                        <ui:VisualElement name="Station1" style="width: 150px; height: 180px; background-color: #1E293B; border-radius: 12px; margin: 10px; border-width: 4px; border-color: #334155; align-items: center; justify-content: flex-end; position: relative; overflow: hidden;">
                            <ui:VisualElement name="PrepBar1" style="position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background-color: #E74C3C;" />
                            <ui:VisualElement name="GreenZone1" style="position: absolute; bottom: 70%; height: 25%; left: 0; right: 0; background-color: rgba(46, 204, 113, 0.4); border-top-width: 2px; border-bottom-width: 2px; border-color: #2ECC71;" />
                            <ui:Label text="🍟" style="font-size: 50px; margin-bottom: 20px;" />
                            <ui:Label name="StationStatus1" text="" style="position: absolute; top: 10px; font-size: 16px; color: white; -unity-font-style: bold;" />
                            <ui:Button name="BtnStation1" style="position: absolute; width: 100%; height: 100%; opacity: 0;" />
                        </ui:VisualElement>

                        <!-- Station 2: Drinks -->
                        <ui:VisualElement name="Station2" style="width: 150px; height: 180px; background-color: #1E293B; border-radius: 12px; margin: 10px; border-width: 4px; border-color: #334155; align-items: center; justify-content: flex-end; position: relative; overflow: hidden;">
                            <ui:VisualElement name="PrepBar2" style="position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background-color: #3498DB;" />
                            <ui:VisualElement name="GreenZone2" style="position: absolute; bottom: 70%; height: 25%; left: 0; right: 0; background-color: rgba(46, 204, 113, 0.4); border-top-width: 2px; border-bottom-width: 2px; border-color: #2ECC71;" />
                            <ui:Label text="🥤" style="font-size: 50px; margin-bottom: 20px;" />
                            <ui:Label name="StationStatus2" text="" style="position: absolute; top: 10px; font-size: 16px; color: white; -unity-font-style: bold;" />
                            <ui:Button name="BtnStation2" style="position: absolute; width: 100%; height: 100%; opacity: 0;" />
                        </ui:VisualElement>

                        <!-- Station 3: Assembly -->
                        <ui:VisualElement name="Station3" style="width: 150px; height: 180px; background-color: #1E293B; border-radius: 12px; margin: 10px; border-width: 4px; border-color: #334155; align-items: center; justify-content: flex-end; position: relative; overflow: hidden;">
                            <ui:VisualElement name="PrepBar3" style="position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background-color: #F1C40F;" />
                            <ui:VisualElement name="GreenZone3" style="position: absolute; bottom: 70%; height: 25%; left: 0; right: 0; background-color: rgba(46, 204, 113, 0.4); border-top-width: 2px; border-bottom-width: 2px; border-color: #2ECC71;" />
                            <ui:Label text="🥪" style="font-size: 50px; margin-bottom: 20px;" />
                            <ui:Label name="StationStatus3" text="" style="position: absolute; top: 10px; font-size: 16px; color: white; -unity-font-style: bold;" />
                            <ui:Button name="BtnStation3" style="position: absolute; width: 100%; height: 100%; opacity: 0;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>