<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="SnatchBriefcaseContainer" style="display: none; width: 100%; min-width: 400px; height: 500px; flex-direction: column; background-color: #1F2937; border-radius: 10px; border-width: 6px; border-color: #FCD34D; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; justify-content: center; padding: 20px;">
        
        <ui:VisualElement style="flex-grow: 1; width: 100%;" />
        
        <!-- Leather Texture Background -->
        <ui:VisualElement style="position: absolute; width: 100%; height: 100%; opacity: 0.8; background-color: #451A03;" />
        
        <ui:Label text="CRACK THE LOCK!" style="font-size: 28px; color: #FCD34D; -unity-font-style: bold; margin-bottom: 30px;" />
        
        <!-- The 3 Dials Container -->
        <ui:VisualElement style="flex-direction: row; justify-content: center; width: 100%; margin-bottom: 30px; position: relative; padding: 10px 0;">
            
            <!-- Dial 0 -->
            <ui:VisualElement style="width: 90px; height: 225px; background-color: #A38021; border-radius: 12px; margin: 0 10px; flex-direction: column; overflow: hidden; border-width: 3px; border-color: #715516; position: relative;">
                
                <ui:VisualElement name="SbDial0_Strip" style="position: absolute; width: 100%; height: 300px; flex-direction: column; top: -75px;">
                    <ui:Label name="SbDial0_Out" text="9" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial0_Top" text="0" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial0_Mid" text="1" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial0_Bot" text="2" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                </ui:VisualElement>

                <!-- Gradient Overlays for 3D Cylinder Effect -->
                <ui:VisualElement style="position: absolute; width: 100%; height: 75px; top: 0; background-color: rgba(0, 0, 0, 0.6);" />
                <ui:VisualElement style="position: absolute; width: 100%; height: 75px; bottom: 0; background-color: rgba(0, 0, 0, 0.6);" />
            </ui:VisualElement>

            <!-- Dial 1 -->
            <ui:VisualElement style="width: 90px; height: 225px; background-color: #A38021; border-radius: 12px; margin: 0 10px; flex-direction: column; overflow: hidden; border-width: 3px; border-color: #715516; position: relative;">
                
                <ui:VisualElement name="SbDial1_Strip" style="position: absolute; width: 100%; height: 300px; flex-direction: column; top: -75px;">
                    <ui:Label name="SbDial1_Out" text="9" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial1_Top" text="0" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial1_Mid" text="1" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial1_Bot" text="2" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                </ui:VisualElement>

                <!-- Gradient Overlays for 3D Cylinder Effect -->
                <ui:VisualElement style="position: absolute; width: 100%; height: 75px; top: 0; background-color: rgba(0, 0, 0, 0.6);" />
                <ui:VisualElement style="position: absolute; width: 100%; height: 75px; bottom: 0; background-color: rgba(0, 0, 0, 0.6);" />
            </ui:VisualElement>

            <!-- Dial 2 -->
            <ui:VisualElement style="width: 90px; height: 225px; background-color: #A38021; border-radius: 12px; margin: 0 10px; flex-direction: column; overflow: hidden; border-width: 3px; border-color: #715516; position: relative;">
                
                <ui:VisualElement name="SbDial2_Strip" style="position: absolute; width: 100%; height: 300px; flex-direction: column; top: -75px;">
                    <ui:Label name="SbDial2_Out" text="9" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial2_Top" text="0" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial2_Mid" text="1" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px; border-bottom-width: 2px; border-color: rgba(0,0,0,0.4);" />
                    <ui:Label name="SbDial2_Bot" text="2" style="font-size: 50px; color: black; -unity-font-style: bold; -unity-text-align: middle-center; height: 75px;" />
                </ui:VisualElement>

                <!-- Gradient Overlays for 3D Cylinder Effect -->
                <ui:VisualElement style="position: absolute; width: 100%; height: 75px; top: 0; background-color: rgba(0, 0, 0, 0.6);" />
                <ui:VisualElement style="position: absolute; width: 100%; height: 75px; bottom: 0; background-color: rgba(0, 0, 0, 0.6);" />
            </ui:VisualElement>

            <!-- Main Selection Bracket Overlay -->
            <ui:VisualElement style="position: absolute; width: 350px; height: 75px; border-color: #FCD34D; border-width: 3px; border-left-width: 0; border-right-width: 0; top: 85px; pointer-events: none;" />
            <ui:VisualElement style="position: absolute; width: 360px; height: 85px; top: 80px; left: -15px; border-color: #B45309; border-width: 2px; pointer-events: none; border-radius: 8px;" />

        </ui:VisualElement>
        
        <!-- Sticky Note Target -->
        <ui:VisualElement style="background-color: #FEF08A; padding: 10px 20px; border-radius: 2px; rotate: -3deg; margin-bottom: 20px; border-bottom-width: 3px; border-right-width: 3px; border-color: rgba(0,0,0,0.3);">
            <ui:Label name="SbTargetText" text="TARGET: 7 - 3 - 9" style="font-size: 24px; color: #1E3A8A; -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
        
        <ui:Button name="BtnSbStop" text="STOP DIAL 1" class="popup-button" style="background-color: #EF4444; color: white; font-size: 28px; padding: 15px 40px; border-radius: 15px; -unity-font-style: bold;" />
        
    </ui:VisualElement>
</ui:UXML>