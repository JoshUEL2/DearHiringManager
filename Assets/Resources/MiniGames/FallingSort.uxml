<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="FallingSortContainer" style="display: none; align-items: center; margin-top: 10px; margin-bottom: 20px; width: 100%;">
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 12px; padding-left: 10px; padding-right: 10px;">
            <ui:Label name="SortScoreText" text="Sorted: 0 / 10" style="font-size: 32px; color: #38BDF8; -unity-font-style: bold;" />
            <ui:Label name="SortTimerText" text="Time: 20s" style="font-size: 32px; color: #F1C40F; -unity-font-style: bold;" />
        </ui:VisualElement>
        <!-- Physics Fall Zone (Expanded for iPhone Thumb Visibility and Swing Arc) -->
        <ui:VisualElement name="FallZone" style="width: 100%; height: 560px; min-height: 560px; background-color: #0F172A; border-radius: 16px; border-width: 3px; border-color: #334155; position: relative; overflow: hidden; margin-bottom: 16px;">
            <!-- Emojis/Crates injected dynamically here with absolute positioning -->
        </ui:VisualElement>
        <!-- Dynamic Bins Row -->
        <ui:VisualElement name="BinsRow" style="flex-direction: row; justify-content: space-between; width: 100%; height: 140px; min-height: 140px;">
            <!-- Bins generated dynamically based on config -->
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
