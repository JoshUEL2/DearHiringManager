<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="SwipeGameContainer" style="display: none; align-items: center; margin-bottom: 20px; width: 100%;">
        <ui:Label name="SwipeObstacleText" text="OBSTACLE INCOMING!" style="font-size: 36px; color: #EF4444; -unity-font-style: bold; margin-bottom: 15px;" />
        <ui:Label name="SwipeProgressText" text="Dodged: 0 / 5" style="font-size: 32px; color: #38BDF8; -unity-font-style: bold; margin-bottom: 25px;" />
        <ui:VisualElement style="flex-direction: row; justify-content: center; width: 100%; margin-bottom: 20px;">
            <ui:Button name="BtnDodgeLeft" text="&#9664; DODGE LEFT" class="popup-button" style="width: 320px; height: 90px; margin-right: 15px; font-size: 30px; border-radius: 20px; background-color: #0EA5E9;" />
            <ui:Button name="BtnDodgeRight" text="DODGE RIGHT &#9654;" class="popup-button" style="width: 320px; height: 90px; margin-left: 15px; font-size: 30px; border-radius: 20px; background-color: #0EA5E9;" />
        </ui:VisualElement>
        <ui:Label name="SwipeTimerText" text="Time: 10s" style="font-size: 28px; color: #94A3B8; margin-top: 10px;" />
    </ui:VisualElement>
</ui:UXML>
