<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="TetrisContainer" style="display: none; align-items: center; margin-bottom: 30px; flex-direction: column; justify-content: center; width: 100%;">
                    
                    <ui:Label name="TetrisScoreText" text="Stacked: 0 / 10" style="font-size: 28px; color: #2ECC71; -unity-font-style: bold; margin-bottom: 20px;" />

                    <!-- Tetris Playfield (10x15 grid) -->
                    <ui:VisualElement name="TetrisGrid" style="width: 308px; height: 458px; background-color: #0F172A; border-width: 4px; border-color: #1E293B; flex-wrap: wrap; flex-direction: row; position: relative; overflow: hidden;" />
                    
                    <!-- Controls Below Playfield -->
                    <ui:VisualElement style="margin-top: 20px; flex-direction: row; justify-content: center;">
                        <ui:Button name="BtnTetrisLeft" text="◀" class="popup-button" style="width: 120px; height: 60px; font-size: 30px; margin-right: 20px;" />
                        <ui:Button name="BtnTetrisRight" text="▶" class="popup-button" style="width: 120px; height: 60px; font-size: 30px; margin-left: 20px;" />
                        <ui:Button name="BtnTetrisRotate" style="display: none;" />
                        <ui:Button name="BtnTetrisDrop" style="display: none;" />
                    </ui:VisualElement>

                </ui:VisualElement>
</ui:UXML>