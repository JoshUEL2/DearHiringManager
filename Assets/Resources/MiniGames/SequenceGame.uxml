<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="SequenceGameContainer" style="display: none; align-items: center; margin-bottom: 30px;">
                    <ui:Label name="SequenceStatusText" text="Watch the pattern..." style="font-size: 30px; color: #F1C40F; -unity-font-style: bold; margin-bottom: 20px;" />
                    <ui:VisualElement name="SequenceButtonRow" style="flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 20px;">
                        <ui:Button name="SeqBtn0" text="—" class="popup-button" style="width: 160px; margin: 8px; background-color: #1E293B; border-color: #475569; border-width: 2px;" />
                        <ui:Button name="SeqBtn1" text="—" class="popup-button" style="width: 160px; margin: 8px; background-color: #1E293B; border-color: #475569; border-width: 2px;" />
                        <ui:Button name="SeqBtn2" text="—" class="popup-button" style="width: 160px; margin: 8px; background-color: #1E293B; border-color: #475569; border-width: 2px;" />
                        <ui:Button name="SeqBtn3" text="—" class="popup-button" style="width: 160px; margin: 8px; background-color: #1E293B; border-color: #475569; border-width: 2px;" />
                        <ui:Button name="SeqBtn4" text="—" class="popup-button" style="width: 160px; margin: 8px; background-color: #1E293B; border-color: #475569; border-width: 2px; display: none;" />
                        <ui:Button name="SeqBtn5" text="—" class="popup-button" style="width: 160px; margin: 8px; background-color: #1E293B; border-color: #475569; border-width: 2px; display: none;" />
                    </ui:VisualElement>
                    <ui:Button name="BtnReplayPattern" text="🔄 Replay Pattern" style="font-size: 26px; color: #38BDF8; background-color: transparent; border-width: 0; -unity-font-style: bold;" />
