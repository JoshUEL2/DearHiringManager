<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- Main Container -->
    <ui:VisualElement name="MowGreensContainer" style="display: none; width: 100%; min-width: 440px; height: 720px; flex-direction: column; background-color: #065F46; border-radius: 16px; border-width: 6px; border-color: #8B5A2B; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; padding: 16px;">
        
        <!-- Header Info Area -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; padding: 12px 18px; background-color: rgba(0,0,0,0.55); border-radius: 12px; margin-bottom: 12px;">
            <ui:Label name="MgTimeText" text="TIME: 15.0s" style="font-size: 26px; color: #F87171; -unity-font-style: bold;" />
            <ui:Label name="MgProgressLabel" text="MOWED: 0/31" style="font-size: 26px; color: #34D399; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <ui:Label text="DRAG TO MOW! AVOID OBSTACLES!" style="font-size: 22px; color: white; -unity-font-style: bold; margin-bottom: 16px; text-shadow: 2px 2px 0 rgba(0,0,0,0.5);" />

        <!-- 6x6 Grid Container: 458x458 (6 * 75px = 450px + 8px borders) -->
        <ui:VisualElement name="MgGrid" style="flex-direction: row; flex-wrap: wrap; width: 458px; height: 458px; background-color: #111827; border-radius: 12px; border-width: 4px; border-color: #1F2937; overflow: hidden; align-content: flex-start; justify-content: flex-start; position: relative;">
            <!-- Tiles spawned dynamically in C# -->
            <ui:VisualElement name="MgTractor" class="mg-icon mg-icon-tractor" style="width: 74px; height: 74px; position: absolute; display: none; picking-mode: Ignore; translate: -50% -50%; z-index: 100;" />
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>