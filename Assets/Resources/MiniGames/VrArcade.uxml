<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="VrArcadeContainer" style="display: none; width: 100%; min-width: 400px; height: 400px; flex-direction: column; background-color: #111827; border-radius: 10px; border-width: 4px; border-color: #EC4899; margin-bottom: 20px; overflow: hidden; position: relative;">
                    <!-- Retro Background Text -->
                    <ui:VisualElement style="position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; opacity: 0.5;">
                        <ui:Label text="CYBER PONG" style="font-size: 45px; color: #06B6D4; -unity-font-style: bold; margin-bottom: -10px;" />
                        <ui:Label name="VrScoreText" text="BOUNCES: 0 / 5" style="font-size: 40px; color: #EC4899; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- The Ball -->
                    <ui:VisualElement name="VrBall" style="position: absolute; top: 50px; left: 180px; width: 20px; height: 20px; background-color: #EC4899; border-radius: 4px;" />

                    <!-- The Paddle -->
                    <ui:VisualElement name="VrPaddle" style="position: absolute; bottom: 10px; left: 150px; width: 100px; height: 20px; background-color: #06B6D4; border-radius: 10px;" />
                    
                    <!-- Touch Interceptor (Normal layout to force container width) -->
                    <ui:VisualElement name="VrTouchZone" style="flex-grow: 1; width: 100%;" />
                </ui:VisualElement>
</ui:UXML>