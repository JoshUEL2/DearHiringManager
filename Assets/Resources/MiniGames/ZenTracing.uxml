<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="ZenTracingContainer" style="display: none; width: 100%; min-width: 400px; height: 450px; flex-direction: column; background-color: #FDFBF7; border-radius: 16px; border-width: 6px; border-color: #D4C3B3; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; box-shadow: 0 10px 20px rgba(0,0,0,0.15);">
        
        <!-- Header -->
        <ui:VisualElement style="width: 100%; padding: 15px; background-color: #EFE8E1; border-bottom-width: 2px; border-color: #D4C3B3; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <ui:Label text="SENSORY MUD SPA" style="font-size: 24px; color: #785A46; -unity-font-style: bold; letter-spacing: 2px;" />
        </ui:VisualElement>

        <!-- The Mud Pool / Circle Track -->
        <ui:VisualElement style="flex-grow: 1; width: 100%; align-items: center; justify-content: center; position: relative;">
            
            <ui:VisualElement name="ZtCircle" style="width: 280px; height: 280px; border-radius: 140px; border-width: 24px; border-color: #8B5A2B; background-color: rgba(0,0,0,0); position: relative; align-items: center; justify-content: center; box-shadow: inset 0 8px 12px rgba(0,0,0,0.6), 0 4px 10px rgba(0,0,0,0.2);">
                <!-- Track inner depth -->
                <ui:VisualElement style="width: 100%; height: 100%; border-radius: 116px; border-width: 2px; border-color: rgba(0,0,0,0.2);" picking-mode="Ignore" />
                
                <!-- Target Bubble -->
                <ui:VisualElement name="ZtTarget" style="position: absolute; width: 44px; height: 44px; background-color: #60A5FA; border-radius: 22px; border-width: 3px; border-color: #BFDBFE; justify-content: center; align-items: center; box-shadow: 0 4px 8px rgba(0,0,0,0.4);" picking-mode="Ignore">
                    <ui:Label text="🫧" style="font-size: 24px; margin-top: -2px;" />
                </ui:VisualElement>

                <!-- Sponge -->
                <ui:VisualElement name="ZtSponge" style="position: absolute; width: 56px; height: 56px; background-color: #FACC15; border-radius: 16px; border-width: 4px; border-color: #FEF08A; justify-content: center; align-items: center; box-shadow: 0 6px 12px rgba(0,0,0,0.5);" picking-mode="Ignore">
                    <ui:Label text="🧽" style="font-size: 30px; margin-top: -2px;" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Relaxation Progress Bar -->
        <ui:VisualElement style="width: 100%; height: 60px; padding: 10px 20px; background-color: #EFE8E1; border-top-width: 2px; border-color: #D4C3B3; justify-content: center;">
            <ui:VisualElement style="width: 100%; height: 24px; background-color: #D4C3B3; border-radius: 12px; overflow: hidden; position: relative; box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);">
                <ui:VisualElement name="ZtProgressFill" style="position: absolute; left: 0; top: 0; height: 100%; width: 0%; background-color: #34D399; transition-property: width; transition-duration: 0.1s;" />
                <ui:Label name="ZtProgressText" text="RELAXATION: 0%" style="position: absolute; width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 14px; color: #4A3525; -unity-font-style: bold;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
