<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="RecycleBottlesContainer" style="display: none; width: 100%; min-width: 480px; height: 680px; min-height: 680px; flex-direction: column; background-color: #07090E; border-radius: 20px; border-width: 2px; border-color: #242E46; margin-top: 10px; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; justify-content: center;">
        <ui:Label text="RIP OPEN THE BAG! (SWIPE 3 TIMES)" name="RbInstructionText" style="font-size: 26px; color: #F8FAFC; -unity-font-style: bold; position: absolute; top: 20px;" />
        
        <!-- Trash Bag positioned lower for thumb swinging space -->
        <ui:VisualElement name="RbBag" style="width: 340px; height: 340px; background-color: #0E121B; border-radius: 170px; border-width: 3px; border-color: #38BDF8; justify-content: center; align-items: center; margin-top: 70px;">
            <ui:Label text="HEAVY SACK" style="font-size: 32px; color: #38BDF8; -unity-font-style: bold; margin-bottom: 8px;" />
            <ui:Label text="SWIPE HERE" style="font-size: 22px; color: #94A3B8; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <!-- Items Container positioned lower with generous thumb targets -->
        <ui:VisualElement name="RbItemsContainer" style="position: absolute; width: 100%; height: 100%; display: none;">
            <!-- Bottles (Emerald Green Tactile Badges) -->
            <ui:Button name="BtnRbItem0" text="BOTTLE" style="position: absolute; top: 120px; left: 50px; font-size: 26px; -unity-font-style: bold; background-color: rgba(16, 185, 129, 0.2); border-color: #10B981; border-width: 2px; border-radius: 20px; color: #4ADE80; padding: 18px 28px;" />
            <ui:Button name="BtnRbItem1" text="BOTTLE" style="position: absolute; top: 270px; right: 50px; font-size: 26px; -unity-font-style: bold; background-color: rgba(16, 185, 129, 0.2); border-color: #10B981; border-width: 2px; border-radius: 20px; color: #4ADE80; padding: 18px 28px;" />
            <ui:Button name="BtnRbItem2" text="BOTTLE" style="position: absolute; top: 480px; left: 80px; font-size: 26px; -unity-font-style: bold; background-color: rgba(16, 185, 129, 0.2); border-color: #10B981; border-width: 2px; border-radius: 20px; color: #4ADE80; padding: 18px 28px;" />
            
            <!-- Trash Decoys (Red/Slate Badges) -->
            <ui:Button name="BtnRbTrash0" text="DEBRIS" style="position: absolute; top: 140px; right: 70px; font-size: 24px; -unity-font-style: bold; background-color: rgba(239, 68, 68, 0.18); border-color: #EF4444; border-width: 2px; border-radius: 20px; color: #F87171; padding: 16px 24px;" />
            <ui:Button name="BtnRbTrash1" text="RODENT" style="position: absolute; top: 340px; left: 40px; font-size: 24px; -unity-font-style: bold; background-color: rgba(239, 68, 68, 0.18); border-color: #EF4444; border-width: 2px; border-radius: 20px; color: #F87171; padding: 16px 24px;" />
            <ui:Button name="BtnRbTrash2" text="FISH BONE" style="position: absolute; top: 520px; right: 80px; font-size: 24px; -unity-font-style: bold; background-color: rgba(239, 68, 68, 0.18); border-color: #EF4444; border-width: 2px; border-radius: 20px; color: #F87171; padding: 16px 24px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
