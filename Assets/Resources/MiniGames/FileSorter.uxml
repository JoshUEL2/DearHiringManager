<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="FileSorterContainer" style="display: none; width: 100%; flex-grow: 1; height: 500px; min-height: 500px; background-color: #008080; position: relative; overflow: hidden; align-items: center; justify-content: center;">
                    <ui:Label text="DUMMY CONTENT TO FORCE HEIGHT XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" style="opacity: 0; font-size: 100px; height: 500px;" /> <!-- Dummy text height forcer -->
                    <ui:Label name="FileSorterTimerText" text="15.0s" style="position: absolute; top: 10px; right: 20px; font-size: 32px; color: #FFFFFF; -unity-font-style: bold; z-index: 10;" />
                    <ui:Label name="FileSorterProgressText" text="0 / 15" style="position: absolute; top: 10px; left: 20px; font-size: 32px; color: #FFFFFF; -unity-font-style: bold; z-index: 10;" />
                    
                    <!-- 4 Folders -->
                    <ui:VisualElement style="position: absolute; top: 20px; width: 160px; height: 80px; background-color: #E6CE7E; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; border-top-color: #C1A649; border-bottom-color: #C1A649; border-left-color: #C1A649; border-right-color: #C1A649; align-items: center; justify-content: center;">
                        <ui:Label name="FileSorterFolderUp" text="FINANCE" style="color: black; font-size: 18px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="position: absolute; bottom: 20px; width: 160px; height: 80px; background-color: #E6CE7E; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; border-top-color: #C1A649; border-bottom-color: #C1A649; border-left-color: #C1A649; border-right-color: #C1A649; align-items: center; justify-content: center;">
                        <ui:Label name="FileSorterFolderDown" text="HR" style="color: black; font-size: 18px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="position: absolute; left: 20px; width: 160px; height: 80px; background-color: #E6CE7E; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; border-top-color: #C1A649; border-bottom-color: #C1A649; border-left-color: #C1A649; border-right-color: #C1A649; align-items: center; justify-content: center;">
                        <ui:Label name="FileSorterFolderLeft" text="MARKETING" style="color: black; font-size: 18px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="position: absolute; right: 20px; width: 160px; height: 80px; background-color: #E6CE7E; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; border-top-color: #C1A649; border-bottom-color: #C1A649; border-left-color: #C1A649; border-right-color: #C1A649; align-items: center; justify-content: center;">
                        <ui:Label name="FileSorterFolderRight" text="IT" style="color: black; font-size: 18px; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Active File -->
                    <ui:VisualElement name="FileSorterActiveFile" style="width: 200px; height: 120px; background-color: #FFFFFF; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: #888888; border-bottom-color: #888888; border-left-color: #888888; border-right-color: #888888; padding: 10px; align-items: center; justify-content: center; position: absolute;">
                        <ui:VisualElement style="width: 60px; height: 60px; background-color: #3498DB; margin-bottom: 10px;" /> <!-- Mockup Icon -->
                        <ui:Label name="FileSorterActiveFileText" text="Q3_Budget.xlsx" style="color: black; font-size: 16px; -unity-text-align: middle-center; white-space: normal;" />
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>