<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="FileSorterContainer" style="display: none; width: 100%; flex-grow: 1; height: 560px; min-height: 560px; background-color: #0E121B; border-radius: 20px; border-width: 2px; border-color: #242E46; position: relative; overflow: hidden; align-items: center; justify-content: center;">
        <ui:Label text="DUMMY CONTENT" style="opacity: 0; font-size: 100px; height: 560px;" />
        <ui:Label name="FileSorterTimerText" text="15.0s" style="position: absolute; top: 14px; right: 24px; font-size: 32px; color: #F1C40F; -unity-font-style: bold; z-index: 10;" />
        <ui:Label name="FileSorterProgressText" text="0 / 15" style="position: absolute; top: 14px; left: 24px; font-size: 32px; color: #38BDF8; -unity-font-style: bold; z-index: 10;" />
        
        <!-- 4 Folders with Generous Touch Boundaries -->
        <ui:VisualElement style="position: absolute; top: 20px; width: 180px; height: 90px; background-color: #E6CE7E; border-radius: 12px; border-width: 2px; border-color: #C1A649; align-items: center; justify-content: center;">
            <ui:Label name="FileSorterFolderUp" text="FINANCE" style="color: #422006; font-size: 22px; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <ui:VisualElement style="position: absolute; bottom: 20px; width: 180px; height: 90px; background-color: #E6CE7E; border-radius: 12px; border-width: 2px; border-color: #C1A649; align-items: center; justify-content: center;">
            <ui:Label name="FileSorterFolderDown" text="HR" style="color: #422006; font-size: 22px; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <ui:VisualElement style="position: absolute; left: 20px; width: 180px; height: 90px; background-color: #E6CE7E; border-radius: 12px; border-width: 2px; border-color: #C1A649; align-items: center; justify-content: center;">
            <ui:Label name="FileSorterFolderLeft" text="MARKETING" style="color: #422006; font-size: 22px; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <ui:VisualElement style="position: absolute; right: 20px; width: 180px; height: 90px; background-color: #E6CE7E; border-radius: 12px; border-width: 2px; border-color: #C1A649; align-items: center; justify-content: center;">
            <ui:Label name="FileSorterFolderRight" text="IT" style="color: #422006; font-size: 22px; -unity-font-style: bold;" />
        </ui:VisualElement>

        <!-- Active File (Larger for mobile thumb visibility) -->
        <ui:VisualElement name="FileSorterActiveFile" style="width: 230px; height: 140px; background-color: #FFFFFF; border-radius: 14px; border-width: 2px; border-color: #94A3B8; padding: 12px; align-items: center; justify-content: center; position: absolute;">
            <ui:VisualElement style="width: 50px; height: 50px; background-color: #38BDF8; border-radius: 8px; margin-bottom: 8px;" />
            <ui:Label name="FileSorterActiveFileText" text="Q3_Budget.xlsx" style="color: #0F172A; font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
