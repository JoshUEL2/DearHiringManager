<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="GridDodgeContainer" style="display: none; align-items: center; margin-bottom: 20px; width: 100%; flex-direction: column;">
        
        <!-- Top HUD -->
        <ui:VisualElement class="grid-dodge-hud">
            <ui:VisualElement class="grid-dodge-health">
                <ui:Label name="GridHealthText" text="❤️ 3" class="grid-dodge-health-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The Grid -->
        <ui:VisualElement name="GridDodgeGrid" class="grid-dodge-board">
            <!-- Background tiles and player icon injected dynamically -->
            <ui:VisualElement name="DamageOverlay" class="grid-dodge-damage-overlay" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>