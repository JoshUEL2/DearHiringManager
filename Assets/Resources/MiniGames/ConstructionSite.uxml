<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="ConstructionSiteContainer" class="cs-main" style="display: none;">
        
        <!-- Top HUD Area -->
        <ui:VisualElement class="cs-hud">
            <ui:Label text="THERMAL SCAN: LOCATE STRUCTURAL FAULT" class="cs-hud-title" />
            <ui:Label name="CsTimeText" text="TIME: 15.0s" class="cs-hud-time" />
        </ui:VisualElement>

        <!-- The Concrete Wall (Game Area) -->
        <ui:VisualElement name="CsWall" class="cs-wall">
            
            <!-- The Scanner Viewport (Draggable) -->
            <ui:VisualElement name="CsScanner" class="cs-scanner">
                
                <!-- The Thermal Vision Layer (Inverse Translated) -->
                <ui:VisualElement name="CsThermalLayer" class="cs-thermal-layer">
                    <!-- The Hidden Hotspot -->
                    <ui:VisualElement name="CsHotspot" class="cs-hotspot">
                        <ui:VisualElement class="cs-hotspot-core" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Scanner Glass & UI Overlays (Stays with the scanner) -->
                <ui:VisualElement class="cs-scanner-glass">
                    <ui:VisualElement name="CsRadarSweep" class="cs-radar-sweep" />
                    <ui:VisualElement class="cs-reticle" />
                    <ui:VisualElement name="CsProgressBar" class="cs-progress-bar">
                        <ui:VisualElement name="CsProgressFill" class="cs-progress-fill" />
                    </ui:VisualElement>
                    <ui:Label name="CsStatusText" text="SCANNING..." class="cs-status-text" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
