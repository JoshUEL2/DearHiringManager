<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="NightShiftContainer" style="display: none; width: 100%; height: 350px; flex-direction: column; background-color: #F8FAFC; border-radius: 10px; border-width: 2px; border-color: #E2E8F0; margin-bottom: 20px; overflow: hidden; position: relative;">
                    <!-- The Background UI (Variables to align) -->
                    <ui:VisualElement style="flex-grow: 1; padding: 20px; justify-content: center;">
                        <!-- Slider 1 -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                            <ui:Label text="DEMOGRAPHICS" style="width: 100px; font-size: 14px; color: #475569; -unity-font-style: bold;" />
                            <ui:VisualElement name="NsTrack1" style="flex-grow: 1; height: 30px; background-color: #E2E8F0; border-radius: 15px; margin-left: 10px; justify-content: center; position: relative;">
                                <ui:VisualElement name="NsTarget1" style="position: absolute; left: 30%; width: 40px; height: 100%; background-color: #86EFAC; border-radius: 15px;" />
                                <ui:VisualElement name="NsHandle1" style="width: 40px; height: 40px; background-color: #3B82F6; border-radius: 20px; position: absolute; left: 0%; top: -5px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Slider 2 -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                            <ui:Label text="SYNERGY" style="width: 100px; font-size: 14px; color: #475569; -unity-font-style: bold;" />
                            <ui:VisualElement name="NsTrack2" style="flex-grow: 1; height: 30px; background-color: #E2E8F0; border-radius: 15px; margin-left: 10px; justify-content: center; position: relative;">
                                <ui:VisualElement name="NsTarget2" style="position: absolute; left: 60%; width: 40px; height: 100%; background-color: #86EFAC; border-radius: 15px;" />
                                <ui:VisualElement name="NsHandle2" style="width: 40px; height: 40px; background-color: #F59E0B; border-radius: 20px; position: absolute; left: 0%; top: -5px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Slider 3 -->
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="PRICING TIER" style="width: 100px; font-size: 14px; color: #475569; -unity-font-style: bold;" />
                            <ui:VisualElement name="NsTrack3" style="flex-grow: 1; height: 30px; background-color: #E2E8F0; border-radius: 15px; margin-left: 10px; justify-content: center; position: relative;">
                                <ui:VisualElement name="NsTarget3" style="position: absolute; left: 80%; width: 40px; height: 100%; background-color: #86EFAC; border-radius: 15px;" />
                                <ui:VisualElement name="NsHandle3" style="width: 40px; height: 40px; background-color: #EF4444; border-radius: 20px; position: absolute; left: 0%; top: -5px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- The Falling Eyelid (Darkness) -->
                    <ui:VisualElement name="NsEyelid" style="position: absolute; top: -100%; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.9); border-bottom-left-radius: 40px; border-bottom-right-radius: 40px;" />

                    <!-- Coffee Button & Timer -->
                    <ui:VisualElement style="width: 100%; padding: 10px; background-color: #CBD5E1; flex-direction: row; align-items: center;">
                        <ui:Button name="NsCoffeeBtn" text="DRINK COFFEE" style="flex-grow: 1; height: 60px; font-size: 20px; background-color: #374151; color: white; border-radius: 10px; -unity-font-style: bold; border-width: 0; margin-right: 10px;" />
                        <ui:VisualElement style="background-color: #1F2937; height: 60px; justify-content: center; padding: 0 15px; border-radius: 10px;">
                            <ui:Label name="NsTimerText" text="15.0s" style="color: white; font-size: 20px; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
</ui:UXML>