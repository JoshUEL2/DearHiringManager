<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="CorporateGolfContainer" style="display: none; width: 100%; min-width: 440px; height: 720px; flex-direction: column; background-color: #166534; border-radius: 16px; border-width: 8px; border-color: #064E3B; margin-bottom: 20px; position: relative; overflow: hidden; align-items: center; justify-content: flex-start; padding: 12px;">
        
        <!-- Header Info Area -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%; padding: 12px; background-color: rgba(0,0,0,0.55); border-radius: 12px; margin-bottom: 10px; z-index: 10;">
            <ui:Label name="CgTimeText" text="TIME: 15.0s" style="font-size: 26px; color: #F87171; -unity-font-style: bold;" />
        </ui:VisualElement>
        
        <ui:Label text="DRAG BALL TO AIM. HIT THE SAND TRAP!" style="font-size: 20px; color: white; -unity-font-style: bold; margin-bottom: 8px; text-shadow: 2px 2px 0 rgba(0,0,0,0.5); z-index: 10;" />

        <!-- Play Area -->
        <ui:VisualElement name="CgPlayArea" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; overflow: hidden;">
            
            <!-- The Hole -->
            <ui:VisualElement name="CgHole" style="position: absolute; width: 44px; height: 44px; background-color: #000000; border-radius: 22px; top: 130px; left: 50%; translate: -50% 0;">
                <!-- Vector Golf Pin Flag -->
                <ui:VisualElement style="position: absolute; top: -32px; left: 20px; width: 4px; height: 32px; background-color: white;">
                    <ui:VisualElement style="position: absolute; top: 0; left: 4px; width: 22px; height: 14px; background-color: #EF4444; border-top-right-radius: 4px; border-bottom-right-radius: 4px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- The Sand Trap -->
            <ui:VisualElement name="CgSandTrap" style="position: absolute; width: 140px; height: 100px; background-color: #FCD34D; border-radius: 50px; top: 170px; right: 24px; border-width: 3px; border-color: #D97706;" />

            <!-- The CEO (watching) -->
            <ui:VisualElement name="CgCeo" class="mg-icon mg-icon-person" style="position: absolute; top: 210px; left: 24px; width: 68px; height: 68px;" />

            <!-- The Aiming Line (slingshot) with arrowhead -->
            <ui:VisualElement name="CgAimLine" style="position: absolute; width: 8px; height: 0px; background-color: #FDE047; transform-origin: center top; display: none;">
                <ui:Label text="▼" style="position: absolute; bottom: -18px; left: 50%; translate: -50% 0; font-size: 24px; color: #FDE047;" name="CgAimArrow" />
            </ui:VisualElement>

            <!-- The Ball -->
            <ui:VisualElement name="CgBall" style="position: absolute; width: 28px; height: 28px; background-color: white; border-radius: 14px; bottom: 80px; left: 206px; border-width: 1px; border-color: #D1D5DB; box-shadow: 0 4px 6px rgba(0,0,0,0.3);" />
            
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>